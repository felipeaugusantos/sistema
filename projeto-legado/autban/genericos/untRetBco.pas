            //                         060,003) NAO UTILIZADO
            //                         063,009) NAO UTILIZADO
            //                         072,011) NAO UTILIZADO
            //                         083,025) NAO UTILIZADO
            //                         108,001) NAO UTILIZADO
            strCodOco := Copy(strLinha,109,02);
            strDtaPag := Copy(strLinha,111,06);
            //                         117,030) NAO UTILIZADO
            //                         147,006) NAO UTILIZADO
            strValDup := Copy(strLinha,153,13);
//            strCodBco := Copy(strLinha,166,03);
            //                         169,005) NAO UTILIZADO
            //                         174,002) NAO UTILIZADO
            //                         176,003) NAO UTILIZADO
            //                         179,004) NAO UTILIZADO
            //                         183,058) NAO UTILIZADO
            strDesCon := Copy(strLinha,241,13);
            strValPag := Copy(strLinha,254,13);
            strJurMor := Copy(strLinha,267,13);
            //                         280,013) NAO UTILIZADO
            //                         293,001) NAO UTILIZADO
            //                         294,002) NAO UTILIZADO
            strDtaVen := Copy(strLinha,296,06);
            //                         302,093) NAO UTILIZADO
            //                         395,006) NAO UTILIZADO

            strDtaOco := '';
            strNosNum := '';
            strMotOco := '';
            strCodRej := '';

            {***************************************************}
            {* SEPARA OS DADOS DA VARIAVEL                     *}
            {************************************************LB*}

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            End
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := fStrZero(Trim(strNumCtr), 09);
              strParcel := Copy(strNumDup, 007, 01);
              strEspDoc := Copy(strNumDup, 008, 02);
              strNumDup := Copy(strNumDup, 001, 06);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := Copy(strNumDup, 013, 08);
            End;

            strCodEmpVel := fStrZero(Copy(strNumCtr,010,03),3);
            strCodCliVel := Copy(strNumDup, 013, 08);
            If fEmptyStr(strCodCliVel) And (Not fIsNumber(strCodEmpVel)) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
            Begin
              System.Insert('/',strDtaPag,3);
              System.Insert('/',strDtaPag,6);
            End;


          End;

          strCodBcoReceb := Copy(strLinha,166,03);
          strAgeReceb    := Copy(strLinha,169,05);

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************LB*}
          If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
          Begin

            If Not blnExiste Then
              pDeletaArqBco;

            If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else If intQtdDup > 1 Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else
            Begin
              pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                         strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                         strValDup, strValPag, strJurMor, '',        strCodBco,
                         strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq);

              pGravaLogCtr(strCodBco, strAutoIncremCadRec);

              blnExiste := True;
            End;
          End
          Else
          Begin
            pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                        StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                        fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArq,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('REAL');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;
end;

function TfrmRetBco.fGeraRetornoRedasset(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strVerNomArq: String;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    intAplica: Integer;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;

    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strCusCar: String;
    strUtilizaDtaCre,
    strDtaCre: String;
    strCarBco: String;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG993-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  strUtilizaDtaCre := fGetBancoConfig(0,'CONFIG993-' + IntToStr(intCartei),'DTACRED', 'N');
  Try
    For   intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If ((Copy(strLinha, 077, 03)) <> '237') Or
           ((Copy(strLinha, 002, 01)) <> '2') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco Bradesco ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        intAplica := 0;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;

          If Copy(strLinha, 1, 1) = '1' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strVerNomArq := UpperCase(LeftStr(strNomArq,2));
            strNumCtr := Copy(strLinha,038,25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              Else
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            End
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := Trim(Copy(strNumCtr,001,06));
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
              strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strValPag := Copy(strLinha,254,13);

            strDtaPag := fStrZero('0',6);
            If (fStrToFloat(strValPag)/100) > 0 Then
            Begin
              strDtaPag := Copy(strLinha,111,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            strDtaCre := Copy(strLinha, 296,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;

            if strUtilizaDtaCre = 'N' Then
              strDtaCre := '';

            strValDup := Copy(strLinha,153,13);

            strCodBco := '993'; //Copy(strLinha,166,03);
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Copy(strLinha,071,12);
            strCodRej := '';
            strMotOco := '';
            strCarBco := Copy(strLinha,022,03);

            if strCodOco = '28' then
              strCusCar := Copy(strLinha,189,13) //Custos de cartório
            else
              strCusCar := '';

            //Altera data de ocorrência no cado de Ocorrência  = 15
            If (strCodOco = '15') and (strUtilizaDtaCre = 'N') Then
            Begin
              strDtaOco := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            {********************}
            {* RETORNO DESCONTO *}
            {*****************LB*}
            If strVerNomArq = 'DS' Then
            Begin
              strDesCon := '0000000000000';
              strJurMor := '0000000000000';
            End
            {*******************}
            {* RETORNO SIMPLES *}
            {****************LB*}
            Else
            Begin
              strDesCon := Copy(strLinha,241,13);
              strJurMor := Copy(strLinha,267,13);
            End;

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            {********************************************}
            {* VERIFICA O FORMATO NOVO E VELHO DO AUTCOM*}
            {* OBS: FOI FEITO USANDO O LAYOUT DA GUAÇU  *}
            {***xx/xx/xxxx****************************MV*}
            If (fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False,     '',        '',        strDtaCre,        '',
                           '',        strCusCar, strCarBco);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                           strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                           strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                           strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq,
                           False,        '',           '',           strDtaCre,           '',
                           '',           strCusCar);
                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            inc( intAplica );

            If ( intAplica Mod 10 ) = 0 Then
              Application.ProcessMessages;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('REDASSET');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;
end;

function TfrmRetBco.fGeraRetornoCreditBrasil(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strVerNomArq: String;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    intAplica: Integer;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;

    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strCusCar: String;
    strUtilizaDtaCre,
    strDtaCre: String;
    strCarBco: String;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG992-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  strUtilizaDtaCre := fGetBancoConfig(0,'CONFIG992-' + IntToStr(intCartei),'DTACRED', 'N');
  Try
    For   intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If ((Copy(strLinha, 077, 03)) <> '237') Or
           ((Copy(strLinha, 002, 01)) <> '2') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco Bradesco ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        intAplica := 0;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;

          If Copy(strLinha, 1, 1) = '1' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strVerNomArq := UpperCase(LeftStr(strNomArq,2));
            strNumCtr := Copy(strLinha,038,25);

            If Length(Trim(strNumCtr)) = 25 Then //duplicata com 12 digitos
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Copy(strNumCtr,013,01);
              strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
              strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
            End
            Else
            Begin
              strNumDup := Trim(Copy(strNumCtr,001,06));
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
              strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strValPag := Copy(strLinha,254,13);

            strDtaPag := fStrZero('0',6);
            If (fStrToFloat(strValPag)/100) > 0 Then
            Begin
              strDtaPag := Copy(strLinha,111,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            strDtaCre := Copy(strLinha, 296,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;

            if strUtilizaDtaCre = 'N' Then
              strDtaCre := '';

            strValDup := Copy(strLinha,153,13);

            strCodBco := '992'; //Copy(strLinha,166,03);
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Copy(strLinha,071,12);
            strCodRej := '';
            strMotOco := '';
            strCarBco := Copy(strLinha,022,03);

            if strCodOco = '28' then
              strCusCar := Copy(strLinha,189,13) //Custos de cartório
            else
              strCusCar := '';

            //Altera data de ocorrência no cado de Ocorrência  = 15
            If (strCodOco = '15') and (strUtilizaDtaCre = 'N') Then
            Begin
              strDtaOco := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            {********************}
            {* RETORNO DESCONTO *}
            {*****************LB*}
            If strVerNomArq = 'DS' Then
            Begin
              strDesCon := '0000000000000';
              strJurMor := '0000000000000';
            End
            {*******************}
            {* RETORNO SIMPLES *}
            {****************LB*}
            Else
            Begin
              strDesCon := Copy(strLinha,241,13);
              strJurMor := Copy(strLinha,267,13);
            End;

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            {********************************************}
            {* VERIFICA O FORMATO NOVO E VELHO DO AUTCOM*}
            {* OBS: FOI FEITO USANDO O LAYOUT DA GUAÇU  *}
            {***xx/xx/xxxx****************************MV*}
            If (fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False,     '',        '',        strDtaCre,        '',
                           '',        strCusCar, strCarBco);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                           strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                           strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                           strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq,
                           False,        '',           '',           strDtaCre,           '',
                           '',           strCusCar);
                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            inc( intAplica );

            If ( intAplica Mod 10 ) = 0 Then
              Application.ProcessMessages;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('CREDIT BRASIL');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;
end;

procedure TfrmRetBco.pAbreCdsNaoBaixa;
Begin
  With cdsNaoGra Do
  Begin
    CreateDataSet;
    Open;
    EmptyDataSet;
  End;
End;

procedure TfrmRetBco.pFechaCdsNaoBaixa;
Begin
  With cdsNaoGra Do
  Begin
    EmptyDataSet;
    Close;
  End;
End;

procedure TfrmRetBco.pIncluiOcor(strNosNum, strCodCli, strNumDup, strEspDoc, strCodEmp: String;
                                 dtaDtaVen, dtaDtaPag: TDate; fltValDup, fltValPag: Double);
Begin
  With cdsNaoGra Do
  Begin
    Insert;
    FieldByName('NOSNUM').AsString   := strNosNum;
    FieldByName('CODCLI').AsString   := strCodCli;
    FieldByName('NUMDUP').AsString   := strNumDup;
    FieldByName('ESPDOC').AsString   := strEspDoc;
    FieldByName('CODEMP').AsString   := strCodEmp;

    If dtaDtaVen <> 0 Then
      FieldByName('DTAVEN').AsDateTime := dtaDtaVen;

    If dtaDtaPag <> 0 Then
      FieldByName('DTAPAG').AsDateTime := dtaDtaPag;

    FieldByName('VALDUP').AsFloat    := fltValDup;
    FieldByName('VALPAG').AsFloat    := fltValPag;
    Post;
  End;
End;

procedure TfrmRetBco.pMostraArqNaoBaixa(strNomBan: String);
  Var
    strNomImp,
    strTipImp: String;
    frxReport: TfrxReport;
Begin
  pCarregaConfImpr(qryCfgRel, self.Name);
  strNomImp := qryCfgRel.FieldByName('REL_NOMFIL').AsString;
  strTipImp := qryCfgRel.FieldByName('REL_IDEIMP').AsString;

  If strTipImp = 'M' Then
    frxReport := frxReportM
  Else
  Begin
    frxReport := frxReportJ;
    TfrxMemoView(frxReportJ.FindObject('mmoZebra')).Highlight.Color := fCfgSis('CORZEB');
  End;

  With frxReport Do
  Begin
    Script.Variables['NOMEMP'] := VS_strCodEmp + ' - ' + fRetNomeEmpresa;
    Script.Variables['NOMREL'] := 'DUPLICATAS NÃO ENCONTRADAS - ' + strNomBan;
    pPreviewReport(Self.Name, Self.Caption + ' (Duplicatas não encontradas)', frxReport);
  End;
End;

function TfrmRetBco.fGeraRetornoBanrisul(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnUsaTarifa,
    blnExiste: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strTarifa: String;
    strValLan: String;
    fltTarifa: Double;
    strCodMot,
    strMotOco,
    strValPrCa,
    strDespes: String;
    strOutCob: String;
    intQtdDup: Integer;

    strNumDupVel,
    strParcelVel,
    strEspDocVel,
    strCodEmpVel,
    strCodCliVel: String;

    dtaDtaArq: TDateTime;
    strOutVal: String;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;

    LRegistrosRemovidosDaRetBco: Boolean;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  strValPrCa := fGetBancoConfig(0, 'CONFIG041-' + IntToStr(intCartei), 'VALPRCA', 'N');
  LRegistrosRemovidosDaRetBco := False;

  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG041-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  If Pos('240p', strNomBanco) > 0 Then
    strCartei := 'CONFIG041_240p' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  Try
    For   intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If Pos('240p', strNomBanco) > 0 Then
      Begin

        //240p
        If lstArquivo.Selected[intContador] Then
        Begin
          {************************}
          {* PEGA DATA DO ARQUIVO *}
          {*********************MO*}
          FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador],dtaDtaArq);
          AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
          Reset(txtTexto);
          Readln(txtTexto,strLinha);

          intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

          If ((Copy(strLinha, 001, 03)) <> '041') Then
          Begin
            fMensagem('', 'Não é um arquivo de retorno do Banco Banrisul ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
            CloseFile(txtTexto);
            Exit;
          End;

          strDtaArqRet := Copy(strLinha, 144, 8);
          strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, 4);

          If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
          Begin
            fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
            CloseFile(txtTexto);
            Exit;
          End
          Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

          If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
          begin
            if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                             '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
            begin
              blnAtualizaRet := True;
            end
            else
            begin
              blnAtualizaRet := False;
              CloseFile(txtTexto);
              Exit;
            end;
          end;

          //Remove registros de importações anteriores da RETBCO e RETMOT
          If Not LRegistrosRemovidosDaRetBco Then
          Begin
            pDeletaArqBco;

            LRegistrosRemovidosDaRetBco := True;
          End;

          intLinha := 0;

          While Not Eof(txtTexto) Do
          Begin
            Readln(txtTexto,strLinha);

            pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

            If (Copy(strLinha, 8, 1) = '0') Or
               (Copy(strLinha, 8, 1) = '1') Or
               (Copy(strLinha, 8, 1) = '9') Or
               (fEmptyStr(Trim(strLinha)))  Then
              Continue;

            {*****************************************}
            {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
            {**************************************MO*}
            If Eof(txtTexto) Then
              Continue;

            {**************}
            {* SEGMENTO T *}
            {***********MO*}
            If Copy(strLinha, 14, 1) = 'T' Then
            Begin
              {*************************************************}
              {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
              {**********************************************MO*}
              strNomArq := lstArquivo.Items.Strings[intContador];
              strNumCtr := Copy(strLinha, 106, 25);
              strTarifa := '';
              fltTarifa := 0;
              strValLan := '';


              strNumDup := '';
              strParcel := '';
              strEspDoc := '';
              strCodEmp := '';
              strCodCli := '';

              {********************************************************************************************}
              {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
              {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
              {*****************************************************************************************MO*}
              if EhNumero(Copy(strNumCtr,006,02)) then
              begin
                //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
                If (Length(Trim(strNumCtr)) = 20) Then
                Begin
                  strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                  strParcel := Trim(Copy(strNumCtr,013,03));
                  strEspDoc := Copy(strNumCtr,016,02);
                  strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                  strCodCli := '';
                End
                //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
                Else If Length(Trim(strNumCtr)) = 25 Then
                Begin
                  strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                  strParcel := Copy(strNumCtr,014,01);
                  strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,013,01));
                  strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                  strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
                End;
              End
              Else
              Begin
                //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
                Try
                  {*****************************************}
                  {* ESSE NÃO PODE SER fStrToFloat         *}
                  {**************************************AF*}
                  fStrToFloat(fStrZero(Copy(strNumCtr,013,08),8));

                  strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                  strParcel := Copy(strNumCtr,007,01);
                  strEspDoc := Copy(strNumCtr,008,02);
                  strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
                  strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
                Except
                  strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                  strParcel := Copy(strNumCtr,007,01);
                  strCodCli := fStrZero(Copy(strNumCtr,008,08),8);
                  strCodEmp := fStrZero(Copy(strNumCtr,016,03),3);
                  strEspDoc := Copy(strNumCtr,019,02);
                End;
              End;

              strCodOco := Copy(strLinha, 016, 02);

              pDadosDuplicataVel(strNumCtr,    strNumDupVel, strParcelVel,
                                 strEspDocVel, strCodEmpVel, strCodCliVel);

              If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
              Begin
                pDadosDuplicataOutros(strNumCtr,    strNumDupVel, strParcelVel,
                                      strEspDocVel, strCodEmpVel, strCodCliVel);

                If Not fEmptyStr(strCodCliVel) Then
                Begin
                  strNumDup := strNumDupVel;
                  strParcel := strParcelVel;
                  strEspDoc := strEspDocVel;
                  strCodEmp := strCodEmpVel;
                  strCodCli := strCodCliVel;
                End;
              End;

              strDtaVen := Copy(strLinha,074, 08);
              If Not fEmptyStr(strDtaVen) And (strDtaVen <> '00000000') Then
              Begin
                System.Insert('/',strDtaVen,3);
                System.Insert('/',strDtaVen,6);
              End;

              strNosNum := Copy(strLinha, 038, 20);
              strValDup := Copy(strLinha, 082,15);

              blnUsaTarifa := fCfgSis('ENCBAN', varBoolean);

              If blnUsaTarifa then
                 fltTarifa := fStrToFloat(fArqIniAutban(0, 'CONFIG041_240p-' + IntToStr(intCartei), 'VALOTAR', '0'));

              If ((Pos(strCodOco,  '06_02_') > 0) and (fltTarifa > 0) and (blnUsaTarifa))  then
              Begin
                 strTarifa := Copy(strLinha,199,15);
              End;
            End;

            {**************}
            {* SEGMENTO U *}
            {**************}
            If (Copy(strLinha, 14, 1) = 'U')Then
            Begin
              strJurMor := Copy(strLinha, 018, 15);
              strDesCon := Copy(strLinha, 033, 15);
              strValPag := Copy(strLinha, 093, 15);
              strDtaOco := Copy(strLinha, 138, 08);

              If ((Pos(strCodOco, '09_') > 0) And ((fStrToFloat(strValPag)/100) > 0)) Then
              Begin
                If fEmptyStr(fGetBancoConfig(0, 'CONFIG041_240p-' + IntToStr(intCartei), 'DIAPROT', '')) Then
                  strValPag  := '000000000000000';
              End;

              If (fFormataFloat(((fStrToFloat(strValDup)/100) - (fStrToFloat(strValPag)/100)),2) = fFormataFloat(fltTarifa,2)) Then
              Begin
                strTarifa := fStrZero(FloatToStr(fltTarifa),15);
              End;


              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '00000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := strDtaOco;
              strCodBco := '041';
              strCodRej := '';
              strCodBcoReceb := Copy(strLinha,97,03);
              strAgeReceb    := Copy(strLinha,100,05);

              {********************************************}
              {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
              {********************************************}
              If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
              Begin

                If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
                Begin
                  lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                        strEspDoc + '-' +
                                                        strCodEmp +
                                                        ' Cliente: ' + strCodCli +
                                                        ' Nosso Número: ' + strNosNum);
                End
                Else If intQtdDup > 1 Then
                Begin
                  lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                        strEspDoc + '-' +
                                                        strCodEmp +
                                                        ' Cliente: ' + strCodCli +
                                                        ' Nosso Número: ' + strNosNum);
                End
                Else
                Begin
                  pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                               strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                               strValDup, strValPag, strJurMor, '',        strCodBco,
                               strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                               False,     '',        '',        '',        strTarifa,
                               strValLan, '',        '',        '',        '',
                               False,     '',        '240');

                  pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                  blnExiste := True;
                End;
              End
              Else
              Begin
                pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                            StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                            fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
              End;

              {*****************************}
              {* GRAVAÇÃO DA TABELA REMGER *}
              {** DADOS GERAIS DA REMESSA **}
              {*****************************}

              //GRAVA SOMENTE UMA VEZ
              if intContGeral = 0 then
              begin
                pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
                Inc(intContGeral);
              end;

              {*****************************}
              {* GRAVAÇÃO DA TABELA RETDET *}
              {**** DETALHES DA RETORNO ****}
              {**************************MO*}
              pGravaRetDet(strAutoIncremRet,
                           strAutoIncremCadRec,
                           strNosNum,
                           fStrToFloat(strValPag)/100,
                           fStrtoFloat(strJurMor)/100,
                           fStrtoFloat(strDescon)/100,
                           0,
                           StrToDateDef(strDtaPag, 0),
                           strCodBcoReceb,
                           strAgeReceb,
                           dtaDtaArqRet,
                           strLoginUsuarioLogado,
                           '',
                           strCodOco,
                           blnAtualizaRet);
              blnAtualizaRet := False;
            End;
          End;// fim do while

          CloseFile(txtTexto);

          If Not cdsNaoGra.IsEmpty Then
            pMostraArqNaoBaixa('BANRISUL 240p');

          pMostraDupNaoBaixa(lstArqNaoGravados);

          If Not blnExiste Then
          Begin
            fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
            Continue;
          End;

          strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
          If Not fRenomeiaArquivo(strNomArq) Then
          Begin
            Exit;
          End;

          fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);
        end;

      End
      Else
      Begin

        If lstArquivo.Selected[intContador] Then
        Begin
          //*************************************************//
          // LOCALIZA O ARQUIVO DE RETORNO                   //
          //**********************************************ED*//
          FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador],dtaDtaArq );

          AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
          Reset(txtTexto);
          Readln(txtTexto,strLinha);
          If ((Copy(strLinha, 077, 03)) <> '041') Then
          Begin
            fMensagem('', 'Não é um arquivo de retorno do Banco Banrisul ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
            CloseFile(txtTexto);
            Exit;
          End;
          strDtaArqRet := Copy(strLinha, 095, 6);
          strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
          If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
          Begin
            fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
            CloseFile(txtTexto);
            Exit;
          End
          Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

          If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
          begin
            if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                             '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
            begin
              blnAtualizaRet := True;
            end
            else
            begin
              blnAtualizaRet := False;
              CloseFile(txtTexto);
              Exit;
            end;
          end;

          //Remove registros de importações anteriores da RETBCO e RETMOT
          If Not LRegistrosRemovidosDaRetBco Then
          Begin
            pDeletaArqBco;

            LRegistrosRemovidosDaRetBco := True;
          End;

          While Not Eof(txtTexto) Do
          Begin
            Readln(txtTexto,strLinha);

            If (Copy(strLinha, 1, 1) = '9') Or
               (fEmptyStr(Trim(strLinha)))  Then
              Continue;

            {*****************************************}
            {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
            {**************************************LB*}
            If Eof(txtTexto) Then
              Continue;

            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strNumCtr := Copy(strLinha, 038, 25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            End
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              If Length( Trim( strNumCtr ) ) = 11 Then  //SHX
              Begin

                strNumDup := Copy(strNumCtr,004,08);
                strParcel := '';
                strEspDoc := '';
                strCodEmp := fStrZero(Copy(strNumCtr,001,03),3);
                strCodCli := '';

              End
              Else
              Begin

                strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                strParcel := Copy(strNumCtr,007,01);
                strEspDoc := Copy(strNumCtr,008,02);
                strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,013,08),8);

              End;
            End;

            pBanrisulDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
              strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;
            strDtaPag := strDtaOco;

            strDtaVen := Copy(strLinha,147,06);
            If LeftStr(Trim(strDtaVen),4) = 'SEMR' Then
            Begin
              strDtaVen := '';
            End
            Else If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strDesCon := Copy(strLinha,241,13);
            strValDup := Copy(strLinha,153,13);
            //strValPag := Copy(strLinha,254,13);
            strJurMor := Copy(strLinha,267,13);
            //strOutCob := Copy(strLinha,189,13);
            strCodBco := '041'; //Copy(strLinha,166,03);
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Trim(Copy(strLinha,127,12));
            strCodRej := '';
            strOutVal := Copy(strLinha,280,13);
            strDespes := Copy(strLinha,189,13);
            strMotOco := '';
            strCodMot := Trim(Copy(strLinha, 383, 10));

            strValPag := '';
            strValLan := '';
            strTarifa := '';
            fltTarifa := 0;

            If (Not fEmptyStr(strDtaPag))                    And
               (strDtaPag <> '000000')                       And
               (strDtaPag <> '00000000')                     And
               ((strCodOco <> '02') And (strCodOco <> '32')  And
                (strCodOco <> '09'))                         Then
            Begin
              strValPag := fStrZero( FloatToStr( fStrToFloat(Copy(strLinha,254,13)) +
                                                 IIF(Not fEmptyStr(strDespes), fStrToFloat(strDespes), 0) +
                                                 IIF(strCodOco = '15', fStrToFloat(strJurMor), 0)), 13);  // QUANDO OCORRÊNCIA 15 DEVE SOMAR VALOR DE JUROS NO CAMPO VALPAG, PARA NÃO GERAR DIVERGÊNCIA DE VALOR NA BAIXA
            End
            Else
              strValPag := Copy(strLinha, 254, 13);

            if fCfgSis('ENCBAN', varBoolean) then
              fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG041-' + IntToStr(intCartei), 'VALOTAR', '0'));

            if ((Pos(strCodOco, '06_02_') > 0) and (fltTarifa > 0) and (fCfgSis('ENCBAN', varBoolean))) then
            begin
              strTarifa := Copy(strLinha,176,13);
              strValPag :=  fStrZero( FloatToStr( fStrToFloat(Copy(strLinha,254,13)) -
                                                  IIF(Not fEmptyStr(strTarifa), fStrToFloat(strTarifa), 0)), 13 );

              strValLan := fStrZero( FloatToStr( fStrToFloat(Copy(strLinha,254,13)) +
                                                 IIF(Not fEmptyStr(strDespes), fStrToFloat(strDespes), 0) -
                                                 IIF(Not fEmptyStr(strTarifa), fStrToFloat(strTarifa), 0)), 13 );
            end;

            if ((strValPrCa = 'N') and ((strCodOco = '15') or (strCodOco = '40'))) then
               strDtaPag := '00000000';

            if (strCodOco = '30') then
               strDtaPag := '00000000';

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
            Begin

              If strCodOco = '03' Then
                pGravaRetMot(strCodBco, strNumDup, strParcel, strEspDoc, strCodCli,
                             strCodEmp, strCodMot, strCodOco);

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                             strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                             strValDup, strValPag, strJurMor, strOutVal, strCodBco,
                             strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                             (strCodOco <> '15') And (strCodOco <> '40'),
                             '',  strOutCob, '',        strTarifa, strValLan);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         fStrtoFloat(strTarifa)/100,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;

          End;// fim do while

          CloseFile(txtTexto);

          If Not cdsNaoGra.IsEmpty Then
            pMostraArqNaoBaixa('BANRISUL');

          pMostraDupNaoBaixa(lstArqNaoGravados);

          If Not blnExiste Then
          Begin
            If fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! ' +
            'Manter em aberto para análise ou Apagar o arquivo "' + lstArquivo.Items.Strings[intContador] + '" da pasta?', ['&Análise', 'A&pagar']) = 2 Then
              DeleteFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

            Continue;
          End;

          strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
          If Not fRenomeiaArquivo(strNomArq) Then
          Begin
            Exit;
          End;

          fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

        End;// Fim do If
      End;// fim do For

      End;





  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoSicredi(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strLinha : String;
    strParcel: String;
    strValLan: String;
    strTarifa: String;
    fltTarifa: Double;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strOutVal: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;

    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;

    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;

    blnUsaTarifa: Boolean;

    LDetalhamentoRetorno: TDetalhamentoRetorno;
    LDadosDetalhe:  TDadosDetalhe;
    LAguardeDetalhamento : TfrmGravando;
    blnDescon: Boolean;
    LDiferenca: Double;
    LPermiteCarteiraAPI: Boolean;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  blnExiste := False;
  LPermiteCarteiraAPI := fCfgSis('APISIC') = 'S';
  strCartei := 'CONFIG748-' + IntToStr(intCartei) + '-' + VS_strCodEmp;
  blnDescon := False; //remover warning

  pnlInfo.Repaint;

  LDadosDetalhe := nil;
  LDetalhamentoRetorno := nil;
  LAguardeDetalhamento := nil;
  try
    Try
      fAbrirTabela(frmModuloRetBco.qryRetBco);
      For   intContador := 0 To lstArquivo.Count-1 Do
      Begin
        blnExiste := False;

        //400p
        If Pos('_240p', strNomBanco) <= 0 Then
        Begin
          If lstArquivo.Selected[intContador] Then
          Begin
            LDetalhamentoRetorno := TDetalhamentoRetorno.Create(nil);

            {************************}
            {* PEGA DATA DO ARQUIVO *}
            {*********************ED*}
            FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador],dtaDtaArq);

            AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
            Reset(txtTexto);
            Readln(txtTexto,strLinha);

            intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

            If ((Copy(strLinha, 077, 03)) <> '748') Then
            Begin
              fMensagem('', 'Não é um arquivo de retorno do Banco Sicredi ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
              CloseFile(txtTexto);
              Exit;
            End;
            strDtaArqRet := Copy(strLinha, 095, 8);
            strDtaArqRet := Copy(strDtaArqRet, 7, 2) + '/' + Copy(strDtaArqRet, 5, 2) + '/' + Copy(strDtaArqRet, 1, 4);
            If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
            Begin
              fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
              CloseFile(txtTexto);
              Exit;
            End
            Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

            If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei, dtaDtaArqRet) then
            begin
              if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                               '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
              begin
                blnAtualizaRet := True;
              end
              else
              begin
                blnAtualizaRet := False;
                CloseFile(txtTexto);
                Exit;
              end;
            end;

            intLinha := 0;

            While Not Eof(txtTexto) Do
            Begin
              Readln(txtTexto,strLinha);

              pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

              If MatchStr(Copy(strLinha, 1, 1), ['9','8']) Or
                 (fEmptyStr(Trim(strLinha)))  Then
                Continue;
              {*****************************************}
              {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
              {**************************************LB*}
              If Eof(txtTexto) Then
                Continue;

              {*************************************************}
              {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
              {**********************************************LB*}
              strNomArq := lstArquivo.Items.Strings[intContador];
              strNumCtr := Trim(Copy(strLinha, 117, 10));
              strTarifa := '';
              fltTarifa := 0;
              strValLan := '';

              strNumDup := '';
              strParcel := '';
              strEspDoc := '';
              strCodEmp := '';
              strCodCli := '';

              If Not fEmptyStr(strNumCtr) Then
              Begin
                If Copy(strLinha, 021, 01) = 'E' Then
                  strCodEmp := Copy(strLinha, 022, 03)
                else
                  strCodEmp := '';

                If (Length(Trim(strNumCtr)) = 10) Then
                Begin
                  strEspDoc := Copy(strNumCtr,009,02);

                  If Pos(strEspDoc, TEspecieParaArquivoRemessa.New.fRetornaEspeciesPermitidas) = 0 Then
                    strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,010,01));

                  strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                  strParcel := Copy(strNumCtr,007,03);
                end
                else
                begin
                  strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                  strParcel := Copy(strNumCtr,007,01);
                  strEspDoc := Copy(strNumCtr,008,02);
                end;
              end;


              strDtaOco := Copy(strLinha,111,06);

              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;
              strDtaPag := strDtaOco;

              strDtaVen := Copy(strLinha,147,06);
              If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
              Begin
                System.Insert('/',strDtaVen,3);
                System.Insert('/',strDtaVen,6);
              End;

              strDesCon := Copy(strLinha,241,13);
              strValDup := Copy(strLinha,153,13);
              //strValPag := Copy(strLinha,254,13);
              strJurMor := Copy(strLinha,267,13);
              strOutVal := Copy(strLinha,280,13);
              strCodBco := '748'; //Copy(strLinha,166,03);
              strCodOco := Copy(strLinha,109,02);
              strNosNum := Copy(strLinha,048,15);
              strCodRej := '';
              strMotOco := Copy(strLinha,319,02);

              strCodBcoReceb := Copy(strLinha,166,03);
              strAgeReceb    := Copy(strLinha,169,05);

              blnUsaTarifa := fCfgSis('ENCBAN', varBoolean);

              If blnUsaTarifa then
                 fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG748-' + IntToStr(intCartei), 'VALOTAR', '0'));

              If (strCodOco = '28') and
                 (fltTarifa > 0) and
                 (blnUsaTarifa)  then
              Begin
                 strTarifa := Copy(strLinha,176,13);
                 strValLan := Copy(strLinha,254,13);
                 strValPag := FloatToStr(fStrToFloat(strValLan) - fStrToFloat(strTarifa));
              End
              Else
              Begin
                 strValPag := Copy(strLinha,254,13);
                 strValLan := '';
              End;

              If fCfgSis('ENCBAN', varBoolean) Then
              Begin
                blnDescon := strCodOco.Equals('33') And // Confirmação de pedido de alteração de outros dados
                             Copy(strLinha,002,001).Equals('C') And // Tipo da Carteira (C-Descontada)
                             strMotOco.Equals('H4'); // transferencia de carteira

                If blnDescon Then
                  strValLan := strValDup;
              End;

             // DIFERENCA NO RECEBIMENTO, CONSIDERANDO VALREC x [ VALORI, VALJUR e VALDES ]
              LDiferenca := (fStrToFloat(strValPag) - ((fStrToFloat(strValDup) + fStrToFloat(strJurMor)) -  fStrToFloat(strDesCon)));
              If (LDiferenca <> 0) Then
              Begin
                // se a diferença for igual ao valor da multa lança a multa como juros.
                If (LDiferenca = fStrToFloat(strOutVal)) Then
                Begin
                  strJurMor := fStrZero(FloatToStr(fStrToFloat(strJurMor) + fStrToFloat(strOutVal)),13);
                End;
              End;

              {********************************************}
              {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
              {*****************************************LB*}
              If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,
                                       strCodEmp,strCodCli,strNosNum,
                                       strCodBco, strTipCob, intQtdDup,
                                       strAutoIncremCadRec, strCarteiraCadRec,
                                       'CONFIG748-' + IntToStr(intCartei)) Then
              Begin

                If Not blnExiste Then
                  pDeletaArqBco;

                If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
                Begin
                  lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                        strEspDoc + '-' +
                                                        strCodEmp +
                                                        ' Cliente: ' + strCodCli +
                                                        ' Nosso Número: ' + strNosNum);
                End
                Else If intQtdDup > 1 Then
                Begin
                  lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                        strEspDoc + '-' +
                                                        strCodEmp +
                                                        ' Cliente: ' + strCodCli +
                                                        ' Nosso Número: ' + strNosNum);
                End
                Else If strCarteiraCadRec.Contains('CONFIG748API') And (Not LPermiteCarteiraAPI) Then
                Begin
                  lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                        strEspDoc + '-' +
                                                        strCodEmp +
                                                        ' Cliente: ' + strCodCli +
                                                        ' Nosso Número: ' + strNosNum);

                  lstArqNaoGravados.Add('--Duplicata foi gerada por uma carteira que comunica com o banco através de API. Deve ser baixada pela carteira em que o boleto foi gerado.');
                End
                Else
                Begin
                  pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                               strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                               strValDup, strValPag, strJurMor, '',        strCodBco,
                               strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                               False, '', '', '', strTarifa, strValLan,'','','','',blnDescon);

                  pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                  blnExiste := True;
                End;
              End
              Else
              Begin
                pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                            StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                            fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
              End;

              {*****************************}
              {* GRAVAÇÃO DA TABELA REMGER *}
              {** DADOS GERAIS DA REMESSA **}
              {**************************MO*}

              LDadosDetalhe:= TDadosDetalhe.Create;
              LDetalhamentoRetorno.Default(LDadosDetalhe);
              LDadosDetalhe.AutoIncremCadRec   := strAutoIncremCadRec;
              LDadosDetalhe.NossoNumero        := strNosNum ;
              LDadosDetalhe.ValorPago          := fStrToFloat(strValPag)/100;
              LDadosDetalhe.ValorJuros         := fStrtoFloat(strJurMor)/100;
              LDadosDetalhe.ValorDesconto      := fStrtoFloat(strDescon)/100;
              LDadosDetalhe.ValorTarifa        := 0;
              LDadosDetalhe.DataPagamento      := StrToDateDef(strDtaPag, 0);
              LDadosDetalhe.BancoRecebimento   := strCodBcoReceb;
              LDadosDetalhe.AgenciaRecebimento := strAgeReceb;
              LDadosDetalhe.DataRetorno        := dtaDtaArqRet;
              LDadosDetalhe.OperadorRetorno    := strLoginUsuarioLogado;
              LDadosDetalhe.CodigoOcorrencia   := strCodOco;
              LDadosDetalhe.CodigoEmpresa      := VS_strCodEmp;
              LDadosDetalhe.CodigoBanco        := strCodBco;
              LDadosDetalhe.Carteira           := StrCartei;
              LDadosDetalhe.NomeArquivo        := lstArquivo.Items.Strings[intContador];
              LDadosDetalhe.NumeroRemessa      := 0; ;
              LDadosDetalhe.Update             := blnAtualizaRet;
              blnAtualizaRet := False;
              LDetalhamentoRetorno.Add(LDadosDetalhe);

            End;// fim do while

            CloseFile(txtTexto);

            pCriarFormularios(TfrmGravando, LAguardeDetalhamento);
            LAguardeDetalhamento.fExecutarAcao := LDetalhamentoRetorno.GravaDetalhamentoRetorno;
            LAguardeDetalhamento.ShowModal;

            If Assigned(LDetalhamentoRetorno) Then
              FreeAndNil(LDetalhamentoRetorno);

            If Assigned(LAguardeDetalhamento) Then
              FreeAndNil(LAguardeDetalhamento);

            If Not cdsNaoGra.IsEmpty Then
              pMostraArqNaoBaixa('SICREDI');

            pMostraDupNaoBaixa(lstArqNaoGravados);

            If Not blnExiste Then
            Begin
              fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
              Continue;
            End;

            strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
            If Not fRenomeiaArquivo(strNomArq) Then
            Begin
              Exit;
            End;

            fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);
          End;// Fim do If
        End
        Else
        Begin
          strCartei := 'CONFIG748_240p-' + IntToStr(intCartei) + '-' + VS_strCodEmp;
          //240p
          If lstArquivo.Selected[intContador] Then
          Begin
            {************************}
            {* PEGA DATA DO ARQUIVO *}
            {*********************MO*}
            FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador],dtaDtaArq);
            AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
            Reset(txtTexto);
            Readln(txtTexto,strLinha);

            intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

            If ((Copy(strLinha, 001, 03)) <> '748') Then
            Begin
              fMensagem('', 'Não é um arquivo de retorno do Banco Sicredi ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
              CloseFile(txtTexto);
              Exit;
            End;

            strDtaArqRet := Copy(strLinha, 144, 8);
            strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );

            If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
            Begin
              fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
              CloseFile(txtTexto);
              Exit;
            End
            Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

            If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
            begin
              if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                               '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
              begin
                blnAtualizaRet := True;
              end
              else
              begin
                blnAtualizaRet := False;
                CloseFile(txtTexto);
                Exit;
              end;
            end;

            intLinha := 0;

            blnUsaTarifa := fCfgSis('ENCBAN', varBoolean);

            While Not Eof(txtTexto) Do
            Begin
              Readln(txtTexto,strLinha);

              pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

              If (Copy(strLinha, 7, 1) = '9') Or
                 (fEmptyStr(Trim(strLinha)))  Then
                Continue;

              {*****************************************}
              {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
              {**************************************MO*}
              If Eof(txtTexto) Then
                Continue;

              {**************}
              {* SEGMENTO T *}
              {***********MO*}
              If Copy(strLinha, 14, 1) = 'T' Then
              Begin
                {*************************************************}
                {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
                {**********************************************MO*}
                strNomArq := lstArquivo.Items.Strings[intContador];
                strNumCtr := Copy(strLinha, 106, 25);
                strMotOco := '';
                fltTarifa := 0;
                strValLan := '';
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';

                If Length(Trim(strNumCtr)) = 25 Then //duplicata com 12 digitos
                Begin
                  strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                  strParcel := Copy(strNumCtr,013,01);
                  strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                  strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                  strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
                end;

                strCodOco := Copy(strLinha, 016, 02);

                If MatchStr(strCodOco,['28','27']) Then
                  strMotOco := fStrZero(Copy(strLinha, 214,02),2);

                pDadosDuplicataVel(strNumCtr,    strNumDupVel, strParcelVel,
                                   strEspDocVel, strCodEmpVel, strCodCliVel);

                If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
                Begin
                  pDadosDuplicataOutros(strNumCtr,    strNumDupVel, strParcelVel,
                                        strEspDocVel, strCodEmpVel, strCodCliVel);

                  If Not fEmptyStr(strCodCliVel) Then
                  Begin
                    strNumDup := strNumDupVel;
                    strParcel := strParcelVel;
                    strEspDoc := strEspDocVel;
                    strCodEmp := strCodEmpVel;
                    strCodCli := strCodCliVel;
                  End;
                End;

                strDtaVen := Copy(strLinha,074, 08);
                If Not fEmptyStr(strDtaVen) And (strDtaVen <> '00000000') Then
                Begin
                  System.Insert('/',strDtaVen,3);
                  System.Insert('/',strDtaVen,6);
                End;

                strNosNum := Copy(strLinha, 038, 20);
                strValDup := Copy(strLinha, 082,15);

                If blnUsaTarifa then
                   fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG748_240p-' + IntToStr(intCartei), 'VALOTAR', '0'));

                If ((strCodOco = '06') and (fltTarifa > 0) and (blnUsaTarifa))  then
                Begin
                   strTarifa := Copy(strLinha,176,13);
                End;

                If (strCodOco = '28') and
                   (fltTarifa > 0) and
                   (blnUsaTarifa)  then
                Begin
                  strTarifa := Copy(strLinha, 199,15);
                End;
              End;

              {**************}
              {* SEGMENTO U *}
              {***********MO*}
              If (Copy(strLinha, 14, 1) = 'U')Then
              Begin
                strJurMor := Copy(strLinha, 018, 15);
                strDesCon := Copy(strLinha, 033, 15);
                strValPag := Copy(strLinha, 078, 15);
                strDtaOco := Copy(strLinha, 138, 08);

                If Not fEmptyStr(strDtaOco) And (strDtaOco <> '00000000') Then
                Begin
                  System.Insert('/',strDtaOco,3);
                  System.Insert('/',strDtaOco,6);
                End;

                strDtaPag := strDtaOco;
                strCodBco := '748';
                strCodRej := '';
                strCodBcoReceb := Copy(strLinha,97,03);
                strAgeReceb    := Copy(strLinha,100,05);

                {********************************************}
                {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
                {*****************************************LB*}
                If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
                Begin

                  If Not blnExiste Then
                    pDeletaArqBco;

                  If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
                  Begin
                    lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                          strEspDoc + '-' +
                                                          strCodEmp +
                                                          ' Cliente: ' + strCodCli +
                                                          ' Nosso Número: ' + strNosNum);
                  End
                  Else If intQtdDup > 1 Then
                  Begin
                    lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                          strEspDoc + '-' +
                                                          strCodEmp +
                                                          ' Cliente: ' + strCodCli +
                                                          ' Nosso Número: ' + strNosNum);
                  End
                  Else If strCarteiraCadRec.Contains('CONFIG748API') And (Not LPermiteCarteiraAPI) Then
                  Begin
                    lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                          strEspDoc + '-' +
                                                          strCodEmp +
                                                          ' Cliente: ' + strCodCli +
                                                          ' Nosso Número: ' + strNosNum);

                    lstArqNaoGravados.Add('--Duplicata foi gerada por uma carteira que comunica com o banco através de API. Deve ser baixada pela carteira em que o boleto foi gerado.');
                  End
                  Else
                  Begin
                    pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                                 strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                                 strValDup, strValPag, strJurMor, '',        strCodBco,
                                 strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                                 False, '', '', '', strTarifa, strValLan);

                    pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                    blnExiste := True;
                  End;
                End
                Else
                Begin
                  pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                              StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                              fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
                End;

                {*****************************}
                {* GRAVAÇÃO DA TABELA REMGER *}
                {** DADOS GERAIS DA REMESSA **}
                {**************************MO*}

                //GRAVA SOMENTE UMA VEZ
                if intContGeral = 0 then
                begin
                  pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
                  Inc(intContGeral);
                end;

                {*****************************}
                {* GRAVAÇÃO DA TABELA RETDET *}
                {**** DETALHES DA RETORNO ****}
                {**************************MO*}
                pGravaRetDet(strAutoIncremRet,
                             strAutoIncremCadRec,
                             strNosNum,
                             fStrToFloat(strValPag)/100,
                             fStrtoFloat(strJurMor)/100,
                             fStrtoFloat(strDescon)/100,
                             0,
                             StrToDateDef(strDtaPag, 0),
                             strCodBcoReceb,
                             strAgeReceb,
                             dtaDtaArqRet,
                             strLoginUsuarioLogado,
                             '',
                             strCodOco,
                             blnAtualizaRet);
                blnAtualizaRet := False;
              End;
            End;// fim do while

            CloseFile(txtTexto);

            If Not cdsNaoGra.IsEmpty Then
              pMostraArqNaoBaixa('SICREDI 240p');

            pMostraDupNaoBaixa(lstArqNaoGravados);

            If Not blnExiste Then
            Begin
              fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
              Continue;
            End;

            strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
            If Not fRenomeiaArquivo(strNomArq) Then
            Begin
              Exit;
            End;

            fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);
          end;
        End;
      End;// fim do For

      frmRetBco.Close;
    Except
      On E: Exception Do
      Begin
        pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
      End;
    End;

  finally
    If Assigned(LDadosDetalhe) Then
      FreeAndNil(LDadosDetalhe);

    If Assigned(LDetalhamentoRetorno) Then
      FreeAndNil(LDetalhamentoRetorno);

    If Assigned(LAguardeDetalhamento) Then
      FreeAndNil(LAguardeDetalhamento);
  end;

end;

function TfrmRetBco.fGeraRetornoSifra(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strVerNomArq: String;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strValLan: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    strCodMot: String;
    intAplica: Integer;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;

    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strCusCar: String;
    strUtilizaDtaCre,
    strDtaCre: String;
    strCarBco: String;
    blnDescon: Boolean;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG998-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  strUtilizaDtaCre := fGetBancoConfig(0,'CONFIG998-' + IntToStr(intCartei),'DTACRED', 'N');
  Try
    For   intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        intAplica := 0;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;

          If Copy(strLinha, 1, 1) = '1' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strVerNomArq := UpperCase(LeftStr(strNomArq,2));
            strNumCtr := Copy(strLinha,038,25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            end
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := Trim(Copy(strNumCtr,001,06));
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
              strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strValPag := Copy(strLinha,254,13);

            strDtaPag := fStrZero('0',6);
            If (fStrToFloat(strValPag)/100) > 0 Then
            Begin
              strDtaPag := Copy(strLinha,111,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            strDtaCre := Copy(strLinha, 296,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;

            if strUtilizaDtaCre = 'N' Then
              strDtaCre := '';

            strValDup := Copy(strLinha,153,13);
            strValLan := '';

            strCodBco := '998'; //Copy(strLinha,166,03);
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Copy(strLinha,127,15);
            strCodRej := '';
            //strCodMot := Copy(strLinha,319,10);
            strMotoco := '';
            //strCarBco := Copy(strLinha,022,03);

            //if strCodOco = '28' then
            // strCusCar := Copy(strLinha,189,13) //Custos de cartório
            //else
              strCusCar := '';

            //Altera data de ocorrência no cado de Ocorrência  = 15
            If (strCodOco = '15') and (strUtilizaDtaCre = 'N') Then
            Begin
              strDtaOco := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            {********************}
            {* RETORNO DESCONTO *}
            {*****************LB*}
            If strVerNomArq = 'DS' Then
            Begin
              strDesCon := '0000000000000';
              strJurMor := '0000000000000';
            End
            {*******************}
            {* RETORNO SIMPLES *}
            {****************LB*}
            Else
            Begin
              strDesCon := Copy(strLinha,241,13);
              strJurMor := Copy(strLinha,267,13);
            End;


            strCodBcoReceb := '';//Copy(strLinha,166,03);
            strAgeReceb    := '';//Copy(strLinha,169,05);

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            {********************************************}
            {* VERIFICA O FORMATO NOVO E VELHO DO AUTCOM*}
            {* OBS: FOI FEITO USANDO O LAYOUT DA GUAÇU  *}
            {***xx/xx/xxxx****************************MV*}
            If (fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If (strCodOco = '03') Then
                pGravaRetMot(strCodBco, strNumDup, strParcel, strEspDoc, strCodCli,
                             strCodEmp, strCodMot, strCodOco);

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False,     '',        '',        strDtaCre,        '',
                           strValLan, strCusCar, strCarBco, '',               '',
                           blnDescon);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                           strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                           strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                           strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq,
                           False,        '',           '',           strDtaCre,           '',
                           strValLan,    strCusCar,    '',           '',                  '',
                           blnDescon);
                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            inc( intAplica );

            If ( intAplica Mod 10 ) = 0 Then
              Application.ProcessMessages;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('SIFRA');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;
end;

function TfrmRetBco.fGeraRetornoSisprime(cxgProgresso: TcxProgressBar): Boolean;
Var
  txtTexto    : TextFile;
  intContador : Integer;
  blnExiste: Boolean;
  strVerNomArq: String;
  strLinha : String;
  strParcel: String;
  strNumCtr: String;
  strDtaOco: String;
  strDtaVen: String;
  strDtaPag: String;
  strNumDup: String;
  strCodCli: String;
  strCodEmp: String;
  strEspDoc: String;
  strNomArq: String;
  strCodBco: String;
  strDesCon: String;
  strCodOco: String;
  strValDup: String;
  strValPag: String;
  strValLan: String;
  strJurMor: String;
  strNosNum: String;
  strCodRej: String;
  strMotOco: String;
  strCodMot: String;
  intAplica: Integer;
  dtaDtaArq: TDateTime;
  intQtdDup: Integer;
  strDtaArqRet: String;
  dtaDtaArqRet: TDateTime;

  strNumDupVel: String;
  strParcelVel: String;
  strEspDocVel: String;
  strCodEmpVel: String;
  strCodCliVel: String;
  LNumDoc: String;

  strAutoIncremRet: String;
  strCodBcoReceb: String;
  strAgeReceb: String;
  strCusCar: String;
  strUtilizaDtaCre,
  strDtaCre: String;
  strCarBco: String;
  blnDescon: Boolean;

  intContGeral: Integer;
  intIndex: Integer;
  intLinha : Integer;
  intLinhas: Integer;
