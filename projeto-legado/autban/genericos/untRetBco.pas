        TfrmGravando.fExecuta(fGeraRetornoSantander, frmProcessando, 'Importando Arquivo de Retorno...');
      End
      Else If strCodBco = '756' Then
      Begin
        If strTipGer = 'P' Then
          TfrmGravando.fExecuta(fGeraRetornoBcoBancoobContasPagar, frmProcessando, 'Importando Arquivo de Retorno...')
        Else
          TfrmGravando.fExecuta(fGeraRetornoBancoob, frmProcessando, 'Importando Arquivo de Retorno...');
      End
      Else If strCodBco = '422' Then
      Begin
        If strTipGer = 'P' Then
          TfrmGravando.fExecuta(fGeraRetornoBcoSafraCTP, frmProcessando, 'Importando Arquivo de Retorno...')
        Else
        Begin
          If Pos('Safra (API)',strNomBanco) > 0 Then
            TfrmGravando.fExecuta(fGeraRetornoSafraAPI, frmProcessando, 'Importando Arquivo de Retorno...')
          Else
            TfrmGravando.fExecuta(fGeraRetornoSafra, frmProcessando, 'Importando Arquivo de Retorno...');
        End;
      End
      Else If strCodBco = '637' Then
      Begin
         If Pos('Sofisa LP [444p]',strNomBanco) > 0 Then
            TfrmGravando.fExecuta(fGeraRetornoSofisa_LP_444p, frmProcessando, 'Importando Arquivo de Retorno...')
         Else
         If Pos('444p',strNomBanco) > 0 Then
            TfrmGravando.fExecuta(fGeraRetornoSofisa_444p, frmProcessando, 'Importando Arquivo de Retorno...')
         Else
            TfrmGravando.fExecuta(fGeraRetornoSofisa, frmProcessando, 'Importando Arquivo de Retorno...');
      End
