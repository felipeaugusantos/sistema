function TfrmRetBco.fGeraRetornoSantander(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG353-' + IntToStr(intCartei) + '-' + VS_strCodEmp;
  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;
          If Copy(strLinha, 1, 1) = '1' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strNumCtr := Copy(strLinha,038,25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            End
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            {**********************************}
            {* DATA DE PAGTO EH A MESMA QUE A *}
            {* DATA DE OCORRENCIA             *}
            {*******************************JB*}
            strCodOco := Copy(strLinha,109,02);
            If Not SameText(strCodOco, '02') Then
              strDtaPag := strDtaOco;

            strDesCon := Copy(strLinha,241,13);
            strValDup := Copy(strLinha,153,13);
            strValPag := Copy(strLinha,254,13);
            strJurMor := Copy(strLinha,267,13);
            strCodBco := '353'; //Copy(strLinha,166,03);
            strNosNum := Copy(strLinha,127,08);
            strCodRej := '';
            strMotOco := '';

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                             strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                             strValDup, strValPag, strJurMor, '',        strCodBco,
                             strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString))) Then
                Begin
                  TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDup,
                                                           strEspDoc,
                                                           strCodEmp,
                                                           strCodCli,
                                                           strParcel,
                                                           strLoginUsuarioLogado,
                                                           fRetCgcCpf(strCodCli),
                                                           afcImportaRetornoBancario);
                End;

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;
          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArq,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('SANTANDER');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoSantander240p(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    blnLeuDta: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;
    objCnfOco: TCnfOco;
    objCnfDao: TCnfOcoDao;

    strOcoBco: String;
    strOcoLay: String;
    strNumPos: String;
    strOcoEsp: String;
    strOcoEmp: String;
    intOcoCar: Integer;

    strValLan: String;
    strCusCar: String;
    strOutVal: String;

    strTarifa: String;
    fltTarifa: Double;

    blnDescon: Boolean;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  blnDescon := False; //remover warning

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  strCodBco := '033';
  blnExiste := False;
  strCartei := 'CONFIG033B240p-' + IntToStr(intCartei) + '-' + VS_strCodEmp;
  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin
      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************JU*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If ((Copy(strLinha, 01, 03)) <> '033') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Santander ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 144, 8);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else
          dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        blnLeuDta := False;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        strValLan := '';
        strTarifa := '';
        fltTarifa := 0;
        strCusCar := '';

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************JU*}
          If Eof(txtTexto) Then
            Continue;

          {****************}
          {* SEGMENTO "T" *}
          {*************JU*}
          If Copy(strLinha, 14, 1) = 'T' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************JU*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strNumCtr := Copy(strLinha,101,25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            strValLan := '';
            strTarifa := '';
            fltTarifa := 0;
            strCusCar := '';

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            End
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
            End;

            strDtaVen := Copy(strLinha,70,08);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '00000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strValDup := Copy(strLinha,78,15);
            strCodOco := Copy(strLinha,16,02);
            strNosNum := Copy(strLinha,041,13);
            strNosNum := Trim(RightStr(strNosNum, 08));
            strNosNum := fPadL(strNosNum,008,'0');
            strTarifa := Copy(strLinha,194,15);

            strCodRej := '';
            If strCodOco = '26' Then
            Begin
              strDtaVen := '00000000';

              strCodRej := Copy(strLinha,209,10);
            End;

            strMotOco := '';

          End;

          {****************}
          {* SEGMENTO "U" *}
          {*************JU*}
          If Copy(strLinha, 14, 1) = 'U' Then
          Begin
            strDtaOco := Copy(strLinha,138,08);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '00000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaPag := strDtaOco;

            strDesCon := Copy(strLinha,33,15);
            strValPag := Copy(strLinha,78,15);
            strJurMor := Copy(strLinha,18,15);
            strOutVal := Copy(strLinha,123,15);

            blnLeuDta := True;
          End;

          strCodBcoReceb := Copy(strLinha,166,03);
          strAgeReceb    := Copy(strLinha,169,05);

          If blnLeuDta Then
          Begin

            if fCfgSis('ENCBAN', varBoolean) then
               fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG033B240p-' + IntToStr(intCartei), 'VALOTAR', '0'));

            If ((strCodOco = '06') and (fltTarifa > 0) and (fCfgSis('ENCBAN', varBoolean)))  Then
            Begin
              //strTarifa := Copy(strLinha,176,13);

              strValPag := fStrZero( FloatToStr( fStrToFloat(Copy(strLinha,78,15))+
                                                 IIF(Not fEmptyStr(strOutVal), fStrToFloat(strOutVal), 0) -
                                                 fStrToFloat(strTarifa) ) , 13);

              strValLan := fStrZero( FloatToStr( fStrToFloat(Copy(strLinha,78,15)) +
                                                 IIF(Not fEmptyStr(strOutVal), fStrToFloat(strOutVal), 0)), 13 );
            End;

            // Lançamentos para tarifas auxiliares da duplicata(Baixa Simples, Cartório...)
            If fCfgSis('ENCBAN', varBoolean) Then
            Begin
              pDesmembraCarteira('CONFIG033B240p-' + IntToStr(intCartei) + '-' +
                VS_strCodEmp, strOcoBco, strOcoLay, strNumPos, strOcoEsp,
                strOcoEmp, intOcoCar);

              objCnfDao := TCnfOcoDao.Create(strOcoBco, strOcoLay, strNumPos,
                strOcoEsp, strOcoEmp, intOcoCar);

              objCnfOco := objCnfDao.fBuscaPorOcorrencia(strCodOco);
              If Assigned(objCnfOco) Then
              Begin
                If objCnfOco.blnCusCar Then
                  strCusCar := strTarifa //Copy(strLinha, 176, 13)
                Else
                  strTarifa := strTarifa;

                strValPag := '0000000000000';

                objCnfOco.Free;

              End;

              objCnfDao.Free;
            End;
            blnDescon := False;

            If fGetBancoConfig(0, 'CONFIG033B240p-' + IntToStr(intCartei), '05DESCON', '') = 'S' Then
            Begin
              blnDescon := (strCodOco = '05');
              If blnDescon Then
                strValLan := strValDup;
            End;
          End;

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************JU*}
          If blnLeuDta Then
          Begin

            If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
            Begin
              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                             strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                             strValDup, strValPag, strJurMor, '',        strCodBco,
                             strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                             False,            '',        '',        '', strTarifa,
                             strValLan, strCusCar,        '',        '',        '',
                             blnDescon);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else
            Begin
               pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                           StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                           fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            blnLeuDta := False;
          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArqRet,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('SANTANDER[240p]');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;

    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;


function TfrmRetBco.fGeraRetornoSantanderBan(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strOutVal: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    strDtaCre: String;
    dtaDtaArq: TDateTime;
    strConRet: String;
    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;
    intQtdDup: Integer;

    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strCusCar: String;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;
    objCnfOco: TCnfOco;
    objCnfDao: TCnfOcoDao;
    strOcoBco: String;
    strOcoLay: String;
    strNumPos: String;
    strOcoEsp: String;
    strOcoEmp: String;
    intOcoCar: Integer;
    strValLan: String;

    blnDescon: Boolean;

    strTarifa: String;
    fltTarifa: Double;

    strTipLay: String;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG033-' + IntToStr(intCartei) + '-' + VS_strCodEmp;
  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intlinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If ((Copy(strLinha, 077, 03)) <> '033') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco Santander ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        {***********************************}
        {* LÊ O HEADER PARA SABER O LAYOUT *}
        {********************************AJ*}
        If LeftStr(strLinha, 1) = '0' Then
          strTipLay := Trim(Copy(strLinha,012,15));

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************AF*}
          If Eof(txtTexto) Then
            Continue;

          If Copy(strLinha, 1, 1) = '1' Then
          Begin
            strNomArq := lstArquivo.Items.Strings[intContador];

            strConRet := Copy(strLinha,030,08);
            If fGetBancoConfig(0, 'CONFIG033B-' + IntToStr(intCartei), 'TRACARTRET', '') = 'S' Then
            Begin
              If  Copy(strLinha, 108, 01).Equals('5') Then
                strConRet := Copy(strLinha, 022, 08);
            End;

            strNumCtr := Copy(strLinha,038,25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            End
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
              strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) And Not fEmptyStr(strNumCtr) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strDtaCre := Copy(strLinha,296,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;

            strCodOco := Copy(strLinha,109,02);

            if Not fCfgSis('ENCBAN', varBoolean) Then
            Begin
              if strCodOco = '24' then
                strCusCar := Copy(strLinha,189,13) //Custos de cartório
              else
                strCusCar := '';
            End;

            strValPag := '';
            strValLan := '';
            strTarifa := '';
            fltTarifa := 0;
            strCusCar := '';

            strDesCon := Copy(strLinha,241,13);
            strValDup := Copy(strLinha,153,13);
            strValPag := Copy(strLinha,254,13);
            strJurMor := Copy(strLinha,267,13);
            strOutVal := Copy(strLinha,280,13);

            strCodBco := '033';
            strNosNum := Copy(strLinha,127,08);
            strCodRej := '';
            strMotOco := '';

            If fStrToFloat(strValPag) > 0 Then
                 strDtaPag := strDtaOco
            Else strDtaPag := '000000';

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);

            if fCfgSis('ENCBAN', varBoolean) then
              fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG033B-' + IntToStr(intCartei), 'VALOTAR', '0'));

            If ((strCodOco = '06') and (fltTarifa > 0) and (fCfgSis('ENCBAN', varBoolean)))  Then
            Begin
              strTarifa := Copy(strLinha,176,13);
              If Trim(strTipLay) = 'EMPRESTIMO' Then
              Begin
                strValPag := fStrZero( FloatToStr( fStrToFloat(Copy(strLinha,254,13)) -
                                                   fStrToFloat(strTarifa) +
                                                   IIF(Not fEmptyStr(strOutVal), fStrToFloat(strOutVal), 0)  ), 13 );
              End
              Else
              Begin
                strValPag := fStrZero( FloatToStr( fStrToFloat(Copy(strLinha,254,13))+
                                                   IIF(Not fEmptyStr(strOutVal), fStrToFloat(strOutVal), 0) -
                                                   fStrToFloat(strTarifa) ) , 13);
              End;

              strValLan := fStrZero( FloatToStr( fStrToFloat(Copy(strLinha,254,13)) +
                                                 IIF(Not fEmptyStr(strOutVal), fStrToFloat(strOutVal), 0)), 13 );
            End;

            // Lançamentos para tarifas auxiliares da duplicata(Baixa Simples, Cartório...)
            If fCfgSis('ENCBAN', varBoolean) Then
            Begin
              pDesmembraCarteira('CONFIG033B-' + IntToStr(intCartei) + '-' +
                VS_strCodEmp, strOcoBco, strOcoLay, strNumPos, strOcoEsp,
                strOcoEmp, intOcoCar);

              objCnfDao := TCnfOcoDao.Create(strOcoBco, strOcoLay, strNumPos,
                strOcoEsp, strOcoEmp, intOcoCar);

              objCnfOco := objCnfDao.fBuscaPorOcorrencia(strCodOco);
              If Assigned(objCnfOco) Then
              Begin
                If objCnfOco.blnCusCar Then
                  strCusCar := Copy(strLinha, 176, 13)
                Else
                  strTarifa := Copy(strLinha, 176, 13);

                strValPag := '0000000000000';

                objCnfOco.Free;

              End;

              objCnfDao.Free;
            End;
            blnDescon := False;
            If fGetBancoConfig(0, 'CONFIG033B-' + IntToStr(intCartei), '05DESCON', '') = 'S' Then
            Begin
              blnDescon := (strCodOco = '05');
              If blnDescon Then
                strValLan := strValDup;
            End;

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************AF*}
            If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,
                                     strCodEmp,strCodCli,strNosNum,
                                     strCodBco, strTipCob, intQtdDup,
                                     strAutoIncremCadRec, strCarteiraCadRec,
                                     'CONFIG033B-' + IntToStr(intCartei),
                                     '', strDtaVen) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                             strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                             strValDup, strValPag, strJurMor, '',        strCodBco,
                             strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                             False,     strConRet, '',        strDtaCre, strTarifa,
                             strValLan, strCusCar, '',        '',        '',
                             blnDescon);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString))) Then
                Begin
                  TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDup,
                                                           strEspDoc,
                                                           strCodEmp,
                                                           strCodCli,
                                                           strParcel,
                                                           strLoginUsuarioLogado,
                                                           fRetCgcCpf(strCodCli),
                                                           afcImportaRetornoBancario);
                End;

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;
          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArqRet,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('SANTANDER');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          If fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! ' +
          'Manter em aberto para análise ou Apagar o arquivo "' + lstArquivo.Items.Strings[intContador] + '" da pasta?', ['&Análise', 'A&pagar']) = 2 Then
            DeleteFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoSantanderContasPagar(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste   : Boolean;
    strLinha    : String;
    strParcel   : String;
    strDtaOco   : String;
    strDtaVen   : String;
    strDtaPag   : String;
    strNumDup   : String;
    strCodFor   : String;
    strCodEmp   : String;
    strNomArq   : String;
    strCodBco   : String;
    strDesCon   : String;
    strCodOco   : String;
    strValDup   : String;
    strValPag   : String;
    strJurMor   : String;
    strNosNum   : String;
    strMotOco   : String;
    strAutInc   : String;
    strBcoFav   : String;
    strSeqBai   : String;
    strSerie_   : String;
    dtaDtaArq   : TDateTime;
    strVenCtp   : String;
    intLinha    : Integer;
    intLinhas   : Integer;
begin

  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetCtp.qryRetCtp);

  blnExiste := False;

  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinha  := 0;
        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          {*****************************************}
          {* VERIFICA SE NAO FOR DETALHE ELE PULA  *}
          {**************************************AJ*}
          If (Not (Copy(strLinha,08,01) = '3')) Or
             ((Copy(strLinha,08,01) = '3') And (Copy(strLinha,14,01) = 'J') And (Copy(strLinha,15,05) = ' 0052')) Or
             (Copy(strLinha,14,01) = 'Z') Then
            Continue;

          If (Copy(strLinha, 14, 01) = 'O') then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************AJ*}
            strNomArq :=  lstArquivo.Items.Strings[intContador];

            strAutInc := Copy(strLinha,123,20);
            strNumDup := '';
            strCodEmp := '';
            strCodFor := '';
            strBcoFav := '';
            strNosNum := Copy(strLinha, 143,20);

            strDtaOco := Copy(strLinha, 100,08);

            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaPag := strDtaOco;

            strDtaVen := Copy(strLinha,092,08);

            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strDesCon := '';
            strValDup := Copy(strLinha,108,15);
            strValPag := Copy(strLinha,108,15);
            strJurMor := '';
            strCodOco := Copy(strLinha,231,10);
            strMotOco := '';
            strCodBco := '033';
          End
          Else
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];

            strAutInc := Copy(strLinha,183,20);
            strNumDup := '';  //Passar na funcao como variavel para poder grava-lo
            strCodEmp := '';  //Passar na funcao como variavel para poder grava-lo
            strCodFor := '';  //Passar na funcao como variavel para poder grava-lo
            strBcoFav := Copy(strLinha,018,03);
            strNosNum := Copy(strLinha,216,15);

            strDtaOco := Copy(strLinha,145,08);

            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaPag := strDtaOco;

            strDtaVen := Copy(strLinha,092,08);

            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strDesCon := Copy(strLinha,115,15);
            strValDup := Copy(strLinha,100,15);
            strValPag := Copy(strLinha,153,15);
            strJurMor := Copy(strLinha,130,15);
            strCodBco := '033';
            strCodOco := Copy(strLinha,231,10);
  //          strNosNum := Copy(strLinha,127,08);
            strMotOco := '';
          End;
          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************LB*}
          If fVerificaExisteDuplicContasPagar(strAutInc, strCodFor, strNumDup, strParcel, strCodEmp, strSeqBai, strSerie_, strVenCtp) Then
          Begin

            If Not blnExiste Then
              pDeletaArqBcoContasPagar;

            pGravaArqBcoContasPagar(strParcel, strNumDup, strCodFor, strCodEmp, strSeqBai, strSerie_,
                                    strCodBco, strBcoFav, strNosNum, strCodOco, strMotOco, strValDup,
                                    strDesCon, strJurMor, strValPag, strDtaVen, strDtaPag, strNomArq,
                                    strAutInc, dtaDtaArq);

            pGravaLogCtp(strCodBco, strAutInc);

            blnExiste := True;

          End
          Else
          Begin
            pIncluiOcor(strNosNum, strCodFor, strNumDup, '', strCodEmp,
                        StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                        fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('SANTANDER');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;

        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If

    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno Contas a Pagar]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoSerrana(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strVerNomArq: String;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    intAplica: Integer;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;

    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strCusCar: String;
    strUtilizaDtaCre,
    strDtaCre: String;
    strCarBco: String;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG991-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  strUtilizaDtaCre := fGetBancoConfig(0,'CONFIG991-' + IntToStr(intCartei),'DTACRED', 'N');
  Try
    For   intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        //If ((Copy(strLinha, 080, 04)) <> 'NAFM') Then
        //Begin
        //  fMensagem('', 'Não é um arquivo de retorno do Na Fomento Mercantil ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
        //  CloseFile(txtTexto);
        //  Exit;
        //End;

        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );

        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        intAplica := 0;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;

          If Copy(strLinha, 1, 1) = '1' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strVerNomArq := UpperCase(LeftStr(strNomArq,2));
            strNumCtr := Copy(strLinha,038,25);

            If Length(Trim(strNumCtr)) = 25 Then //duplicata com 12 digitos
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Copy(strNumCtr,013,01);
              strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
              strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel, strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel, strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;
            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strValPag := Copy(strLinha,254,13);

            strDtaPag := fStrZero('0',6);
            If (fStrToFloat(strValPag)/100) > 0 Then
            Begin
              strDtaPag := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            strDtaCre := Copy(strLinha, 296,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;

            if strUtilizaDtaCre = 'N' Then
              strDtaCre := '';

            strValDup := Copy(strLinha,153,13);

            strCodBco := '991'; //Copy(strLinha,166,03);
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Copy(strLinha,071,17);
            strCodRej := '';
            strMotOco := Copy(strLinha,319,10);
            strCarBco := '';

            if strCodOco = '28' then
              strCusCar := Copy(strLinha,189,13) //Custos de cartório
            else
              strCusCar := '';

            //Altera data de ocorrência no cado de Ocorrência  = 15
            If (strCodOco = '15') and (strUtilizaDtaCre = 'N') Then
            Begin
              strDtaOco := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            {********************}
            {* RETORNO DESCONTO *}
            {*****************LB*}
            If strVerNomArq = 'DS' Then
            Begin
              strDesCon := '0000000000000';
              strJurMor := '0000000000000';
            End
            {*******************}
            {* RETORNO SIMPLES *}
            {****************LB*}
            Else
            Begin
              strDesCon := Copy(strLinha,241,13);
              strJurMor := Copy(strLinha,267,13);
            End;

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            {********************************************}
            {* VERIFICA O FORMATO NOVO E VELHO DO AUTCOM*}
            {* OBS: FOI FEITO USANDO O LAYOUT DA GUAÇU  *}
            {***xx/xx/xxxx****************************MV*}
            If (fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False,     '',        '',        strDtaCre,        '',
                           '',        strCusCar, strCarBco);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                           strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                           strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                           strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq,
                           False,        '',           '',           strDtaCre,           '',
                           '',           strCusCar);
                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            inc( intAplica );

            If ( intAplica Mod 10 ) = 0 Then
              Application.ProcessMessages;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('SERRANA');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;
end;

function TfrmRetBco.fGeraRetornoRubi(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strVerNomArq: String;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    intAplica: Integer;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;

    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strCusCar: String;
    strUtilizaDtaCre,
    strDtaCre: String;
    strCarBco: String;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG989-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  strUtilizaDtaCre := fGetBancoConfig(0,'CONFIG989-' + IntToStr(intCartei),'DTACRED', 'N');
  Try
    For   intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        //If ((Copy(strLinha, 080, 04)) <> 'NAFM') Then
        //Begin
        //  fMensagem('', 'Não é um arquivo de retorno do Na Fomento Mercantil ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
        //  CloseFile(txtTexto);
        //  Exit;
        //End;

        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );

        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        intAplica := 0;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;

          If Copy(strLinha, 1, 1) = '1' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strVerNomArq := UpperCase(LeftStr(strNomArq,2));
            strNumCtr := Copy(strLinha,038,25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            If Length(Trim(strNumCtr)) = 25 Then //duplicata com 12 digitos
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Copy(strNumCtr,013,01);
              strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
              strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel, strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel, strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;
            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strValPag := Copy(strLinha,254,13);

            strDtaPag := fStrZero('0',6);
            If (fStrToFloat(strValPag)/100) > 0 Then
            Begin
              strDtaPag := Copy(strLinha,111,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            strDtaCre := Copy(strLinha, 296,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;

            if strUtilizaDtaCre = 'N' Then
              strDtaCre := '';

            strValDup := Copy(strLinha,153,13);

            strCodBco := '989'; //Copy(strLinha,166,03);
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Copy(strLinha,071,12);
            strCodRej := '';
            strMotOco := Copy(strLinha,319,10);
            strCarBco := '';

            if strCodOco = '28' then
              strCusCar := Copy(strLinha,189,13) //Custos de cartório
            else
              strCusCar := '';

            //Altera data de ocorrência no cado de Ocorrência  = 15
            If (strCodOco = '15') and (strUtilizaDtaCre = 'N') Then
            Begin
              strDtaOco := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            {********************}
            {* RETORNO DESCONTO *}
            {*****************LB*}
            If strVerNomArq = 'DS' Then
            Begin
              strDesCon := '0000000000000';
              strJurMor := '0000000000000';
            End
            {*******************}
            {* RETORNO SIMPLES *}
            {****************LB*}
            Else
            Begin
              strDesCon := Copy(strLinha,241,13);
              strJurMor := Copy(strLinha,267,13);
            End;

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            {********************************************}
            {* VERIFICA O FORMATO NOVO E VELHO DO AUTCOM*}
            {* OBS: FOI FEITO USANDO O LAYOUT DA GUAÇU  *}
            {***xx/xx/xxxx****************************MV*}
            If (fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False,     '',        '',        strDtaCre,        '',
                           '',        strCusCar, strCarBco);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                           strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                           strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                           strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq,
                           False,        '',           '',           strDtaCre,           '',
                           '',           strCusCar);
                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            inc( intAplica );

            If ( intAplica Mod 10 ) = 0 Then
              Application.ProcessMessages;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('DATA VENIA');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;
end;

function TfrmRetBco.fGeraRetornoBanestes(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;
    stlArquivo: TStrings;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG021-' + IntToStr(intCartei) + '-' + VS_strCodEmp;
  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador],dtaDtaArq);

        {******************************************************}
        {* CONVERTENDO PARA ANSI, POIS SE O ARQUIVO FOI SALVO *}
        {* COMO UTF8 BOM, O SISTEMA LÊ CARACTERES A MAIS      *}
        {***************************************************AJ*}
        stlArquivo := TStringList.Create;
        stlArquivo.LoadFromFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        stlArquivo.SaveToFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], TEncoding.ANSI);
        intLinhas := stlArquivo.Count; //quantidade de linhas no arquivo (p/ exibir a progressbar)
        FreeAndNil(stlArquivo);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);
        If ((Copy(strLinha, 077, 03)) <> '021') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco Banestes ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************AF*}
          If Eof(txtTexto) Then
            Continue;

          strNomArq := lstArquivo.Items.Strings[intContador];

          strNumCtr := Copy(strLinha,038,25);

          strNumDup := '';
          strParcel := '';
          strEspDoc := '';
          strCodEmp := '';
          strCodCli := '';

          {********************************************************************************************}
          {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
          {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
          {*****************************************************************************************MO*}
          if EhNumero(Copy(strNumCtr,006,02)) then
          begin
            //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
            If (Length(Trim(strNumCtr)) = 20) then
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Trim(Copy(strNumCtr,013,03));
              strEspDoc := Copy(strNumCtr,016,02);
              strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
              strCodCli := '';
            End
            //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
            Else If Length(Trim(strNumCtr)) = 25 Then
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Copy(strNumCtr,013,01);
              strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
              strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
            End;
          End
          Else
          Begin
            //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
            strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
            strParcel := Copy(strNumCtr,007,01);
            strEspDoc := Copy(strNumCtr,008,02);
            strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
            strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
          End;

          strDtaOco := Copy(strLinha,111,06);
          If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
          Begin
            System.Insert('/',strDtaOco,3);
            System.Insert('/',strDtaOco,6);
          End;

          strDtaVen := Copy(strLinha,147,06);
          If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
          Begin
            System.Insert('/',strDtaVen,3);
            System.Insert('/',strDtaVen,6);
          End;

          strCodOco := Copy(strLinha,109,02);
          strValDup := Copy(strLinha,156,10);
          strValPag := Copy(strLinha,254,13);
          strJurMor := Copy(strLinha,267,13);
          strCodBco := '021';
          strNosNum := Copy(strLinha,063,10);
          strCodRej := '';
          strMotOco := '';

          If fStrToFloat(strValPag) > 0 Then
               strDtaPag := strDtaOco
          Else strDtaPag := '000000';

          strCodBcoReceb := Copy(strLinha,166,03);
          strAgeReceb    := Copy(strLinha,169,05);

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************AF*}
          If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
          Begin

            If Not blnExiste Then
              pDeletaArqBco;

            If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else If intQtdDup > 1 Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else
            Begin
              pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, '',
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False);

              pGravaLogCtr(strCodBco, strAutoIncremCadRec);

              blnExiste := True;
            End;
          End
          Else
          Begin
            pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                        StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                        fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       0,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArqRet,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('BANESTES');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      If Assigned(stlArquivo) Then
        FreeAndNil(stlArquivo);
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

Function TfrmRetBco.fRetornaCodigoMotivoTransferenciaSafra( sAgencia : String; sConta : String; sValorRetorno : String ) : String;
 Var
     StrAgRetornada : String;
     StrCCRetornada : String;
Begin
   result := '';

   StrAgRetornada := copy(sValorRetorno,1,5);
   StrCCRetornada := copy(sValorRetorno,6,9);

   If (StrAgRetornada = sAgencia) And (StrCCRetornada = sConta) Then
       result := '98'
   Else
   If (StrAgRetornada <> sAgencia) or (StrCCRetornada <> sConta) Then
       result := '99';

   {* Se na posição 308 ate a 321  =   variavel ag e conta = 98-Vinculada;  *}
   {* Se na posição 308 ate a 321  <>  variavel ag e conta = 99-Descontada; *}
End;

function TfrmRetBco.fGeraRetornoSafra(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto   : TextFile;
    intContador: Integer;
    blnExiste: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    strDtaCre: String;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;
    stlArquivo: TStrings;

    StrCodAgencia : String;
    StrContaCorr  : String;

    intContGeral: Integer;
    intIndex: Integer;
    strCodMot : String;

    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG422-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  StrCodAgencia := fGetBancoConfig(0,'CONFIG422-' + IntToStr(intCartei),'CODAGEN','');
  StrContaCorr  := fGetBancoConfig(0,'CONFIG422-' + IntToStr(intCartei),'NUMCTAC','');

  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador],dtaDtaArq);

        {******************************************************}
        {* CONVERTENDO PARA ANSI, POIS SE O ARQUIVO FOI SALVO *}
        {* COMO UTF8 BOM, O SISTEMA LÊ CARACTERES A MAIS      *}
        {***************************************************AJ*}
        stlArquivo := TStringList.Create;
        stlArquivo.LoadFromFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        stlArquivo.SaveToFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], TEncoding.ANSI);
        intLinhas := stlArquivo.Count; //quantidade de linhas no arquivo (p/ exibir a progressbar)
        FreeAndNil(stlArquivo);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);
        If ((Copy(strLinha, 077, 03)) <> '422') And ((Copy(strLinha, 077, 03)) <> '237') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco Safra ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;

          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************AF*}
          If Eof(txtTexto) Then
            Continue;

          strNomArq := lstArquivo.Items.Strings[intContador];
          strNumCtr := Copy(strLinha,038,25);

          strNumDup := '';
          strParcel := '';
          strEspDoc := '';
          strCodEmp := '';
          strCodCli := '';

          {********************************************************************************************}
          {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
          {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
          {*****************************************************************************************MO*}
          if EhNumero(Copy(strNumCtr,006,02)) then
          begin
            //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
            If (Length(Trim(strNumCtr)) = 20) then
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Trim(Copy(strNumCtr,013,03));
              strEspDoc := Copy(strNumCtr,016,02);
              strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
              strCodCli := '';
            End
            //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
            Else If Length(Trim(strNumCtr)) = 25 Then
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Copy(strNumCtr,013,01);
              strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
              strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
            End;
          End
          Else
          Begin
            //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
            strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
            strParcel := Copy(strNumCtr,007,01);
            strEspDoc := Copy(strNumCtr,008,02);
            strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
            strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
          End;

          strDtaOco := Copy(strLinha,111,06);
          If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
          Begin
            System.Insert('/',strDtaOco,3);
            System.Insert('/',strDtaOco,6);
          End;

          strDtaVen := Copy(strLinha,147,06);
          If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
          Begin
            System.Insert('/',strDtaVen,3);
            System.Insert('/',strDtaVen,6);
          End;

          strCodOco := Copy(strLinha,109,02);

          strMotOco := '';

          If strCodOco = '21' Then
          Begin

             If (Copy(strLinha,308,14) <> '00000000000000') And (Not fEmptyStr(Copy(strLinha,308,14))) Then
             Begin

                strMotOco := fRetornaCodigoMotivoTransferenciaSafra( StrCodAgencia, StrContaCorr, Copy(strLinha,308,14) );

             End;

          End;

          strDesCon := Copy(strLinha,241,13);
          strValDup := Copy(strLinha,153,13);
          strValPag := Copy(strLinha,254,13);
          strJurMor := Copy(strLinha,267,13);
          strCodBco := '422';
          strNosNum := Copy(strLinha,127,09);
          strCodRej := '';
          //strMotOco := '';
          strCodMot := Trim(Copy(strLinha,105,03));

          If fStrToFloat(strValPag) > 0 Then
            strDtaPag := strDtaOco;

          strCodBcoReceb := Copy(strLinha,166,03);
          strAgeReceb    := Copy(strLinha,169,05);

          //Data De Crédito Para Ocorrências 06, 07, 15 e 41
          if (strCodOco = '06') Or (strCodOco = '07') Or (strCodOco = '15') Or (strCodOco = '41') then
          begin
            strDtaCre := Copy(strLinha,296,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;
          end
          Else
            strDtaCre := '000000';

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************AF*}
          If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
          Begin

            If Not blnExiste Then
              pDeletaArqBco;

            If strCodOco = '03' Then
              pGravaRetMot(strCodBco, strNumDup, strParcel, strEspDoc,
                           strCodCli,strCodEmp, strCodMot, strCodOco);

            If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else If intQtdDup > 1 Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else
            Begin
              pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False,     '',        '',        strDtaCre);

              pGravaLogCtr(strCodBco, strAutoIncremCadRec);

              blnExiste := True;
            End;
          End
          Else
          Begin
            pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                        StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                        fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArqRet,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('SAFRA');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      If Assigned(stlArquivo) Then
        FreeAndNil(stlArquivo);
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoSafraAPI(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto   : TextFile;
    intContador: Integer;
    blnExiste: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    strDtaCre: String;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;
    stlArquivo: TStrings;

    StrCodAgencia : String;
    StrContaCorr  : String;

    intContGeral: Integer;
    intIndex: Integer;
    strCodMot : String;

    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG422API-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  StrCodAgencia := fArqIniAutban(0,'CONFIG422API-' + IntToStr(intCartei),'CODAGEN','') + fArqIniAutban(0,'CONFIG422API-' + IntToStr(intCartei),'DIGAGEN','');
  StrContaCorr  := fArqIniAutban(0,'CONFIG422API-' + IntToStr(intCartei),'NUMCTAC','');

  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador],dtaDtaArq);

        {******************************************************}
        {* CONVERTENDO PARA ANSI, POIS SE O ARQUIVO FOI SALVO *}
        {* COMO UTF8 BOM, O SISTEMA LÊ CARACTERES A MAIS      *}
        {***************************************************AJ*}
        stlArquivo := TStringList.Create;
        stlArquivo.LoadFromFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        stlArquivo.SaveToFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], TEncoding.ANSI);
        intLinhas := stlArquivo.Count; //quantidade de linhas no arquivo (p/ exibir a progressbar)
        FreeAndNil(stlArquivo);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);
        If ((Copy(strLinha, 077, 03)) <> '422') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco Safra ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;

          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************AF*}
          If Eof(txtTexto) Then
            Continue;

          strNomArq := lstArquivo.Items.Strings[intContador];
          strNumCtr := Copy(strLinha,038,25);

          strNumDup := '';
          strParcel := '';
          strEspDoc := '';
          strCodEmp := '';
          strCodCli := '';

          {********************************************************************************************}
          {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
          {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
          {*****************************************************************************************MO*}
          if EhNumero(Copy(strNumCtr,006,02)) then
          begin
            //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
            If (Length(Trim(strNumCtr)) = 20) then
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Trim(Copy(strNumCtr,013,03));
              strEspDoc := Copy(strNumCtr,016,02);
              strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
              strCodCli := '';
            End
            //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
            Else If Length(Trim(strNumCtr)) = 25 Then
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Copy(strNumCtr,013,01);
              strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
              strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
            End;
          End
          Else
          Begin
            //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
            strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
            strParcel := Copy(strNumCtr,007,01);
            strEspDoc := Copy(strNumCtr,008,02);
            strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
            strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
          End;

          strDtaOco := Copy(strLinha,111,06);
          If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
          Begin
            System.Insert('/',strDtaOco,3);
            System.Insert('/',strDtaOco,6);
          End;

          strDtaVen := Copy(strLinha,147,06);
          If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
          Begin
            System.Insert('/',strDtaVen,3);
            System.Insert('/',strDtaVen,6);
          End;

          strCodOco := Copy(strLinha,109,02);

          strMotOco := '';

          If strCodOco = '21' Then
          Begin

             If (Copy(strLinha,308,14) <> '00000000000000') And (Not fEmptyStr(Copy(strLinha,308,14))) Then
             Begin

                strMotOco := fRetornaCodigoMotivoTransferenciaSafra( StrCodAgencia, StrContaCorr, Copy(strLinha,308,14) );

             End;

          End;

          strDesCon := Copy(strLinha,241,13);
          strValDup := Copy(strLinha,153,13);
          strValPag := Copy(strLinha,254,13);
          strJurMor := Copy(strLinha,267,13);
          strCodBco := '422';
          strNosNum := Copy(strLinha,127,09);
          strCodRej := '';
          //strMotOco := '';
          strCodMot := Trim(Copy(strLinha,105,03));

          If fStrToFloat(strValPag) > 0 Then
            strDtaPag := strDtaOco;

          strCodBcoReceb := Copy(strLinha,166,03);
          strAgeReceb    := Copy(strLinha,169,05);

          //Data De Crédito Para Ocorrências 06, 07, 15 e 41
          if (strCodOco = '06') Or (strCodOco = '07') Or (strCodOco = '15') Or (strCodOco = '41') then
          begin
            strDtaCre := Copy(strLinha,296,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;
          end
          Else
            strDtaCre := '000000';

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************AF*}
          If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
          Begin

            If Not blnExiste Then
              pDeletaArqBco;

            If strCodOco = '03' Then
              pGravaRetMot(strCodBco, strNumDup, strParcel, strEspDoc,
                           strCodCli,strCodEmp, strCodMot, strCodOco);

            If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else If intQtdDup > 1 Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else
            Begin
              pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False,     '',        '',        strDtaCre, '',
                           '',        '',        '',        '',
                           '', false, '', 'API');

              pGravaLogCtr(strCodBco, strAutoIncremCadRec);

              blnExiste := True;
            End;
          End
          Else
          Begin
            pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                        StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                        fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArqRet,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('SAFRA API');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      If Assigned(stlArquivo) Then
        FreeAndNil(stlArquivo);
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

