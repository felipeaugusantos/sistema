procedure TfrmRetBco.pDadosDuplicataOutros(strNumCtr: String;
  var strNumDupVel, strParcelVel, strEspDocVel, strCodEmpVel,
  strCodCliVel: String);
  Var
    qryGen: TUniQuery;
    strSQL: String;
begin

  Try
    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  CTR_CODCLI, ';
    strSQL := strSQL + '  CTR_ESPDOC, ';
    strSQL := strSQL + '  CTR_CODEMP, ';
    strSQL := strSQL + '  CTR_NUMDUP, ';
    strSQL := strSQL + '  CTR_PARCEL  ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADREC ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  CTR_CODVEL = :CODVEL ';

    qryGen := fCriaQuery(Self);
    qryGen.SQL.Clear;
    qryGen.SQL.Add(strSQL);
    qryGen.ParamByName('CODVEL').AsString := Trim(strNumCtr);
    qryGen.Open;

    strCodCliVel := qryGen.FieldByName('CTR_CODCLI').AsString;
    strCodEmpVel := qryGen.FieldByName('CTR_CODEMP').AsString;
    strNumDupVel := qryGen.FieldByName('CTR_NUMDUP').AsString;
    strEspDocVel := qryGen.FieldByName('CTR_ESPDOC').AsString;
    strParcelVel := qryGen.FieldByName('CTR_PARCEL').AsString;

  Except
    On E: Exception Do
    Begin
      strCodCliVel := '';
      pMensagensErro(E.Message,'[TfrmRetBco.pDadosDuplicataOutros]');
    End;
  End;

end;

