          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArqRet,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('HSBC');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;


end;

function TfrmRetBco.fGeraRetornoNossaCx(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strTipReg: String;
    strCodRej: String;
    strMotOco: String;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;

    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG151-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  Try
    For intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador],dtaDtaArq );

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);
        Readln(txtTexto,strlinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;

          {*************************************************}
          {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
          {**********************************************LB*}
          strNomArq := lstArquivo.Items.Strings[intContador];

          strTipReg := Copy(strLinha,008,01); //Para ver se é Trailler
          strNumCtr := Copy(strLinha,104,25);

          strNumDup := '';
          strParcel := '';
          strEspDoc := '';
          strCodEmp := '';
          strCodCli := '';

          {********************************************************************************************}
          {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
          {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
          {*****************************************************************************************MO*}
          if EhNumero(Copy(strNumCtr,006,02)) then
          begin
            //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
            If (Length(Trim(strNumCtr)) = 20) then
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Trim(Copy(strNumCtr,013,03));
              strEspDoc := Copy(strNumCtr,016,02);
              strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
              strCodCli := '';
            End
            //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
            Else If Length(Trim(strNumCtr)) = 25 Then
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Copy(strNumCtr,013,01);
              strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
              strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
            End;
          End
          Else
          Begin
            //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
            strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
            strParcel := Copy(strNumCtr,007,01);
            strEspDoc := Copy(strNumCtr,008,02);
            strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
            strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
          End;

          pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
            strCodEmpVel, strCodCliVel);

          strDtaOco := Copy(strLinha,072,08);
          If Not fEmptyStr(strDtaOco) And (strDtaOco <> '00000000') Then
          Begin
            System.Insert('/',strDtaOco,3);
            System.Insert('/',strDtaOco,6);
          End;

          strDtaVen := Copy(strLinha,072,08);
          If Not fEmptyStr(strDtaVen) And (strDtaVen <> '00000000') Then
          Begin
            System.Insert('/',strDtaVen,3);
            System.Insert('/',strDtaVen,6);
          End;

          strDtaPag := Copy(strLinha,176,08);
          If Not fEmptyStr(strDtaPag) And (strDtaPag <> '00000000') Then
          Begin
            System.Insert('/',strDtaPag,3);
            System.Insert('/',strDtaPag,6);
          End;


          strValPag := fStrZero('0',15);
          strJurMor := fStrZero('0',15);
          strDesCon := fStrZero('0',15);

          strValDup := Copy(strLinha,080,15);
          strCodBco := '151';  //Copy(strLinha,095,03);
          strCodOco := Copy(strLinha,016,02);
          strNosNum := Copy(strLinha,047,10);
          strCodRej := '';
          strMotOco := '';

          Readln(txtTexto,strLinha);

          {******************************}
          {* VERIFICA SE NAO É TRAILLER *}
          {***************************LB*}
          If (strTipReg <> '5') And (strTipReg <> '9') Then
          Begin
            {*************************************}
            {* VERIFICA SE ESTA VINDO O SEGMENTO *}
            {* U, QUE SO VEM QUANDO O TITULO FOI *}
            {* PAGO                              *}
            {**********************************LB*}
            If Copy(strLinha,014,01) = 'U' Then
            Begin

              strDtaOco := Copy(strLinha,141,08);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDesCon := Copy(strLinha,034,15);
              strValPag := Copy(strLinha,080,15);
              strJurMor := Copy(strLinha,018,15);
              strDtaPag := strDtaOco;
            End;

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                             strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                             strValDup, strValPag, strJurMor, '',        strCodBco,
                             strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End

            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                             strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                             strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                             strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End

            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;
          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArq,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('NOSSA CAIXA NOSSO BANCO');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;


end;

function TfrmRetBco.fGeraRetornoCapitalFinancas(
  cxgProgresso: TcxProgressBar): Boolean;
Var
  LVerNomArq,
  LLinha,
  LParcela,
  LNumCtr,
  LDtaOco,
  LDtaVen,
  LDtaPag,
  LNumDup,
  LCodCli,
  LCodEmp,
  LEspDoc,
  LNomArq,
  LCodBco,
  LDesCon,
  LCodOco,
  LValDup,
  LValPag,
  LJurMor,
  LNosNum,
  LCodRej,
  LMotOco,
  LCodMot,
  LAutoIncremRet,
  LCodBcoReceb,
  LAgeReceb,
  LCusCar,
  LUtilizaDtaCre,
  LDtaCre,
  LCarBco,
  LNumDupVel,
  LParcelVel,
  LEspDocVel,
  LCodEmpVel,
  LCodCliVel,
  LDtaArqRetFormatada: String;

  LDtaArq,
  LDtaArqRet: TDateTime;

  LContador,
  LAplica,
  LQtdDup,
  LContGeral: Integer;

  LExiste: Boolean;

  LTexto: TextFile;
begin
  LContGeral := 0;
  LDtaArqRet := 0;
  pnlInfo.Caption := 'Importando Arquivo de Retorno...';
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  LExiste := False;
  strCartei := 'CONFIG978-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  LUtilizaDtaCre := fArqIniAutBan(0,'CONFIG978-' + IntToStr(intCartei),'DTACRED', 'N');
  Try
    For  LContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[LContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[LContador], LDtaArq);

        AssignFile(LTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[LContador]);
        Reset(LTexto);
        Readln(LTexto,LLinha);
        If ((Copy(LLinha, 077, 03)) <> '237') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco Capital Finanças ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(LTexto);
          Exit;
        End;
        LDtaArqRetFormatada := Copy(LLinha, 095, 6);
        LDtaArqRetFormatada := Copy(LDtaArqRetFormatada, 1, 2) + '/' + Copy(LDtaArqRetFormatada, 3, 2) + '/' + Copy(LDtaArqRetFormatada, 5, Length(LDtaArqRetFormatada));
        If fEmptyStr(AnsiReplaceStr(LDtaArqRetFormatada, '/', '')) Or (Not fValidaDataStr(LDtaArqRetFormatada)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(LTexto);
          Exit;
        End
        Else LDtaArqRet := StrToDateTime(LDtaArqRetFormatada);

        LAplica := 0;

        If fRetornoDuplicado(lstArquivo.Items.Strings[LContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(LTexto);
            Exit;
          end;
        end;

        While Not Eof(LTexto) Do
        Begin

          Readln(LTexto,LLinha);

          If (Copy(LLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(LLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(LTexto) Then
            Continue;

          If Copy(LLinha, 1, 1) = '1' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            LNomArq := lstArquivo.Items.Strings[LContador];
            LVerNomArq := UpperCase(LeftStr(LNomArq,2));
            LNumCtr := Copy(LLinha,038,25);

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(LNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(LNumCtr)) = 20) then
              Begin
                LNumDup := fStrZero(Copy(LNumCtr,001,12),12);
                LParcela := Trim(Copy(LNumCtr,013,03));
                LEspDoc := Copy(LNumCtr,016,02);
                LCodEmp := fStrZero(Copy(LNumCtr,018,03),3);
                LCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(LNumCtr)) = 25 Then
              Begin
                LNumDup := fStrZero(Copy(LNumCtr,001,12),12);
                LParcela := Copy(LNumCtr,013,01);
                LEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(LNumCtr,014,01));
                LCodEmp := fStrZero(Copy(LNumCtr,015,03),3);
                LCodCli := fStrZero(Copy(LNumCtr,018,08),8);
              End;
            end
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              LNumDup := Trim(Copy(LNumCtr,001,06));
              LParcela := Copy(LNumCtr,007,01);
              LEspDoc := Copy(LNumCtr,008,02);
              LCodEmp := fStrZero(Copy(LNumCtr,010,03),3);
              LCodCli := fStrZero(Copy(LNumCtr,013,08),8);
            End;

            pDadosDuplicataVel(LNumCtr, LNumDupVel, LParcelVel, LEspDocVel,
              LCodEmpVel, LCodCliVel);

            If fEmptyStr(LEspDocVel) And fEmptyStr(LCodEmpVel) Then
            Begin
              pDadosDuplicataOutros(LNumCtr, LNumDupVel, LParcelVel, LEspDocVel,
                LCodEmpVel, LCodCliVel);

              If Not fEmptyStr(LCodCliVel) Then
              Begin
                LNumDup := LNumDupVel;
                LParcela := LParcelVel;
                LEspDoc := LEspDocVel;
                LCodEmp := LCodEmpVel;
                LCodCli := LCodCliVel;
              End;
            End;

            LDtaOco := Copy(LLinha,111,06);
            If Not fEmptyStr(LDtaOco) And (LDtaOco <> '000000') Then
            Begin
              System.Insert('/',LDtaOco,3);
              System.Insert('/',LDtaOco,6);
            End;

            LDtaVen := Copy(LLinha,147,06);
            If Not fEmptyStr(LDtaVen) And (LDtaVen <> '000000') Then
            Begin
              System.Insert('/',LDtaVen,3);
              System.Insert('/',LDtaVen,6);
            End;

            LValPag := Copy(LLinha,254,13);

            LDtaPag := fStrZero('0',6);
            If (fStrToFloat(LValPag)/100) > 0 Then
            Begin
              LDtaPag := Copy(LLinha,111,06);
              If Not fEmptyStr(LDtaPag) And (LDtaPag <> '000000') Then
              Begin
                System.Insert('/',LDtaPag,3);
                System.Insert('/',LDtaPag,6);
              End;
            End;

            LDtaCre := Copy(LLinha, 296,06);
            If Not fEmptyStr(LDtaCre) And (LDtaCre <> '000000') Then
            Begin
              System.Insert('/',LDtaCre,3);
              System.Insert('/',LDtaCre,6);
            End;

            if LUtilizaDtaCre = 'N' Then
              LDtaCre := '';

            LValDup := Copy(LLinha,153,13);

            LCodBco := '978';
            LCodOco := Copy(LLinha,109,02);
            LNosNum := Copy(LLinha,071,12);
            LCodRej := '';
            LCodMot := Copy(LLinha,319,10);
            LMotOco := '';

            if LCodOco = '28' then
              LCusCar := Copy(LLinha,189,13) //Custos de cartório
            else
              LCusCar := '';

            //Altera data de ocorrência no cado de Ocorrência  = 15
            If (LCodOco = '15') and (LUtilizaDtaCre = 'N') Then
            Begin
              LDtaOco := Copy(LLinha,296,06);
              If Not fEmptyStr(LDtaOco) And (LDtaOco <> '000000') Then
              Begin
                System.Insert('/',LDtaOco,3);
                System.Insert('/',LDtaOco,6);
              End;

              LDtaPag := Copy(LLinha,296,06);
              If Not fEmptyStr(LDtaPag) And (LDtaPag <> '000000') Then
              Begin
                System.Insert('/',LDtaPag,3);
                System.Insert('/',LDtaPag,6);
              End;
            End;

            LCodBcoReceb := Copy(LLinha,166,03);
            LAgeReceb    := Copy(LLinha,169,05);

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            {********************************************}
            {* VERIFICA O FORMATO NOVO E VELHO DO AUTCOM*}
            {* OBS: FOI FEITO USANDO O LAYOUT DA GUAÇU  *}
            {***xx/xx/xxxx****************************MV*}
            If (fVerificaExisteDuplic(LNumDup,LParcela,LEspDoc,LCodEmp,LCodCli,LNosNum,LCodBco, strTipCob, LQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not LExiste Then
                pDeletaArqBco;

              If (LCodOco = '03') Then
                pGravaRetMot(LCodBco, LNumDup, LParcela, LEspDoc, LCodCli,
                             LCodEmp, LCodMot, LCodOco);

              If fVerificaNosNumDuplicado(LNosNum, LCodBco, LCodEmp, strCarteiraCadRec, LQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + LNumDup + '-' +
                                                      LEspDoc + '-' +
                                                      LCodEmp +
                                                      ' Cliente: ' + LCodCli +
                                                      ' Nosso Número: ' + LNosNum);
              End
              Else If LQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + LNumDup + '-' +
                                                      LEspDoc + '-' +
                                                      LCodEmp +
                                                      ' Cliente: ' + LCodCli +
                                                      ' Nosso Número: ' + LNosNum);
              End
              Else
              Begin
                pGravaArqBco(LParcela, LNumDup, LCodCli, LCodEmp, LEspDoc,
                           LDtaOco, LDtaVen, LDtaPag, LNomArq, LDesCon,
                           LValDup, LValPag, LJurMor, '',        LCodBco,
                           LCodOco, LNosNum, LCodRej, LMotOco, LDtaArq,
                           False,     '',        '',        LDtaCre,        '',
                           '',        LCusCar, LCarBco);

                pGravaLogCtr(LCodBco, strAutoIncremCadRec);

                LExiste := True;
              End;
            End
            Else If (fVerificaExisteDuplic(LNumDupVel,LParcelVel,LEspDocVel,LCodEmpVel,LCodCliVel,LNosNum,LCodBco, strTipCob, LQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not LExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(LNosNum, LCodBco, LCodEmp, strCarteiraCadRec, LQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + LNumDup + '-' +
                                                      LEspDoc + '-' +
                                                      LCodEmp +
                                                      ' Cliente: ' + LCodCli +
                                                      ' Nosso Número: ' + LNosNum);
              End
              Else If LQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + LNumDupVel + '-' +
                                                      LEspDocVel + '-' +
                                                      LCodEmpVel +
                                                      ' Cliente: ' + LCodCliVel +
                                                      ' Nosso Número: ' + LNosNum);
              End
              Else
              Begin
                pGravaArqBco(LParcelVel, LNumDupVel, LCodCliVel, LCodEmpVel, LEspDocVel,
                           LDtaOco,    LDtaVen,    LDtaPag,    LNomArq,    LDesCon,
                           LValDup,    LValPag,    LJurMor,    '',           LCodBco,
                           LCodOco,    LNosNum,    LCodRej,    LMotOco,    LDtaArq,
                           False,        '',           '',           LDtaCre,           '',
                           '',           LCusCar);

                pGravaLogCtr(LCodBco, strAutoIncremCadRec);

                LExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(LNosNum, LCodCli, LNumDup + LParcela, LEspDoc, LCodEmp,
                          StrToDateDef(LDtaVen, 0), StrToDateDef(LDtaPag, 0),
                          fStrToFloat(LValDup)/100, fStrToFloat(LValPag)/100);
            End;

            inc( LAplica );

            If ( LAplica Mod 10 ) = 0 Then
              Application.ProcessMessages;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if LContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, LCodBco, StrCartei, LNomArq, 0, blnAtualizaRet, LAutoIncremRet);
              Inc(LContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(LAutoIncremRet,
                         strAutoIncremCadRec,
                         LNosNum,
                         fStrToFloat(LValPag)/100,
                         fStrtoFloat(LJurMor)/100,
                         fStrtoFloat(LDesCon)/100,
                         0,
                         StrToDateDef(LDtaPag, 0),
                         LCodBcoReceb,
                         LAgeReceb,
                         LDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         LCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;

        End;// fim do while

        CloseFile(LTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('CAPITAL FINANÇAS');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not LExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        LNomArq := fraPathRetornoBco.edtDirectory.text + '\' + LNomArq;
        If Not fRenomeiaArquivo(LNomArq) Then
        Begin
          pnlInfo.Caption := '';
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);
      End;
    End;
  Except
    On E: Exception Do
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
  End;

  pnlInfo.Caption := '';
  frmRetBco.Close;
end;

function TfrmRetBco.fGeraRetornoCecred(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    blnLeuDta: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  strCodBco := '085';
  blnExiste := False;
  strCartei := 'CONFIG085-' + IntToStr(intCartei) + '-' + VS_strCodEmp;
  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin
      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************JU*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If ((Copy(strLinha, 01, 03)) <> '085') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco Cecred ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 144, 8);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else
          dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        blnLeuDta := False;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************JU*}
          If Eof(txtTexto) Then
            Continue;

          {****************}
          {* SEGMENTO "T" *}
          {*************JU*}
          If Copy(strLinha, 14, 1) = 'T' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************JU*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strNumCtr := Copy(strLinha,106,25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            End
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
            End;

            strDtaVen := Copy(strLinha,74,08);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '00000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strValDup := Copy(strLinha,82,15);
            strCodOco := Copy(strLinha,16,02);
            strNosNum := Copy(strLinha,038,20);
            strNosNum := Trim(RightStr(strNosNum, 08));
            strNosNum := fPadL(strNosNum,008,'0');
            strCodRej := '';
            strMotOco := '';

          End;

          {****************}
          {* SEGMENTO "U" *}
          {*************JU*}
          If Copy(strLinha, 14, 1) = 'U' Then
          Begin
            strDtaOco := Copy(strLinha,138,08);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '00000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaPag := strDtaOco;

            strDesCon := Copy(strLinha,33,15);
            strValPag := Copy(strLinha,78,15);
            strJurMor := Copy(strLinha,18,15);

            blnLeuDta := True;
          End;

          strCodBcoReceb := Copy(strLinha,166,03);
          strAgeReceb    := Copy(strLinha,169,05);

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************JU*}
          If blnLeuDta Then
          Begin
            If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                             strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                             strValDup, strValPag, strJurMor, '',        strCodBco,
                             strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
          Else
          Begin
            pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                        StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                        fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
          End;

            blnLeuDta := False;
          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArqRet,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('CECRED');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;

    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

