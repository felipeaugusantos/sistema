    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG246-' + IntToStr(intCartei) + '-' + VS_strCodEmp;
  Try
    For   intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************JU*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador],dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If ((Copy(strLinha, 77, 03)) <> '246') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco ABC Brasil ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 95, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************************}
          {* IDENTIFICACAO DE DUPLICATA, CASO NAO FOR ELE PULA *}
          {**************************************************JU*}
          If LeftStr(strLinha, 1) <> '1' Then
            Continue;

          {*************************************************}
          {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
          {**********************************************JU*}
          strNomArq := lstArquivo.Items.Strings[intContador];
          strNumCtr := Copy(strLinha,038,25);

          strNumDupVel := '';
          strParcelVel := '';
          strEspDocVel := '';
          strCodEmpVel := '';
          strCodCliVel := '';

          strNumDup := '';
          strParcel := '';
          strEspDoc := '';
          strCodEmp := '';
          strCodCli := '';

          {********************************************************************************************}
          {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
          {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
          {*****************************************************************************************MO*}
          if EhNumero(Copy(strNumCtr,006,02)) then
          begin
            //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
            If (Length(Trim(strNumCtr)) = 20) then
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Trim(Copy(strNumCtr,013,03));
              strEspDoc := Copy(strNumCtr,016,02);
              strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
              strCodCli := '';
            End
            //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
            Else If Length(Trim(strNumCtr)) = 25 Then //duplicata com 12 digitos
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Copy(strNumCtr,013,01);
              strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
              strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
            End;
          End
          Else
          Begin
            //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
            If Length( Trim( strNumCtr ) ) = 11 Then  //SHX
            Begin

              strNumDup := Copy(strNumCtr,004,08);
              strParcel := '';
              strEspDoc := '';
              strCodEmp := fStrZero(Copy(strNumCtr,001,03),3);
              strCodCli := '';

            End
            Else
            Begin

              Try
                {*****************************************}
                {* ESSE NÃO PODE SER fStrToFloat         *}
                {**************************************JU*}
                fStrToFloat(fStrZero(Copy(strNumCtr,013,08),8));

                strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                strParcel := Copy(strNumCtr,007,01);
                strEspDoc := Copy(strNumCtr,008,02);
                strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
              Except
                strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                strParcel := Copy(strNumCtr,007,01);
                strCodCli := fStrZero(Copy(strNumCtr,008,08),8);
                strCodEmp := fStrZero(Copy(strNumCtr,016,03),3);
                strEspDoc := Copy(strNumCtr,019,02);
              End;

              If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
              Begin
                pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                  strCodEmpVel, strCodCliVel);

                If Not fEmptyStr(strCodCliVel) Then
                Begin
                  strNumDup := strNumDupVel;
                  strParcel := strParcelVel;
                  strEspDoc := strEspDocVel;
                  strCodEmp := strCodEmpVel;
                  strCodCli := strCodCliVel;
                End;

              End;

            End;
          End;

          strDtaOco := Copy(strLinha,111,06);
          If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
          Begin
            System.Insert('/',strDtaOco,3);
            System.Insert('/',strDtaOco,6);
          End;
          strDtaPag := strDtaOco;

          strDtaVen := Copy(strLinha,147,06);
          If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
          Begin
            System.Insert('/',strDtaVen,3);
            System.Insert('/',strDtaVen,6);
          End;

          strDesCon := Copy(strLinha,241,13);
          strValDup := Copy(strLinha,153,13);
          strJurMor := Copy(strLinha,267,13);

          strCodBco := '246';
          strCodOco := Copy(strLinha,109,02);
          strNosNum := Copy(strLinha,063,11);
          strCodRej := '';
          strMotOco := '';

          If (Not fEmptyStr(strDtaPag))                    And
             (strDtaPag <> '000000')                       And
             (strDtaPag <> '00000000')                     And
             ((strCodOco <> '02')                          And
              (strCodOco <> '09'))                         Then
          Begin
            strValPag := fStrZero( FloatToStr( fStrToFloat(Copy(strLinha,254,13)) +
                                               fStrToFloat(Copy(strLinha,176,13)) +
                                               IIF(Not fEmptyStr(strOutVal), fStrToFloat(strOutVal), 0)  ), 13 );
          End
          Else
            strValPag := Copy(strLinha, 254, 13);

          strCodBcoReceb := Copy(strLinha,166,03);
          strAgeReceb    := Copy(strLinha,169,05);

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************JU*}
          If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
          Begin

            If Not blnExiste Then
              pDeletaArqBco;

            If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else If intQtdDup > 1 Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else
            Begin
              pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq);

              pGravaLogCtr(strCodBco, strAutoIncremCadRec);

              blnExiste := True;
            End;
          End

          Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
          Begin

            If Not blnExiste Then
              pDeletaArqBco;

            If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else If intQtdDup > 1 Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else
            Begin
              pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                           strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                           strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                           strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq);

              pGravaLogCtr(strCodBco, strAutoIncremCadRec);

              blnExiste := True;
            End;
          End

          Else
          Begin
            pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                        StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                        fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArqRet,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('ABCBrasil');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador];
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoBancoAmazonia(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    blnLeuDta: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strArqNov: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG003-' + IntToStr(intCartei) + '-' + VS_strCodEmp;
  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin
      If lstArquivo.Selected[intContador] Then
      Begin
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If ((Copy(strLinha, 01, 03)) <> '003') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco Amazônia ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 144, 8);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          blnLeuDta := False;

          {*************************}
          {* COBRANÇA COM REGISTRO *}
          {**********************JU*}
          If fGetBancoConfig(0, 'CONFIG003-' + IntToStr(intCartei), 'COBREG_', '') = 'S' Then
          Begin
            If Copy(strLinha, 1, 1) = '1' Then
            Begin
              {*************************************************}
              {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
              {**********************************************JU*}
              strNomArq := lstArquivo.Items.Strings[intContador];
              strNumCtr := Copy(strLinha,38,25);

              strNumDup := '';
              strParcel := '';
              strEspDoc := '';
              strCodEmp := '';
              strCodCli := '';

              {********************************************************************************************}
              {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
              {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
              {*****************************************************************************************MO*}
              if EhNumero(Copy(strNumCtr,006,02)) then
              begin
                //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
                If (Length(Trim(strNumCtr)) = 20) then
                Begin
                  strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                  strParcel := Trim(Copy(strNumCtr,013,03));
                  strEspDoc := Copy(strNumCtr,016,02);
                  strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                  strCodCli := '';
                End
                //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
                Else If Length(Trim(strNumCtr)) = 25 Then
                Begin
                  strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                  strParcel := Copy(strNumCtr,013,01);
                  strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                  strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                  strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
                End;
              End
              Else
              Begin
                //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
                strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                strParcel := Copy(strNumCtr,007,01);
                strEspDoc := Copy(strNumCtr,008,02);
                strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
              End;

              strDtaVen := Copy(strLinha,147,06);
              If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
              Begin
                System.Insert('/',strDtaVen,3);
                System.Insert('/',strDtaVen,6);
              End;

              strValDup := Copy(strLinha,153,13);
              strValPag := Copy(strLinha,254,13);
              strCodBco := '003';
              strCodOco := Copy(strLinha,109,02);
              strNosNum := Copy(strLinha,071,12);
              strCodRej := '';
              strMotOco := '';

              strDtaOco := Copy(strLinha,111,06);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := strDtaOco;

              blnLeuDta := True;

            End;
          End
          {*************************}
          {* COBRANÇA SEM REGISTRO *}
          {**********************JU*}
          Else
          Begin
            If Copy(strLinha, 1, 1) = 'G' Then
            Begin
              {*************************************************}
              {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
              {**********************************************JU*}
              strNomArq := lstArquivo.Items.Strings[intContador];
              strNumCtr := '';

              strNumDup := '';
              strParcel := '';
              strEspDoc := '';
              strCodEmp := '';
              strCodCli := '';

              strValDup := Copy(strLinha,082,12);
              strValPag := Copy(strLinha,082,12);
              strCodBco := '003';
              strCodOco := '06';
              strNosNum := Copy(strLinha,057,16);
              strNosNum := RightStr(strNosNum,12);
              strCodRej := '';
              strMotOco := '';

              strDtaOco := Copy(strLinha,028,02) + Copy(strLinha,026,02) + Copy(strLinha,022,04);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '00000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := strDtaOco;
              strDtaVen := strDtaOco;

              blnLeuDta := True;

            End;
          End;

          strCodBco      := '003';
          strCodBcoReceb := Copy(strLinha,166,03);
          strAgeReceb    := Copy(strLinha,169,05);

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************JU*}
          If blnLeuDta Then
          Begin
            If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                             strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                             strValDup, strValPag, strJurMor, '',        strCodBco,
                             strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArqRet,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('BANCO DA AMAZONIA');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        strArqNov := AnsiReplaceStr(strNomArq, '.RET', '.OLD');

        Try
          RenameFile(strNomArq, strArqNov);
        Finally
          fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);
        End;

        pGravaNossoNumeroBancoAmazonia;

      End;// Fim do If

    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoBancoob(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    blnLeuDta: Boolean;
    strLinha : String;
    strParcel: String;
    strValLan: String;
    strTarifa: String;
    fltTarifa: Double;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strArqNov: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;

    objCnfOco: TCnfOco;
    objCnfDao: TCnfOcoDao;
    strOcoBco: String;
    strOcoLay: String;
    strNumPos: String;
    strOcoEsp: String;
    strOcoEmp: String;
    intOcoCar: Integer;
    strCusCar: String;
    strDtaCre: String;
    FLoop : Integer;
    FRetorno : TStringList;
    blnDescon: Boolean;
    strTxaDes: String;
    strIofDes: String;

    Function fTransferenciadeCarteira: Boolean;
    Begin
      Result := strCodOco = '48';
    End;

    function TransferenciaParaCobrancaSimples : Boolean;
    Begin
      Result := False;
      If fGetBancoConfig(0,'CONFIG756_240p-' + IntToStr(intCartei),'UTLDESDUP','') = 'S' Then
      Begin
        If strCodOco = '04' Then
          Result := Not fEmptyStr(fCampoTabela('CTR_MOVDES', 'CADREC', ['AUTOINCREM'], [strAutoIncremCadRec], False));
      End;
    End;

begin
  strCodBco := '756';
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  blnDescon := false;
  strCartei := 'CONFIG756-' + IntToStr(intCartei) + '-' + VS_strCodEmp;
  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin
      If Pos('_240p', strNomBanco) <= 0 Then
      Begin
        If lstArquivo.Selected[intContador] Then
        Begin
          If fGetBancoConfig(0,'CONFIG756-' + IntToStr(intCartei),'LAYPARA','') = 'S' Then
          Begin
            AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
            Reset(txtTexto);

            intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

            If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
            begin
              if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                               '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
              begin
                blnAtualizaRet := True;
              end
              else
              begin
                blnAtualizaRet := False;
                CloseFile(txtTexto);
                Exit;
              end;
            end;

            intLinha := 0;

            While Not Eof(txtTexto) Do
            Begin
              Readln(txtTexto,strLinha);

              pProgresso(fInc(intLinha), intLinhas, cxgProgresso);

              If ((Copy(strLinha, 077, 03)) <> '756') And ((Copy(strLinha, 077, 03)) <> '001') Then
              Begin
                fMensagem('', 'Não é um arquivo de retorno do Banco Bancoob ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
                CloseFile(txtTexto);
                Exit;
              End;
              strDtaArqRet := Copy(strLinha, 095, 6);
              strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
              If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
              Begin
                fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
                CloseFile(txtTexto);
                Exit;
              End
              Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

              blnLeuDta := False;

             {*************************************************}
             {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
             {**********************************************JU*}
              strNomArq := lstArquivo.Items.Strings[intContador];
              If Copy(strLinha, 1, 1) = '1' Then
              Begin
                {*************************************************}
                {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
                {**********************************************JU*}
                strNomArq := lstArquivo.Items.Strings[intContador];
                strNumCtr := Copy(strLinha,107,25);

                strNumDup := '';
                strParcel := '';
                strEspDoc := '';
                strCodEmp := '';
                strCodCli := '';

                strDtaVen := Copy(strLinha,147,06);
                If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
                Begin
                  System.Insert('/',strDtaVen,3);
                  System.Insert('/',strDtaVen,6);
                End;

                strValDup := Copy(strLinha,153,13);
                strValPag := Copy(strLinha,254,13);
                strCodBco := '756';
                strCodOco := Copy(strLinha,109,02);
                strNosNum := Copy(strLinha,071,08);
                strCodRej := '';
                strMotOco := '';

                strDtaOco := Copy(strLinha,111,06);
                If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
                Begin
                  System.Insert('/',strDtaOco,3);
                  System.Insert('/',strDtaOco,6);
                End;

                strDtaPag := strDtaOco;

                blnLeuDta := True;

                strCodBcoReceb := Copy(strLinha,166,03);
                strAgeReceb    := Copy(strLinha,169,05);

              End;

              {********************************************}
              {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
              {*****************************************JU*}
              If blnLeuDta Then
              Begin
                If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
                Begin

                  If Not blnExiste Then
                    pDeletaArqBco;

                  If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
                  Begin
                    lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                          strEspDoc + '-' +
                                                          strCodEmp +
                                                          ' Cliente: ' + strCodCli +
                                                          ' Nosso Número: ' + strNosNum);
                  End
                  Else If intQtdDup > 1 Then
                  Begin
                    lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                          strEspDoc + '-' +
                                                          strCodEmp +
                                                          ' Cliente: ' + strCodCli +
                                                          ' Nosso Número: ' + strNosNum);
                  End
                  Else
                Begin
                  pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                               strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                               strValDup, strValPag, strJurMor, '',        strCodBco,
                               strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq);

                  pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                  If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString))) Then
                  Begin
                    TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDup,
                                                             strEspDoc,
                                                             strCodEmp,
                                                             strCodCli,
                                                             strParcel,
                                                             strLoginUsuarioLogado,
                                                             fRetCgcCpf(strCodCli),
                                                             afcImportaRetornoBancario);
                  End;

                  blnExiste := True;
                End;
                End
                Else
                Begin
                  pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                              StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                              fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
                End;

                {*****************************}
                {* GRAVAÇÃO DA TABELA REMGER *}
                {** DADOS GERAIS DA REMESSA **}
                {**************************MO*}

                //GRAVA SOMENTE UMA VEZ
                if (intContGeral = 0) And (strCodBco <> '') then
                begin
                  pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
                  Inc(intContGeral);
                end;

                {*****************************}
                {* GRAVAÇÃO DA TABELA RETDET *}
                {**** DETALHES DA RETORNO ****}
                {**************************MO*}
                pGravaRetDet(strAutoIncremRet,
                             strAutoIncremCadRec,
                             strNosNum,
                             fStrToFloat(strValPag)/100,
                             fStrtoFloat(strJurMor)/100,
                             fStrtoFloat(strDescon)/100,
                             0,
                             StrToDateDef(strDtaPag, 0),
                             strCodBcoReceb,
                             strAgeReceb,
                             dtaDtaArqRet,
                             strLoginUsuarioLogado,
                             '',
                             strCodOco,
                             blnAtualizaRet);
                blnAtualizaRet := False;

              End;
            End;// fim do while

          End
          Else
          Begin
            {************************}
            {* PEGA DATA DO ARQUIVO *}
            {*********************JB*}
            FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);
            //dtaDtaArq := FileDateToDateTime(FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]));

            AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
            Reset(txtTexto);
            Readln(txtTexto,strLinha);
            If ((Copy(strLinha, 077, 03)) <> '756') And ((Copy(strLinha, 077, 03)) <> '001') Then
            Begin
              fMensagem('', 'Não é um arquivo de retorno do Banco Bancoob ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
              CloseFile(txtTexto);
              Exit;
            End;
            strDtaArqRet := Copy(strLinha, 095, 6);
            strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
            If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
            Begin
              fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
              CloseFile(txtTexto);
              Exit;
            End
            Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

            If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
            begin
              if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                               '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
              begin
                blnAtualizaRet := True;
              end
              else
              begin
                blnAtualizaRet := False;
                CloseFile(txtTexto);
                Exit;
              end;
            end;

            While Not Eof(txtTexto) Do
            Begin
              Readln(txtTexto,strLinha);

              {*****************************************}
              {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
              {**************************************JB*}
              If Eof(txtTexto) Then
                Continue;

              {*************************************************}
              {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
              {**********************************************JB*}
              strNomArq := lstArquivo.Items.Strings[intContador];
              strNumCtr := Copy(strLinha,038,25);

              strNumDup := '';
              strParcel := '';
              strEspDoc := '';
              strCodEmp := '';
              strCodCli := '';

              {********************************************************************************************}
              {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
              {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
              {*****************************************************************************************MO*}
              if EhNumero(Copy(strNumCtr,006,02)) then
              begin
                //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
                If (Length(Trim(strNumCtr)) = 20) then
                Begin
                  strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                  strParcel := Trim(Copy(strNumCtr,013,03));
                  strEspDoc := Copy(strNumCtr,016,02);
                  strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                  strCodCli := '';
                End
                //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
                Else If Length(Trim(strNumCtr)) = 25 Then
                Begin
                  strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                  strParcel := Copy(strNumCtr,013,01);
                  strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                  strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                  strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
                End;
              End
              Else
              Begin
                //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
                strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                strParcel := Copy(strNumCtr,007,01);
                strEspDoc := Copy(strNumCtr,008,02);
                strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
              End;

              strDtaOco := Copy(strLinha,111,06);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaVen := Copy(strLinha,147,06);
              If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
              Begin
                System.Insert('/',strDtaVen,3);
                System.Insert('/',strDtaVen,6);
              End;

              strDtaPag := strDtaOco;

              strDesCon := Copy(strLinha,241,13);
              strValDup := Copy(strLinha,153,13);
              strValPag := Copy(strLinha,254,13);
              strJurMor := Copy(strLinha,267,13);
              strCodBco := '756';
              strCodOco := Copy(strLinha,109,02);
              strNosNum := Copy(strLinha,063,12);
              strCodRej := '';
              strMotOco := '';

              strCodBcoReceb := Copy(strLinha,166,03);
              strAgeReceb    := Copy(strLinha,169,05);

              {********************************************}
              {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
              {*****************************************JB*}
              If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
              Begin

                If Not blnExiste Then
                  pDeletaArqBco;

                If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
                Begin
                  lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                        strEspDoc + '-' +
                                                        strCodEmp +
                                                        ' Cliente: ' + strCodCli +
                                                        ' Nosso Número: ' + strNosNum);
                End
                Else If intQtdDup > 1 Then
                Begin
                  lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                        strEspDoc + '-' +
                                                        strCodEmp +
                                                        ' Cliente: ' + strCodCli +
                                                        ' Nosso Número: ' + strNosNum);
                End
                Else
                Begin
                  pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                               strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                               strValDup, strValPag, strJurMor, '',        strCodBco,
                               strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq);

                  If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString))) Then
                  Begin
                    TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDup,
                                                             strEspDoc,
                                                             strCodEmp,
                                                             strCodCli,
                                                             strParcel,
                                                             strLoginUsuarioLogado,
                                                             fRetCgcCpf(strCodCli),
                                                             afcImportaRetornoBancario);
                  End;

                  blnExiste := True;
                End;
              End
              Else
              Begin
                pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                            StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                            fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
              End;

              {*****************************}
              {* GRAVAÇÃO DA TABELA REMGER *}
              {** DADOS GERAIS DA REMESSA **}
              {**************************MO*}

              //GRAVA SOMENTE UMA VEZ
              if (intContGeral = 0) And (strCodBco <> '') then
              begin
                pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
                Inc(intContGeral);
              end;

              {*****************************}
              {* GRAVAÇÃO DA TABELA RETDET *}
              {**** DETALHES DA RETORNO ****}
              {**************************MO*}
              pGravaRetDet(strAutoIncremRet,
                           strAutoIncremCadRec,
                           strNosNum,
                           fStrToFloat(strValPag)/100,
                           fStrtoFloat(strJurMor)/100,
                           fStrtoFloat(strDescon)/100,
                           0,
                           StrToDateDef(strDtaPag, 0),
                           strCodBcoReceb,
                           strAgeReceb,
                           dtaDtaArqRet,
                           strLoginUsuarioLogado,
                           '',
                           strCodOco,
                           blnAtualizaRet);
              blnAtualizaRet := False;
            End;// fim do while

            CloseFile(txtTexto);
          End;

          If Not cdsNaoGra.IsEmpty Then
            pMostraArqNaoBaixa('BANCOOB');

          pMostraDupNaoBaixa(lstArqNaoGravados);

          If Not blnExiste Then
          Begin
            fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
            Continue;
          End;

          strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
          If Not fRenomeiaArquivo(strNomArq) Then
          Begin
            Exit;
          End;

          Try
            RenameFile(strNomArq, strArqNov);
          Finally
            fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);
          End;

        End;// Fim do If

      End
      Else
      Begin
        If lstArquivo.Selected[intContador] Then
        Begin
          {************************}
          {* PEGA DATA DO ARQUIVO *}
          {*********************JU*}
          FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

          FRetorno := TStringList.Create;
          FRetorno.LoadFromFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

          If fEmptyStr(FRetorno.Text) Then
          Begin
            fMensagem('ATENÇÃO', 'O Arquivo ' +  lstArquivo.Items.Strings[intContador] + ' está vazio!', ['&OK']);
            FreeAndNil(FRetorno);
            Exit;
          End;

          strLinha := FRetorno[0];

          If ((Copy(strLinha, 01, 03)) <> '756') And ((Copy(strLinha, 01, 03)) <> '001') Then
          Begin
            fMensagem('', 'Não é um arquivo de retorno do Banco Bancoob ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
            FreeAndNil(FRetorno);
            Exit;
          End;
          strDtaArqRet := Copy(strLinha, 144, 8);
          strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
          If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
          Begin
            fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
            FreeAndNil(FRetorno);
            Exit;
          End
          Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

          blnLeuDta := False;

          If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], 'CONFIG756_240p-' + IntToStr(intCartei)) then
          begin
            if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                             '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
            begin
              blnAtualizaRet := True;
            end
            else
            begin
              blnAtualizaRet := False;
              FreeAndNil(FRetorno);
              Exit;
            end;
          end;

          intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
          For FLoop := 1 To FRetorno.Count - 1 Do
          Begin
            pProgresso(fInc(intLinha), intLinhas, cxgProgresso);
            strLinha := FRetorno[FLoop];

            {*****************************************}
            {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
            {**************************************JU*}
            If(FLoop = FRetorno.Count) Then
              Continue;

            {****************}
            {* SEGMENTO "T" *}
            {*************JU*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            If Copy(strLinha, 14, 1) = 'T' Then
            Begin
              {*************************************************}
              {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
              {**********************************************JU*}

              {*****************************************************}
              {* SE USA CORRESPONDENTE BB PEGA POSIÇÕES DIFERENTES *}
              {*REQ*56278****************************************MO*}
              If fGetBancoConfig(0,'CONFIG756_240p-' + IntToStr(intCartei),'USACRR_','') = 'S' Then
              Begin
                strNumCtr := Copy(strLinha,107,25);
                strTarifa := '';
                fltTarifa := 0;

                strNumDup := '';
                strParcel := '';
                strEspDoc := '';
                strCodEmp := '';
                strCodCli := '';

                {********************************************************************************************}
                {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
                {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
                {*****************************************************************************************MO*}
                if EhNumero(Copy(strNumCtr,006,02)) then
                begin
                  //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
                  If (Length(Trim(strNumCtr)) = 20) then
                  Begin
                    strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                    strParcel := Trim(Copy(strNumCtr,013,03));
                    strEspDoc := Copy(strNumCtr,016,02);
                    strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                    strCodCli := '';
                  End
                  //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
                  Else If Length(Trim(strNumCtr)) = 25 Then
                  Begin
                    strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                    strParcel := Copy(strNumCtr,013,01);
                    strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                    strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                    strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
                  End;
                End
                Else
                Begin
                  //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
                  strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                  strParcel := Copy(strNumCtr,007,01);
                  strEspDoc := Copy(strNumCtr,008,02);
                  strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
                  strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
                End;

                strDtaVen := Copy(strLinha,75,08);
                If Not fEmptyStr(strDtaVen) And (strDtaVen <> '00000000') Then
                Begin
                  System.Insert('/',strDtaVen,3);
                  System.Insert('/',strDtaVen,6);
                End;

                strValDup := Copy(strLinha,83,15);
                strCodBco := '756';
                strCodOco := Copy(strLinha,16,02);
                strNosNum := Copy(strLinha,038,20);
                strNosNum := RightStr(strNosNum, 08);
                strCodRej := '';
                strMotOco := '';

                strCodBcoReceb := Copy(strLinha,97,03);
                strAgeReceb    := Copy(strLinha,100,05);

                if fCfgSis('ENCBAN', varBoolean) then
                  fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG756_240p-' + IntToStr(intCartei), 'VALOTAR', '0'));
                if ((strCodOco = '06') and (fltTarifa > 0) and (fCfgSis('ENCBAN', varBoolean)))  then
                  strTarifa := Copy(strLinha,200,15);
              end
              else
              begin
                strNomArq := lstArquivo.Items.Strings[intContador];
                strNumCtr := Copy(strLinha,106,25);
                strTarifa := '';
                fltTarifa := 0;

                strNumDup := '';
                strParcel := '';
                strEspDoc := '';
                strCodEmp := '';
                strCodCli := '';

                {********************************************************************************************}
                {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
                {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
                {*****************************************************************************************MO*}
                if EhNumero(Copy(strNumCtr,006,02)) then
                begin
                  //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
                  If (Length(Trim(strNumCtr)) = 20) then
                  Begin
                    strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                    strParcel := Trim(Copy(strNumCtr,013,03));
                    strEspDoc := Copy(strNumCtr,016,02);
                    strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                    strCodCli := '';
                  End
                  //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
                  Else If Length(Trim(strNumCtr)) = 25 Then
                  Begin
                    strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                    strParcel := Copy(strNumCtr,013,01);
                    strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                    strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                    strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
                  End;
                End
                Else
                Begin
                  //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
                  strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                  strParcel := Copy(strNumCtr,007,01);
                  strEspDoc := Copy(strNumCtr,008,02);
                  strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
                  strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
                End;

                strDtaVen := Copy(strLinha,74,08);
                If Not fEmptyStr(strDtaVen) And (strDtaVen <> '00000000') Then
                Begin
                  System.Insert('/',strDtaVen,3);
                  System.Insert('/',strDtaVen,6);
                End;

                strValDup := Copy(strLinha,82,15);
                strCodBco := '756';
                strCodOco := Copy(strLinha,16,02);
                strNosNum := Copy(strLinha,040,08);

                strCodBcoReceb := Copy(strLinha,97,03);
                strAgeReceb    := Copy(strLinha,100,05);

                if fCfgSis('ENCBAN', varBoolean) then
                  fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG756_240p-' + IntToStr(intCartei), 'VALOTAR', '0'));

                if ((strCodOco = '06') and (fltTarifa > 0) and (fCfgSis('ENCBAN', varBoolean)))  then
                  strTarifa := Copy(strLinha,199,15);

                // Lançamentos para tarifas auxiliares da duplicata(Baixa Simples, Cartório...)
                If fCfgSis('ENCBAN', varBoolean) Then
                Begin
                  pDesmembraCarteira('CONFIG756_240p-' + IntToStr(intCartei) + '-' + VS_strCodEmp,
                                     strOcoBco, strOcoLay, strNumPos, strOcoEsp, strOcoEmp,
                                     intOcoCar);

                  objCnfDao := TCnfOcoDao.Create(strOcoBco, strOcoLay, strNumPos,
                                                 strOcoEsp, strOcoEmp, intOcoCar);

                  objCnfOco := objCnfDao.fBuscaPorOcorrencia(strCodOco);
                  If Assigned(objCnfOco) Then
                  Begin
                    If objCnfOco.blnCusCar Then
                      strCusCar := Copy(strLinha,199,15)
                    Else
                      strTarifa := Copy(strLinha,199,15);

                    strValPag := '0000000000000';

                    objCnfOco.Free;
                  End;

                  objCnfDao.Free;

                  If fltTarifa > 0 Then
                    strTarifa := Copy(strLinha,199,15);
                End;
               End;
            End;

            {****************}
            {* SEGMENTO "U" *}
            {*************JU*}
            If Copy(strLinha, 14, 1) = 'U' Then
            Begin
              strDtaOco := Copy(strLinha,138,08);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '00000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := Copy(strLinha,146,08);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '00000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;

              If fEmptyStr(strDtaPag) Or (strDtaPag = '00000000') Then
                strDtaPag := strDtaOco;

              strDtaCre := Copy(strLinha,146,08);
              If Not fEmptyStr(strDtaCre) And (strDtaCre <> '00000000') Then
              Begin
                System.Insert('/',strDtaCre,3);
                System.Insert('/',strDtaCre,6);
              End;

              strDesCon := Copy(strLinha,33,15);

              strValPag := '';
              strValLan := '';
              strTxaDes := '';
              strIofDes := '';
              fltTarifa := 0;
              blnDescon := False;

              If fGetBancoConfig(0,'CONFIG756_240p-' + IntToStr(intCartei),'USACRR_','') = 'S' Then
              Begin
                if fCfgSis('ENCBAN', varBoolean) then
                  fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG756_240p-' + IntToStr(intCartei), 'VALOTAR', '0'));

                if ((strCodOco = '06') and (fltTarifa > 0) and (fCfgSis('ENCBAN', varBoolean)))  then
                begin
                  strValLan := Copy(strLinha,63,15);
                  strValPag := FloatToStr(fStrToFloat(strValLan) - fStrToFloat(strTarifa));
                end
                else
                begin
                  strValPag := Copy(strLinha,63,15);
                  strValLan := '';
                end;
              End
              Else
              Begin
                if fCfgSis('ENCBAN', varBoolean) then
                  fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG756_240p-' + IntToStr(intCartei), 'VALOTAR', '0'));

                if ((strCodOco = '06') and (fltTarifa > 0) and (fCfgSis('ENCBAN', varBoolean)))  then
                begin
                  strValLan := Copy(strLinha,78,15);
                  strValPag := FloatToStr(fStrToFloat(strValLan) - fStrToFloat(strTarifa));
                end
                else
                begin
                  strValPag := Copy(strLinha,78,15);
                  strValLan := '';
                end;
              End;

              If fGetBancoConfig(0,'CONFIG756_240p-' + IntToStr(intCartei),'UTLDESDUP','') = 'S' Then
              Begin
                // desconto de duplicata, lança movban sem baixar o titulo
                blnDescon := (strCodOco = '48');
                If blnDescon Then
                  strValLan := strValDup;

              End Else
              If fTransferenciadeCarteira Then
              Begin
                {***********************************************}
                {* SE FOR TRANSF. DE CARTEIRA NÃO BAIXA CADREC *}
                {* REQ 146293 *******************************JS*}
                strValPag := '';
                strValLan := '';
              End;

              strJurMor := Copy(strLinha,18,15);

              blnLeuDta := True;
            End;

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************JU*}
            //strCodBco_Posicoes := strCodBco + '_240';
            If blnLeuDta Then
            Begin
              If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco,
                                       strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec,
                                       'CONFIG756_240p-' + IntToStr(intCartei)) Then
              Begin

                If Not blnExiste Then
                  pDeletaArqBco;

                // estorno de duplicata descontada para cobrança simples
                If TransferenciaParaCobrancaSimples Then
                Begin
                  strTxaDes := strJurMor;
                  strIofDes := Copy(strLinha,63,15);
                  strJurMor := '';
                  strValPag := FloatToStr(fStrToFloat(strValPag) - (fStrToFloat(strTxaDes) + fStrToFloat(strIofDes)));
                  blnDescon := True;
                End;


                If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
                Begin
                  lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                        strEspDoc + '-' +
                                                        strCodEmp +
                                                        ' Cliente: ' + strCodCli +
                                                        ' Nosso Número: ' + strNosNum);
                End
                Else If intQtdDup > 1 Then
                Begin
                  lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                        strEspDoc + '-' +
                                                        strCodEmp +
                                                        ' Cliente: ' + strCodCli +
                                                        ' Nosso Número: ' + strNosNum);
                End
                Else
                Begin

                  pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                               strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                               strValDup, strValPag, strJurMor, '',        strCodBco,
                               strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                               False,     '',        '',        strDtaCre, strTarifa,
                               strValLan, strCusCar,'',strIofDes,strTxaDes,blnDescon);

                  pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                  If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString))) Then
                  Begin
                    TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDup,
                                                             strEspDoc,
                                                             strCodEmp,
                                                             strCodCli,
                                                             strParcel,
                                                             strLoginUsuarioLogado,
                                                             fRetCgcCpf(strCodCli),
                                                             afcImportaRetornoBancario);
                  End;

                  blnExiste := True;
                End;
              End
              Else
              Begin
                pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                            StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                            fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
              End;

              blnLeuDta := False;

              {*****************************}
              {* GRAVAÇÃO DA TABELA REMGER *}
              {** DADOS GERAIS DA REMESSA **}
              {**************************MO*}

              //GRAVA SOMENTE UMA VEZ
              if (intContGeral = 0) And (strCodBco <> '') then
              begin
                pGravaRetGer(VS_strCodEmp, strCodBco, 'CONFIG756_240p-' + IntToStr(intCartei) + '-' + VS_strCodEmp, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
                Inc(intContGeral);
              end;

              {*****************************}
              {* GRAVAÇÃO DA TABELA RETDET *}
              {**** DETALHES DA RETORNO ****}
              {**************************MO*}
              pGravaRetDet(strAutoIncremRet,
                           strAutoIncremCadRec,
                           strNosNum,
                           fStrToFloat(strValPag)/100,
                           fStrtoFloat(strJurMor)/100,
                           fStrtoFloat(strDescon)/100,
                           fStrtoFloat(strTarifa)/100,
                           StrToDateDef(strDtaPag, 0),
                           strCodBcoReceb,
                           strAgeReceb,
                           dtaDtaArqRet,
                           strLoginUsuarioLogado,
                           '',
                           strCodOco,
                           blnAtualizaRet);
              blnAtualizaRet := False;

            End;

          End;// fim do while

          If Assigned(FRetorno) Then FreeAndNil(FRetorno)
          Else CloseFile(txtTexto);

          If Not cdsNaoGra.IsEmpty Then
            pMostraArqNaoBaixa('BANCOOB');

          pMostraDupNaoBaixa(lstArqNaoGravados);

          If Not blnExiste Then
          Begin
            fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
            Continue;
          End;

          strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
          If Not fRenomeiaArquivo(strNomArq) Then
          Begin
            Exit;
          End;

          fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

        End;// Fim do If

      End;

    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoBtgPactual(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    blnLeuDta: Boolean;
    strLinha : String;
    strParcel: String;
    strValLan: String;
    strTarifa: String;
    fltTarifa: Double;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strArqNov: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;

    objCnfOco: TCnfOco;
    objCnfDao: TCnfOcoDao;
    strOcoBco: String;
    strOcoLay: String;
    strNumPos: String;
    strOcoEsp: String;
    strOcoEmp: String;
    intOcoCar: Integer;
    strCusCar: String;
    strDtaCre: String;
    FLoop : Integer;
    FRetorno : TStringList;
    blnDescon: Boolean;
    strTxaDes: String;
    strIofDes: String;

begin
  strCodBco    := '208';
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  blnDescon := false;
  strCartei := 'CONFIG208-' + IntToStr(intCartei) + '-' + VS_strCodEmp;
  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin
        If lstArquivo.Selected[intContador] Then
        Begin
          {************************}
          {* PEGA DATA DO ARQUIVO *}
          {************************}
          FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

          FRetorno := TStringList.Create;
          FRetorno.LoadFromFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

          strLinha := FRetorno[0];

          If ( Copy(strLinha, 01, 03) <> '208' ) Then
          Begin
            fMensagem('', 'Não é um arquivo de retorno do Banco Btg Pactual ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
            FreeAndNil(FRetorno);
            Exit;
          End;

          strDtaArqRet := Copy(strLinha, 144, 8);
          strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
          If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
          Begin
            fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
            FreeAndNil(FRetorno);
            Exit;
          End
          Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

          blnLeuDta := False;

          If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], 'CONFIG208-' + IntToStr(intCartei)) then
          begin
            if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                             '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
            begin
              blnAtualizaRet := True;
            end
            else
            begin
              blnAtualizaRet := False;
              FreeAndNil(FRetorno);
              Exit;
            end;
          end;

          For FLoop := 1 To FRetorno.Count - 1 Do
          Begin
            strLinha := FRetorno[FLoop];

            {*****************************************}
            {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
            {*****************************************}
            If (FLoop = FRetorno.Count) Then
               Continue;

            {****************}
            {* SEGMENTO "T" *}
            {*************JU*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            If Copy(strLinha, 14, 1) = 'T' Then
            Begin

              {*************************************************}
              {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
              {*************************************************}
              strNomArq := lstArquivo.Items.Strings[intContador];
              strNumCtr := Copy(strLinha,106,25);

              strTarifa := '';
              strNumDup := '';
              strParcel := '';
              strEspDoc := '';
              strCodEmp := '';
              strCodCli := '';

              {********************************************************************************************}
              {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
              {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
              {********************************************************************************************}
              If EhNumero(Copy(strNumCtr,006,02)) then
              begin
                // Duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
                If (Length(Trim(strNumCtr)) = 20) then
                Begin
                  strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                  strParcel := Trim(Copy(strNumCtr,013,03));
                  strEspDoc := Copy(strNumCtr,016,02);
                  strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                  strCodCli := '';
                End
                //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
                Else If Length(Trim(strNumCtr)) = 25 Then
                Begin
                  strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                  strParcel := Copy(strNumCtr,013,01);
                  strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                  strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                  strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
                End;
              End
              Else
              Begin
                //Duplicata com 6 digitos / parcela com uma letra / com cod. cliente
                strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                strParcel := Copy(strNumCtr,007,01);
                strEspDoc := Copy(strNumCtr,008,02);
                strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
              End;

              strDtaVen := Copy(strLinha,74,08);
              If Not fEmptyStr(strDtaVen) And (strDtaVen <> '00000000') Then
              Begin
                System.Insert('/',strDtaVen,3);
                System.Insert('/',strDtaVen,6);
              End;

              strValDup := Copy(strLinha,82,15);
              strCodBco := '208';
              strCodOco := Copy(strLinha,16,02);
              strNosNum := Copy(strLinha,038,20);

              strCodBcoReceb := Copy(strLinha,97,03);
              strAgeReceb    := Copy(strLinha,100,05);

            End;

            {****************}
            {* SEGMENTO "U" *}
            {****************}
            If Copy(strLinha, 14, 1) = 'U' Then
            Begin
              strDtaOco := Copy(strLinha,138,08);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '00000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := Copy(strLinha,146,08);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '00000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;

              If fEmptyStr(strDtaPag) Or (strDtaPag = '00000000') Then
                 strDtaPag := strDtaOco;

              strDtaCre := Copy(strLinha,146,08);
              If Not fEmptyStr(strDtaCre) And (strDtaCre <> '00000000') Then
              Begin
                System.Insert('/',strDtaCre,3);
                System.Insert('/',strDtaCre,6);
              End;

              strDesCon := Copy(strLinha,33,15);

              strValPag := '';
              strValLan := '';
              strTxaDes := '';
              strIofDes := '';

              blnDescon := False;

              strValPag := Copy(strLinha,78,15);
              strValLan := '';

              strJurMor := Copy(strLinha,18,15);

              blnLeuDta := True;
            End;

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {********************************************}
            If blnLeuDta Then
            Begin
              If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
              Begin

                If Not blnExiste Then
                   pDeletaArqBco;

                If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
                Begin
                  lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                        strEspDoc + '-' +
                                                        strCodEmp +
                                                        ' Cliente: ' + strCodCli +
                                                        ' Nosso Número: ' + strNosNum);
                End
                Else If intQtdDup > 1 Then
                Begin
                  lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                        strEspDoc + '-' +
                                                        strCodEmp +
                                                        ' Cliente: ' + strCodCli +
                                                        ' Nosso Número: ' + strNosNum);
                End
                Else
                Begin

                  pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                               strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                               strValDup, strValPag, strJurMor, '',        strCodBco,
                               strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                               False,     '',        '',        strDtaCre, strTarifa,
                               strValLan, strCusCar,'',strIofDes,strTxaDes,blnDescon);

                  If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString))) Then
                  Begin
                    TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDup,
                                                             strEspDoc,
                                                             strCodEmp,
                                                             strCodCli,
                                                             strParcel,
                                                             strLoginUsuarioLogado,
                                                             fRetCgcCpf(strCodCli),
                                                             afcImportaRetornoBancario);
                  End;

                  blnExiste := True;
                End;
              End
              Else
              Begin
                pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                            StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                            fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
              End;

              blnLeuDta := False;

              {*****************************}
              {* GRAVAÇÃO DA TABELA RETGER *}
              {** DADOS GERAIS DO RETORNO **}
              {*****************************}

              //GRAVA SOMENTE UMA VEZ
              if (intContGeral = 0) And (strCodBco <> '') then
              begin
                pGravaRetGer(VS_strCodEmp, strCodBco, 'CONFIG208-' + IntToStr(intCartei) + '-' + VS_strCodEmp, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
                Inc(intContGeral);
              end;

              {*****************************}
              {* GRAVAÇÃO DA TABELA RETDET *}
              {**** DETALHES DA RETORNO ****}
              {*****************************}
              pGravaRetDet(strAutoIncremRet,
                           strAutoIncremCadRec,
                           strNosNum,
                           fStrToFloat(strValPag)/100,
                           fStrtoFloat(strJurMor)/100,
                           fStrtoFloat(strDescon)/100,
                           fStrtoFloat(strTarifa)/100,
                           StrToDateDef(strDtaPag, 0),
                           strCodBcoReceb,
                           strAgeReceb,
                           dtaDtaArqRet,
                           strLoginUsuarioLogado,
                           '',
                           strCodOco,
                           blnAtualizaRet);
              blnAtualizaRet := False;

            End;

          End;// fim do while

          If Assigned(FRetorno) Then FreeAndNil(FRetorno)
          Else CloseFile(txtTexto);

          If Not cdsNaoGra.IsEmpty Then
             pMostraArqNaoBaixa('BTG PACTUAL');

          pMostraDupNaoBaixa(lstArqNaoGravados);

          If Not blnExiste Then
          Begin
            fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
            Continue;
          End;

          strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
          If Not fRenomeiaArquivo(strNomArq) Then
          Begin
            Exit;
          End;

          fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

        End;// Fim do If

    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoBancoRendimento(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    blnLeuDta: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strArqNov: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;
    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG633-' + IntToStr(intCartei) + '-' + VS_strCodEmp;
  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin
      If lstArquivo.Selected[intContador] Then
      Begin
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas, cxgProgresso);

          If ((Copy(strLinha, 077, 03)) <> '633') Then
          Begin
            fMensagem('', 'Não é um arquivo de retorno do Banco Rendimento ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
            CloseFile(txtTexto);
            Exit;
          End;
          strDtaArqRet := Copy(strLinha, 095, 6);
          strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
          If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
          Begin
            fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
            CloseFile(txtTexto);
            Exit;
          End
          Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

          blnLeuDta := False;

          If Copy(strLinha, 1, 1) = '1' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************JU*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strNumCtr := Trim(Copy(strLinha,038,25));

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            End
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := Copy(strNumCtr, 001, 06);
              strParcel := Copy(strNumCtr, 007, 01);
              strEspDoc := Copy(strNumCtr, 008, 02);
              strCodEmp := Copy(strNumCtr, 010, 03);
              strCodCli := Copy(strNumCtr, 013, 08);
            End;

            strValDup := Copy(strLinha,153,13);
            strValPag := Copy(strLinha,254,13);
            strCodBco := '633';
            strCodOco :=  Copy(strLinha,109,02);
            strNosNum :=  Trim(Copy(strLinha,095,13));
            strCodRej := '';
            strMotOco := '';

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaPag := strDtaOco;
            strDtaVen := strDtaOco;

            blnLeuDta := True;

          End;

          strCodBco      := '663';
          strCodBcoReceb := Copy(strLinha,166,03);
          strAgeReceb    := Copy(strLinha,169,05);

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************JU*}
          If blnLeuDta Then
          Begin
            If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                             strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                             strValDup, strValPag, strJurMor, '',        strCodBco,
                             strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArqRet,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('BANCO RENDIMENTO');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        strArqNov := AnsiReplaceStr(strNomArq, '.RET', '.OLD');

        Try
          RenameFile(strNomArq, strArqNov);
        Finally
          fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);
        End;

        pGravaNossoNumeroBancoAmazonia;

      End;// Fim do If

    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoBancoJpiFidc(cxgProgresso: TcxProgressBar): Boolean;
Var
  txtTexto    : TextFile;
  intContador : Integer;
  blnExiste: Boolean;
  strVerNomArq: String;
  strLinha : String;
  strParcel: String;
  strNumCtr: String;
  strDtaOco: String;
  strDtaVen: String;
  strDtaPag: String;
  strNumDup: String;
  strCodCli: String;
  strCodEmp: String;
  strEspDoc: String;
  strNomArq: String;
  strCodBco: String;
  strDesCon: String;
  strCodOco: String;
  strValDup: String;
  strValPag: String;
  strJurMor: String;
  strNosNum: String;
  strCodRej: String;
  strMotOco: String;
  strCodMot: String;
  intAplica: Integer;
  dtaDtaArq: TDateTime;
  intQtdDup: Integer;
  strDtaArqRet: String;
  dtaDtaArqRet: TDateTime;

  strNumDupVel: String;
  strParcelVel: String;
  strEspDocVel: String;
  strCodEmpVel: String;
  strCodCliVel: String;

  strAutoIncremRet: String;
  strCodBcoReceb: String;
  strAgeReceb: String;
  strCusCar: String;
  strUtilizaDtaCre,
  strDtaCre: String;
  strCarBco: String;

  intContGeral: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Caption := 'Importando Arquivo de Retorno...';
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG906-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  strUtilizaDtaCre := fArqIniAutBan(0,'CONFIG906-' + IntToStr(intCartei),'DTACRED', 'N');
  Try
    For   intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);
        If ((Copy(strLinha, 077, 03)) <> '237') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco FIDC ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        intAplica := 0;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        While Not Eof(txtTexto) Do
        Begin

          Readln(txtTexto,strLinha);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;

          If Copy(strLinha, 1, 1) = '1' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strVerNomArq := UpperCase(LeftStr(strNomArq,2));
            strNumCtr := Copy(strLinha,038,25);

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            end
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := Trim(Copy(strNumCtr,001,06));
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
              strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strValPag := Copy(strLinha,254,13);

            strDtaPag := fStrZero('0',6);
            If (fStrToFloat(strValPag)/100) > 0 Then
            Begin
              strDtaPag := Copy(strLinha,111,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            strDtaCre := Copy(strLinha, 296,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;

            if strUtilizaDtaCre = 'N' Then
              strDtaCre := '';

            strValDup := Copy(strLinha,153,13);

            strCodBco := '906'; //Copy(strLinha,166,03);
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Copy(strLinha,071,12);
            strCodRej := '';
            strCodMot := Copy(strLinha,319,10);
            strMotOco := '';

            if strCodOco = '28' then
              strCusCar := Copy(strLinha,189,13) //Custos de cartório
            else
              strCusCar := '';

            //Altera data de ocorrência no cado de Ocorrência  = 15
            If (strCodOco = '15') and (strUtilizaDtaCre = 'N') Then
            Begin
              strDtaOco := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            {********************************************}
            {* VERIFICA O FORMATO NOVO E VELHO DO AUTCOM*}
            {* OBS: FOI FEITO USANDO O LAYOUT DA GUAÇU  *}
            {***xx/xx/xxxx****************************MV*}
            If (fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If (strCodOco = '03') Then
                pGravaRetMot(strCodBco, strNumDup, strParcel, strEspDoc, strCodCli,
                             strCodEmp, strCodMot, strCodOco);

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False,     '',        '',        strDtaCre,        '',
                           '',        strCusCar, strCarBco);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                           strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                           strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                           strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq,
                           False,        '',           '',           strDtaCre,           '',
                           '',           strCusCar);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            inc( intAplica );

            If ( intAplica Mod 10 ) = 0 Then
              Application.ProcessMessages;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('BRADESCO');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          pnlInfo.Caption := '';
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  pnlInfo.Caption := '';
  frmRetBco.Close;
end;

function TfrmRetBco.fGeraRetornoBancoSRM(cxgProgresso: TcxProgressBar): Boolean;
