                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If (((fStrtoFloat(strValPag)) >= (fStrtoFloat(strValDup))) And (fStrtoFloat(strDesCon) > 0)) Then
              Begin
                stlNaoBai.Add('Duplicata: ' + strNumDupVel + '-' +
                                              strEspDocVel + '-' +
                                              strCodEmpVel +
                                              ' Cliente: ' + strCodCliVel +
                                              ' Nosso Número: ' + strNosNum);

                stlNaoBai.Add('--Valor Duplicata: ' + FormatFloat('#,##0.00', fStrtoFloat(strValDup) / 100) +
                              ' Valor Pago: ' + FormatFloat('#,##0.00', fStrtoFloat(strValPag) / 100) +
                              IIF(StrtoFloat(strDescon) > 0, ' Desconto: ' + FormatFloat('#,##0.00', fStrtoFloat(strDescon) / 100), ''));

              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
