                '29 - N'#195'O RECEBER AP'#211'S 55 DIAS DO VENCIMENTO E'
                '30 - IMPORT'#194'NCIA DE DESCONTO POR DIA'
                '31 - N'#195'O RECEBER AP'#211'S 60 DIAS DO VENCIMENTO'
                '32 - N'#195'O RECEBER AP'#211'S 90 DIAS DO VENCIMENTO'
                
                  '33 - CONCEDER ABATIMENTO REF. '#192' PIS-PASEP/COFIN/CSSL, MESMO AP'#211'S' +
                  ' VENCIMENTO'
                '34 - PROTESTAR AP'#211'S XX DIAS CORRIDOS DO VENCIMENTO'
                '35 - PROTESTAR AP'#211'S XX DIAS '#218'TEIS DO VENCIMENTO'
                '37 - RECEBER AT'#201' O '#218'LTIMO DIA DO M'#202'S DE VENCIMENTO'
                '38 - CONCEDER DESCONTO MESMO AP'#211'S VENCIMENTO'
                '39 - N'#195'O RECEBER AP'#211'S O VENCIMENTO'
                '40 - CONCEDER DESCONTO CONFORME NOTA DE CR'#201'DITO A'
                '42 - PROTESTO PARA FINS FALIMENTARES'
                '43 - SUJEITO A PROTESTO SE N'#195'O FOR PAGO NO VENCIMENTO F'
                '44 - IMPORT'#194'NCIA POR DIA DE ATRASO A PARTIR DE DDMMAA'
                '45 - TEM DIA DA GRA'#199'A'
                '47 - DISPENSAR JUROS/COMISS'#195'O DE PERMAN'#202'NCIA'
                '51 - RECEBER SOMENTE COM A PARCELA ANTERIOR QUITADA'
                
                  '52 - EFETUAR O PAGAMENTO SOMENTE ATRAV'#201'S DESTE BOLETO E NA REDE ' +
                  'BANC'#193'RIA'
                '54 - AP'#211'S VENCIMENTO PAG'#193'VEL SOMENTE NA EMPRESA'
                
                  '57 - SOMAR VALOR DO T'#205'TULO AO VALOR DO CAMPO MORA/MULTA CASO EXI' +
                  'STA'
                '58 - DEVOLVER AP'#211'S 365 DIAS DE VENCIDO'
                
                  '59 - COBRAN'#199'A NEGOCIADA. PAG'#193'VEL SOMENTE POR ESTE BOLETO NA REDE' +
                  ' BANC'#193'RIA'
                '61 - T'#205'TULO ENTREGUE EM PENHOR EM FAVOR DO CEDENTE ACIMA'
                '62 - T'#205'TULO TRANSFERIDO A FAVOR DO CEDENTE'
                
                  '66 - ENTRADA EM NEGATIVA'#199#195'O EXPRESSA (IMPRIME: SUJEITO A NEGATIV' +
                  'A'#199#195'O AP'#211'S O VENCIMENTO)'
                '67 - N'#195'O NEGATIVAR (INIBE A ENTRADA EM NEGATIVA'#199#195'O EXPRESSA)'
                '78 - VALOR DA IDA ENGLOBA MULTA DE 10% PRO RATA'
                
                  '79 - COBRAR JUROS AP'#211'S 15 DIAS DA EMISS'#195'O (para t'#237'tulos com venc' +
                  'imento '#224' vista)'
                
                  '80 - PAGAMENTO EM CHEQUE: SOMENTE RECEBER COM CHEQUE DE EMISS'#195'O ' +
                  'DO SACADO'
                '81 - PROTESTAR AP'#211'S XX DIAS CORRIDOS DO VENCIMENTO'
                '82 - PROTESTAR AP'#211'S XX DIAS '#218'TEIS DO VENCIMENTO'
                '83 - OPERA'#199#195'O REF A VENDOR'
                '84 - AP'#211'S VENCIMENTO CONSULTAR A AG'#202'NCIA CEDENTE'
                
                  '86 - ANTES DO VENCIMENTO OU AP'#211'S 15 DIAS, PAG'#193'VEL SOMENTE EM NOS' +
                  'SA SEDE'
                '88 - N'#195'O RECEBER ANTES DO VENCIMENTO'
                '90 - NO VENCIMENTO PAG'#193'VEL EM QUALQUER AG'#202'NCIA BANC'#193'RIA'
                '91 - N'#195'O RECEBER AP'#211'S XX DIAS DO VENCIMENTO A'
                '92 - DEVOLVER AP'#211'S XX DIAS DO VENCIMENTO'
                '93 - MENSAGENS NOS BOLETOS COM 30 POSI'#199#213'ES'
                '94 - MENSAGENS NOS BOLETOS COM 40 POSI'#199#213'ES'
                '98 - DUPLICATA / FATURA N'#186)
              NormalColor = clWindow
              FocusColor = clInfoBk
              RequeridoColor = clRed
              Requerido = False
            end
