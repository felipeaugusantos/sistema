Function fGetTotalCreditosCliente(strCodCli: String): Double;

  Function fGetSqlAberto: String;
  Begin
    Result := '';
    Result := Result + ' SELECT ';
    Result := Result + '   IFNULL(SUM(CTR_VALDUP),0) AS SOMA ';
    Result := Result + ' FROM CADREC ';
    Result := Result + ' WHERE ';
    Result := Result + '   CTR_DTAREC IS NULL AND ';
    Result := Result + '   CTR_VALDUP < 0     AND ';
    Result := Result + '   CTR_CODCLI = :CODCLI ';

    If Not fEmptyStr(fCfgSis('POOCRE', varString)) Then
      Result := Result + ' AND CTR_CODPOR <> '+QuotedStr(fCfgSis('POOCRE', varString))+' ';
  End;

  Var
    qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Nil);
  qryAux.SQL.Add(fGetSqlAberto);
  qryAux.ParamByName('CODCLI').AsString := strCodCli;
  qryAux.Open;
  Result := Abs(qryAux.FieldByName('SOMA').AsFloat);
  qryAux.Close;
  FreeANdNil(qryAux);
End;

