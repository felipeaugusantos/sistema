function fVerificaItemRecebeDevolucao(strNumDoc, strEspDoc, strCodEmp: String): String;
  function fSQL(strTabGer, strTabDet: String): String;
  begin
    Result := '';
    Result := Result + ' SELECT                                               ';
    Result := Result + '   I.ITE_CODITE,                                      ';
    Result := Result + '   D.DET_DESCRI,                                      ';
    Result := Result + '   IFNULL(G.ITE_RECDEV, "S") AS ITE_RECDEV            ';
    Result := Result + ' FROM '+strTabGer+' M                                 ';
    Result := Result + '   INNER JOIN '+strTabDet+' D ON M.AUTOINCREM = D.DET_SEQGER';
    Result := Result + '   INNER JOIN CADITE I ON I.ITE_CODITE = D.DET_CODITE ';
    Result := Result + '   LEFT  JOIN ITEGER G ON G.ITE_CODITE = D.DET_CODITE ';
    Result := Result + '                      AND G.ITE_CODEMP = D.DET_CODEMP ';
    Result := Result + ' WHERE D.DET_NUMDOC = :NUMDOC                         ';
    Result := Result + '   AND D.DET_ESPDOC = :ESPDOC                         ';
    Result := Result + '   AND D.DET_CODEMP = :CODEMP                         ';
  end;
var
  qryRecDev : TUniQuery;
  strSQL    : String;
  strItens  : String;
begin
  Result := '';
  strItens := #13;
  
  If fEmptyStr(strCodemp) Then
    strCodEmp := VS_strCodEmp;

  Try
    qryRecDev := fCriaQuery;
    Try
      strSQL := '';
      strSQL := strSQL + fSQL('MOVGER','MOVDET');
      strSQL := strSQL + ' UNION ALL ';
      strSQL := strSQL + fSQL('NOTGER','NOTDET');

      With qryRecDev Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODEMP').AsString := strCodEmp;
        Open;

        If Not (IsEmpty) Then
        Begin
          First;
          While Not Eof Do
          Begin
            If (FieldByName('ITE_RECDEV').AsString = 'N') Then
            Begin
              strItens := strItens + FieldByName('ITE_CODITE').AsString + ' - ' +
                                     FieldByName('DET_DESCRI').AsString + #13#10;
            End;

            Next;
          End;
        End;

        Close;
      End;

     Result := strItens;

    Except
      On E : Exception Do
		    pMensagensErro(E.Message, '[fVerificaItemRecebeDevolucao]');
	  End;
  Finally
    FreeAndNil(qryRecDev);
  End;
end;

function fLocFisUtilizada(strLocFis, strCodIte: String): String;
  Var qryIteGer : TUniQuery;
      strSQL : String;
begin
  Result := EmptyStr;
  Try

    qryIteGer := fCriaQuery(nil);

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  CONCAT(I.ITE_CODITE," - ",P.ITE_DESITE) AS DESITE ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  ITEGER I INNER JOIN CADITE P ON I.ITE_CODITE = P.ITE_CODITE ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  I.ITE_CODEMP  = :CODEMP AND ';
    strSQL := strSQL + '  I.ITE_LOCFIS  = :LOCFIS AND ';
    strSQL := strSQL + '  I.ITE_CODITE <> :CODITE ';

    With qryIteGer Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('LOCFIS').AsString := strLocFis;
      ParamByName('CODITE').AsString := strCodIte;
      Open;

      If Not (IsEmpty) Then
      Begin
        Result := FieldByName('DESITE').AsString;
      End;

      Close;
    End;

  Finally
    FreeAndNil(qryIteGer);
  End;

end;




