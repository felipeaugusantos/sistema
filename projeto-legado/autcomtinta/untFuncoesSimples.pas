    Begin
      SetLength(arrAdd, Length(arrAdd) + 1);

      arrAdd[High(arrAdd)] := LeftStr(strTexto, Pos(#13#10, strTexto) -1);
      strTexto := Copy(strTexto, Pos(#13#10, strTexto) + 2, Length(strTexto));

      If Pos(#13#10, strTexto) <= 0 Then
