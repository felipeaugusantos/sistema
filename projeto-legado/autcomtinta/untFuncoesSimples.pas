    while not qryCliVen.Eof do
    begin
      pIncrementaListaStr(qryCliVen.FieldByName('CVE_CODVEN').AsString, Result, True);
      qryCliVen.Next;
    end;
  finally
    FreeAndNil(qryCliVen);
  end;
end;

