function fEnquadramentoIPIExiste(strCodEnq : String; strGrupoCST : String = '*'): Boolean;
  Var
    qryAux: TUniQuery;
begin
  Try
    qryAux := fCriaQuery;

    With qryAux Do
    Begin
      SQL.Add('SELECT ');
      SQL.Add('  EQI_CODIGO ');
      SQL.Add('FROM ');
      SQL.Add('  ENQIPI ');
      SQL.Add('WHERE ');
      SQL.Add('  EQI_CODIGO = :CODENQ ');

      If (strGrupoCST = '*') Then
        SQL.Add('  AND EQI_GRUCST IN ('+QuotedStr('Isenção')+', '+QuotedStr('Imunidade')+', '+QuotedStr('Suspensão'));
      If (strGrupoCST = 'I') Then
        SQL.Add('  AND EQI_GRUCST = ' + QuotedStr('Isenção'));
      If (strGrupoCST = 'M') Then
        SQL.Add('  AND EQI_GRUCST = ' + QuotedStr('Imunidade'));
      If (strGrupoCST = 'S') Then
        SQL.Add('  AND EQI_GRUCST = ' + QuotedStr('Suspensão'));

      ParamByName('CODENQ').AsString := strCodEnq;
      Open;

      If Not IsEmpty Then
        Result := True
      Else
        Result := False;

      Close;
    End;
  Finally
    FreeAndNil(qryAux);
