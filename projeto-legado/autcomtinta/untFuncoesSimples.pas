  Try

    qryFis := fCriaQuery(Nil);

    strSQL := '';
    strSQL := strSQL + 'SELECT        ';
    strSQL := strSQL + '  FIS_NUMDOC, ';
    strSQL := strSQL + '  FIS_ESPDOC, ';
    strSQL := strSQL + '  FIS_CODEMP  ';
