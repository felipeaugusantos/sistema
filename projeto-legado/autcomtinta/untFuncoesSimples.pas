function fVerifCotacao(dtaData: TDateTime): Boolean;
Var
  qryGen : TUniQuery;
Begin
  Try
    qryGen := fCriaQuery;

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT * FROM CADMOE WHERE MOE_DTAMOE = :DTAMOE');
      ParamByName('DTAMOE').AsDateTime := dtaData;
      Open;

      If IsEmpty Then
        Result := False
      Else
        Result := True;
    End;

  Finally
    FreeAndNil(qryGen);
  End;

End;

Function fInsereCotacaoDoDia: Boolean;
  Var
    strSQL: String;
    qryGen   : TUniQuery;
Begin

  strSQL := '';
  strSQL := strSQL + ' INSERT INTO CADMOE ';
  strSQL := strSQL + '   (SELECT          ';
  strSQL := strSQL + '     :DTAMOE,       ';
