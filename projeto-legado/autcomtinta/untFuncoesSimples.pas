{*************************************}
{* UTILIZADO PARA SELECIONAR O BANCO *}
{* E A CARTEIRA DE IMPRESSÃO         *}
{**********************************AF*}
function fVer_Banco_Carteira(strCodBan, strCarteira: String;
                             Var strBanRet: String;
                             Var intCarRet: Integer;
                             blnVeioImpBol: Boolean = True): Boolean;
  Var
    intContador: Integer;
    arrBancos  : TArrBancos;
    arrBanCar  : TStringArray;
Begin
 	Result := True;

  If Not fEmptyStr(strCarteira) And (Length(strCarteira) > 1) Then
  Begin
    strBanRet := Copy(strCarteira, 7 , Pos('-', RightStr(strCarteira, Length(strCarteira) - 6))-1 );
    intCarRet := StrToIntDef(Copy(strCarteira, 8 + Length(strBanRet) , Pos('-', RightStr(strCarteira, Length(strCarteira) - 7 - Length(strBanRet)))-1 ),0);
    Exit;
  End;

  pCarregaArrayBancoCarteira(strCodBan, arrBancos, arrBanCar, blnVeioImpBol, strCarteira);

  If (strCodBan <> '778') Then
  Begin

    {*******************************************}
    {* CASO NÃO TENHA NENHUMA CARTEIRA CONFI-  *}
    {* GURADA, SETA A PRIMEIRA CARTEIRA COMO   *}
    {* DEFAULT                                 *}
    {****************************************MV*}
    If (Length(arrBanCar) <= 0) Then
    Begin
      Result := False;
      fMensagem('ATENÇÃO!', 'Para efetuar impressão de boletos é necessário configurar' + #13#10 +
                            'a carteira correspondente ao banco desejado!', ['&Ok']);
      Exit;
    End;

    {********************************************}
    {* SE VIER DO FATURAMENTO É FIXO 1          *}
    {* PS: PEDI ALTERAÇÃO PARA SER CONFIGURAVEL *}
    {*2015-04-17******************************AF*}
    intContador := 1;
    If (Length(arrBanCar) > 1) {And (blnVeioImpBol)} Then
    Begin
      intContador := fGetMenu('Selecione o Banco e Carteira', arrBanCar, 0, True);

      If intContador = -1 Then
      Begin
        intCarRet := 0;
        strBanRet := '';
        Result := False;
        Exit;
      End;

    End;

    intCarRet := arrBancos[intContador-1].intCodCar;
    strBanRet := arrBancos[intContador-1].strCodBan;
  End
  Else
  Begin
    If Length(arrBancos) > 0 Then
    Begin
      intCarRet := arrBancos[High(arrBancos)].intCodCar;
      strBanRet := arrBancos[High(arrBancos)].strCodBan;
    End;
  End;

End;

{*********************************}
{* FORMATA CONDICAO DE PAGAMENTO *}
{******************************AF*}
function fFormataCondPag(strCond: String): String;
  Var
    strValor   : String;
    intContador: Integer;
Begin
  intContador := 3;
  strValor := '(';
  strValor := strValor + LeftStr(strCond,2);
  strValor := strValor + ')';

  While intContador < Length(strCond) Do
  Begin
    If intContador > 3 Then
      strValor := strValor + '.';

    strValor := strValor + Copy(strCond,intContador,3);
    inc(intContador,3)
  End;

  {*******************************************}
  {* CASO RETORNE CONDIÇÃO VAZIA, RETORNA    *}
  {* STRING VAZIA                            *}
  {****************************************AF*}
  If (strValor = '()') Then
    strValor := '';

  Result := strValor;
End;

function fFormataCondPagBarra(strCond: String): String;
  Var
    strValor   : String;
    intContador: Integer;
Begin
  intContador := 3;
  strValor := '';
  strValor := strValor + LeftStr(strCond,2);
  strValor := strValor + '/';

  While intContador < Length(strCond) Do
  Begin
    If intContador > 3 Then
      strValor := strValor + '/';

    strValor := strValor + Copy(strCond,intContador,3);
    inc(intContador,3)
  End;

  {*******************************************}
  {* CASO RETORNE CONDIÇÃO VAZIA, RETORNA    *}
  {* STRING VAZIA                            *}
  {****************************************AF*}
  If (strValor = '/') Then
    strValor := '';

  Result := strValor;
End;

function fFormataCondPagEsp(strCond: String; strSeparador: String): String;
  Var
    strValor   : String;
    intContador: Integer;
Begin
  intContador := 3;
  strValor := '';

  If Pos(Copy(strCond, 3, 1), '0123456789') > 0 Then
  Begin

    While intContador < Length(strCond) Do
    Begin
      If intContador > 3 Then
        strValor := strValor + strSeparador;

      strValor := strValor + Copy(strCond,intContador,3);
      inc(intContador,3)
    End;

    If (strValor = strSeparador) Then
      strValor := '';

  End
  Else strValor := UpperCase(Copy(strCond, 3, Length(strCond)-2));

  Result := strValor;
End;

