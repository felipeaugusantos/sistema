function fRetSiglaUnidade(const strCodUni: String; qryAux: TUniQuery = Nil): String;
Begin

  Result := '';

  If fEmptyStr(strCodUni) Then
    Exit;

  If ( qryAux = Nil ) Then
  Begin
    Result := fCampoTabela('UNI_SIGUNI', 'CADUNI', ['UNI_CODUNI'], [strCodUni], False);
  End
  Else
  Begin

    If (Not qryAux.Active) Or
       (strCodUni <> qryAux.FieldByName('UNI_CODUNI').AsString) Then
    Begin
      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add('SELECT SQL_NO_CACHE');
      qryAux.SQL.Add('  UNI_ITEFRA, '); // NAO RETIRAR POIS ESTA SENDO USADO
      qryAux.SQL.Add('  UNI_SIGUNI, '); // NAO RETIRAR POIS ESTA SENDO USADO
      qryAux.SQL.Add('  UNI_CODUNI  '); // NAO RETIRAR POIS ESTA SENDO USADO
      qryAux.SQL.Add('FROM CADUNI WHERE UNI_CODUNI = :CODUNI');
      qryAux.ParamByName('CODUNI').AsString := strCodUni;
      qryAux.Open;
    End;

    Result := qryAux.FieldByName('UNI_SIGUNI').AsString;

  End;

End;

