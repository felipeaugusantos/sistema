procedure pKill(intId: Integer);
  Var
    qryAux: TUniQuery;
begin
  If intId < 0 Then
    Exit;

  qryAux := fCriaQuery(Nil);
  qryAux.SQL.Add('KILL :ID');
  qryAux.ParamByName('ID').AsInteger := intId;
  qryAux.ExecSQL;
  FreeAndNil(qryAux);
end;

function fMesmoExecutavel: Boolean;
  Var
    dtaDtaExeAnt,
    dtaDtaExeAtu: TDateTime;
    intTamExeAnt,
    intTamExeAtu: Integer;
    AnoAtu, MesAtu, DiaAtu: Word;
    AnoAnt, MesAnt, DiaAnt: Word;
begin
  FileAge(Application.ExeName, dtaDtaExeAtu);
  dtaDtaExeAnt := IfNull(fCampoTabela('INF_DTAARQ',
                                      'INFSIS', ['INF_NOMARQ'], [ExtractFileName(Application.ExeName)]), 0);

  intTamExeAtu := fTamanhoArquivo(Application.ExeName);
  intTamExeAnt := IfNull(fCampoTabela('INF_TAMARQ',
                                      'INFSIS', ['INF_NOMARQ'], [ExtractFileName(Application.ExeName)]), 0);

  DecodeDate(dtaDtaExeAtu, AnoAtu, MesAtu, DiaAtu);
  DecodeDate(dtaDtaExeAnt, AnoAnt, MesAnt, DiaAnt);

  //Result := ( Trunc(dtaDtaExeAtu) = dtaDtaExeAnt) And (intTamExeAtu = intTamExeAnt);

  Result := (AnoAtu = AnoAnt) And (MesAtu = MesAnt) And (DiaAtu = DiaAnt) And (intTamExeAtu = intTamExeAnt);
end;

function fVerificaSeImpNFAvulsa(strEspDoc: String; opOpcao: TTipoEmissaoNFAvulo): Boolean;
  Var
    strMens: string;
begin
  Result := False;

  Case opOpcao Of
    teEmissaoNF     : strMens := 'Venda Normal.';
    teConfirmacaoPD : strMens := 'Confirmação de Pedidos.';
    teConfirmacaoIF : strMens := 'Confirmação de Cupom Fiscal.';
    teConfirmacaoDoc: strMens := 'Confirmação de Documentos.';
    teNaoPermite    : strMens := 'Não é possível utilizar a emissão de Nota Fiscal neste módulo.';
  End;

  If (Not fCfgSis('NFEUSA', varBoolean)) And
     SameText(strEspDoc, 'NF') And
     SameText(fCfgSis('TIPFOR', varString), 'A') Then
  Begin
    fMensagem('ATENÇÃO', 'O sistema está configurado para gerar nota fiscal em formulário avulso (CFG_TIPFOR). ' +
                         IIF(opOpcao = teNaoPermite, strMens, 'Para realizar a geração da Nota Fiscal, utilize a ' + strMens), ['&O K']);
    Result := True;
  End;
end;

