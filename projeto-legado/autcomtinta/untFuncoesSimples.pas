end;

function fGetSQLInsertTabelasServico(strTabela: String): String;
  var
    i: Integer;
    strCampos, strParam, strPrefix: String;
begin
  Result := '';

  If (fEmptyStr(strTabela)) Or
    ((strTabela <> 'SERGOR') And (strTabela <> 'SERMOV') And (strTabela <> 'SERNOT')) Then
    Exit;

  If (strTabela = 'SERGOR') Then
    strPrefix := 'FGO_'
  Else If (strTabela = 'SERMOV') Or (strTabela = 'SERNOT') Then
    strPrefix := 'GER_';

  If (strTabela = 'SERGOR') Then Begin
    strCampos := ' FGO_SEQFGO, FGO_NROPRO, FGO_NROCEI, FGO_SERINI, FGO_SERFIN, FGO_SEROBS, FGO_DISSER, '
      + 'FGO_DTAGES, FGO_HRAGES, FGO_DTENTS, FGO_HRENTS, ';
    strParam  := ' :SEQFGO, :NROPRO, :NROCEI, :SERINI, :SERFIN, :SEROBS, :DISSER, :DTAGES, :HRAGES, '
      + ':DTENTS, :HRENTS, ';
  End;

  For i := 1 To 30 Do Begin
    If (i >= 7) Then Begin
      strCampos := strCampos + strPrefix + 'CODS' + fStrZero(i, 2) + ', ';
      strParam  := strParam + ':CODS' + fStrZero(i, 2) + ', ';

      strCampos := strCampos + strPrefix + 'DESS' + fStrZero(i, 2) + ', ';
      strParam  := strParam + ':DESS' + fStrZero(i, 2) + ', ';

      strCampos := strCampos + strPrefix + 'VALS' + fStrZero(i, 2) + ', ';
      strParam  := strParam + ':VALS' + fStrZero(i, 2) + ', ';
    End;

    strCampos := strCampos + strPrefix + 'QTDS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':QTDS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'UNIS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':UNIS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'CUSS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':CUSS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'DECS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':DECS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'STAS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':STAS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'BRIS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':BRIS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'PARS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':PARS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'TBRS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':TBRS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'PRIS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':PRIS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'IDES' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':IDES' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'VENS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':VENS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'VE2S' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':VE2S' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'CMVS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':CMVS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'CV2S' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':CV2S' + fStrZero(i, 2) + ', ';

    If (i = 30) Then Begin
      strCampos := strCampos + '###';
      strParam  := strParam  + '###';
    End;
  End;

  strCampos := StringReplace(strCampos, ', ###', '', [rfReplaceAll]);
  strParam  := StringReplace(strParam, ', ###', '', [rfReplaceAll]);

  Result := 'INSERT INTO ' + strTabela + ' ( ' + strCampos + ' ) VALUES ( ' +
    strParam + ' ) ';
end;

function fSQLSaldoEstoque: String;
  Var
    strSQl : String;
begin
  strSQL := '';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   TAB.DTABAL, ';
  strSQL := strSQL + '   TAB.CODBAR, ';
  strSQL := strSQL + '   TAB.CODITE, ';
  strSQL := strSQL + '   SUM(TAB.QTDSAI) AS QTDSAI, ';
  strSQL := strSQL + '   SUM(TAB.QTDENT) AS QTDENT ';
  strSQL := strSQL + ' FROM ( ';
  strSQL := strSQL + '       SELECT SQL_NO_CACHE ';
  strSQL := strSQL + '         G.ITE_DTABAL AS DTABAL, ';
  strSQL := strSQL + '         I.ITE_CODBAR AS CODBAR, ';
  strSQL := strSQL + '         I.ITE_CODITE AS CODITE, ';
  strSQL := strSQL + '         IFNULL(D.QTDSAI, 0.00) AS QTDSAI, ';
  strSQL := strSQL + '         IFNULL(D.QTDENT, 0.00) AS QTDENT ';
  strSQL := strSQL + '       FROM CADITE I ';
  strSQL := strSQL + '         INNER JOIN ITEGER G ON G.ITE_CODITE = I.ITE_CODITE ';
  strSQL := strSQL + '                            AND G.ITE_CODEMP = :CODEMP ';
  strSQL := strSQL + '         LEFT  JOIN  (SELECT DISTINCT SQL_NO_CACHE ';
  strSQL := strSQL + '                        DET_NUMDOC, DET_ESPDOC, DET_CODEMP, ';
  strSQL := strSQL + '                        A.ITE_CODITE AS CODITE, ';
  strSQL := strSQL + '                        IF(DET_CLAFIS >= 5000, DET_QTDITE, 0.00) AS QTDSAI, ';
  strSQL := strSQL + '                        IF(DET_CLAFIS  < 5000, DET_QTDITE, 0.00) AS QTDENT ';
  strSQL := strSQL + '                      FROM ';
  strSQL := strSQL + '                        MOVDET ';
  strSQL := strSQL + '                        JOIN CADITE A ON A.ITE_CODITE = DET_CODITE ';
  strSQL := strSQL + '                        JOIN ITEGER B ON B.ITE_CODITE = DET_CODITE AND B.ITE_CODEMP = :CODEMP ';
  strSQL := strSQL + '                      WHERE DET_DTAENT BETWEEN :DTAINI AND :DTAFIN AND ';
  strSQL := strSQL + '                        DET_ESPDOC IN ("NF","IF") AND ';
  strSQL := strSQL + '                        DET_CODEMP = :CODEMP AND ';
  strSQL := strSQL + '                        A.ITE_CODFOR = :CODFOR ';

  { * "NOTDET" NÃO MOVIMENTA ESTOQUE
  strSQL := strSQL + '                      UNION ALL ';
  strSQL := strSQL + '                      SELECT DISTINCT SQL_NO_CACHE ';
  strSQL := strSQL + '                        DET_NUMDOC, DET_ESPDOC, DET_CODEMP, ';
  strSQL := strSQL + '                        A.ITE_CODITE AS CODITE, ';
  strSQL := strSQL + '                        IF(DET_CLAFIS >= 5000, DET_QTDITE, 0.00) AS QTDSAI, ';
  strSQL := strSQL + '                        IF(DET_CLAFIS  < 5000, DET_QTDITE, 0.00) AS QTDENT ';
  strSQL := strSQL + '                      FROM ';
  strSQL := strSQL + '                        NOTDET ';
  strSQL := strSQL + '                        JOIN CADITE A ON A.ITE_CODITE = DET_CODITE ';
  strSQL := strSQL + '                        JOIN ITEGER B ON B.ITE_CODITE = DET_CODITE AND B.ITE_CODEMP = :CODEMP ';
  strSQL := strSQL + '                      WHERE DET_DTAENT BETWEEN :DTAINI AND :DTAFIN AND ';
  strSQL := strSQL + '                        DET_ESPDOC IN ("NF","IF") AND ';
  strSQL := strSQL + '                        DET_CODEMP = :CODEMP AND ';
  strSQL := strSQL + '                        A.ITE_CODFOR = :CODFOR ';
  }

  strSQL := strSQL + '       ) D ON D.CODITE = I.ITE_CODITE ';
