Function fAddIteTbp(intTabela : Integer) : String;
  Const
    STR_CAMPO : Array[0..5] Of String = ('ITE_DESMAX', 'ITE_DESMAX_NOV', 'ITE_DESMGE', 'ITE_DESMGE_NOV', 'ITE_DESMSU', 'ITE_DESMSU_NOV');
  Var
    intCampo : Integer;
    strNomCam: String;
Begin
  Result := '';
  For intCampo := 0 To Length(STR_CAMPO)-1 Do
  Begin
    Result := Result + ' IFNULL(( ';
