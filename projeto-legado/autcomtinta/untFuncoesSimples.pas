function fCadFor(strNomCampo: String; strCodFor: String): String;
  Var
    strSQL   : String;
    qryGenFor: TUniQuery;

begin
  Try

    qryGenFor := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '   CADFOR.*, ';
    strSQL := strSQL + '   CID_NOMCID AS "FOR_NOMCID", ';
    strSQL := strSQL + '   CID_ESTADO AS "FOR_ESTADO" ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '   CADFOR ';
    strSQL := strSQL + '   JOIN CADCID ON FOR_CODCID = CID_CODCID ';
    strSQL := strSQL + ' WHERE ';
    strSQL := strSQL + '   FOR_CODFOR = :CODFOR ';

    With qryGenFor Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODFOR').AsString := strCodFor;
      Open;

      If FieldByName('FOR_' + strNomCampo).IsNull Then
      Begin
        Result := '';
      End
      Else
      Begin
        Result := FieldByName('FOR_' + strNomCampo).AsVariant;
      End;

      Close;
    End;

  Finally
    FreeAndNil(qryGenFor);
  End;

end;

