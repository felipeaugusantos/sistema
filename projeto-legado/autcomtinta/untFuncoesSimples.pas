    Result := Result + '    AND TBP.ITE_TABPRE = ' + intToStr(intTabela)      ;
    strNomCam := STR_CAMPO[intCampo];
    Delete(strNomCam, 10, 1);
    Insert(intToStr(intTabela), strNomCam, 10);
    Result := Result + ' ),0) AS ' + strNomCam + ', ';
  End;

End;

