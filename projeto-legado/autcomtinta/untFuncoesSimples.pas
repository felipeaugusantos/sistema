function fRetirarEspacos(Sender: TObject): String;
var
  strDesAdi: String;
  intEspaco,
  intCont: Integer;
begin
  Result := '';
  strDesAdi := TEditFocus(Sender).Text;
  intEspaco := 0;
  If (Not fEmptyStr(strDesAdi)) Then
  Begin
    For intCont := 1 To Length(strDesAdi) Do
    Begin
      If fEmptyStr(strDesAdi[intCont]) Then
        Inc(intEspaco)
      Else
