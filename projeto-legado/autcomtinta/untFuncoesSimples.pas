function fPesoDentroLimite(fltPesagem, fltPesoLi: Double): Boolean;
  Var
    fltLimMin,
    fltLimMax: Double;
begin
  fltLimMin := fltPesoLi - (fltPesoLi * (fCfgSis('LICFOP', varDouble) / 100));
  fltLimMax := fltPesoLi + (fltPesoLi * (fCfgSis('LSCFOP', varDouble) / 100));

  Result := (fltLimMin <= fltPesagem) And (fltLimMax >= fltPesagem);
end;

function fStatusConfOP(strNumOrd, strDtaCad: String): String;
  Var
    strSQL : String;
    qryTemp: TUniQuery;
Begin
  Try
    Result := '';
    qryTemp := fCriaQuery(nil);

    Try
      strSQL := 'SELECT ';
      strSQL := strSQL + 'ROUND( ';
      strSQL := strSQL + '    SUM( ';
      strSQL := strSQL + '      IF( ';
      strSQL := strSQL + '        U.UNI_KILLIT = "K", ';
      strSQL := strSQL + '        D.ORD_QTDPRO * U.UNI_PESLIT, ';
      strSQL := strSQL + '        D.ORD_QTDPRO * U.UNI_PESLIT * GM.GMT_PESREA ';
      strSQL := strSQL + '      ) ';
      strSQL := strSQL + '    ), ';
      strSQL := strSQL + '    3 ';
      strSQL := strSQL + '  ) AS ORD_PESOLI, ';
      strSQL := strSQL + '  SUM(D.ORD_QTDECF) AS ORD_QTDECF ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  ORDGER G ';
      strSQL := strSQL + '  INNER JOIN ORDDET D ';
      strSQL := strSQL + '    ON G.AUTOINCREM = D.ORD_SEQGER ';
      strSQL := strSQL + '  LEFT JOIN CADITE ID ';
      strSQL := strSQL + '    ON ID.ITE_CODITE = D.ORD_CODITE ';
      strSQL := strSQL + '  LEFT JOIN CADUNI U ';
      strSQL := strSQL + '    ON ID.ITE_CODUNI = U.UNI_CODUNI ';
      strSQL := strSQL + '  LEFT JOIN GEIMAT GM ';
      strSQL := strSQL + '    ON GMT_STATUS = "A" ';
      strSQL := strSQL + '    AND GMT_CODITE = G.ORD_CODITE ';
      strSQL := strSQL + '    AND GMT_CODCOR = G.ORD_CODCOR ';
      strSQL := strSQL + 'WHERE G.ORD_CODORD = :CODORD ';
      strSQL := strSQL + '  AND G.ORD_DTACAD = :DTAORD ';
      strSQL := strSQL + '  AND G.ORD_CODEMP = :CODEMP ';
      strSQL := strSQL + '  AND D.ORD_QTDPRO > 0 ';

      qryTemp.Close();
      qryTemp.SQL.Clear();
      qryTemp.SQL.Text := strSQL;
      qryTemp.ParamByName('CODORD').AsString   := strNumOrd;
      qryTemp.ParamByName('DTAORD').AsDateTime := StrToDateDef(strDtaCad, 0);
      qryTemp.ParamByName('CODEMP').AsString   := VS_strCodEmp;
      qryTemp.Open();

      If (qryTemp.IsEmpty) Then Begin
        Result := 'OP não encontrada para Conferência!';
      End Else Begin
        If (qryTemp.FieldByName('ORD_QTDECF').AsFloat = 0) Then
          Result := 'Pendente'
        Else If (qryTemp.FieldByName('ORD_QTDECF').AsFloat > 0) And
                (fPesoDentroLimite(qryTemp.FieldByName('ORD_QTDECF').AsFloat,
                                   qryTemp.FieldByName('ORD_PESOLI').AsFloat)) Then
          Result := 'Finalizado'
        Else
          Result := 'Parcialmente Realizado';
      End;

    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[TfrmBaixaOrdProdIndustrial.fStatusConfOP]');
    End;
  Finally
    FreeAndNil(qryTemp);
  End;
end;

