function fRetornaVendedoresDaCliVen(strCodCli: String): String;
var
  qryCliVen: TUniQuery;
begin
  qryCliVen := fCriaQuery;

  try
    qryCliVen.Close;
    qryCliVen.SQL.Clear;
    qryCliVen.SQL.Add('SELECT CVE_CODVEN');
    qryCliVen.SQL.Add('FROM CLIVEN');
    qryCliVen.SQL.Add('WHERE CVE_CODCLI = :CODCLI');
    qryCliVen.SQL.Add('GROUP BY CVE_CODVEN');
