function fPedidoFoiExpedido(strNumDoc, strCodEmp, strCodCli: String; blnConsiderarPedidoSohComServicoComoExpedido: Boolean=True): Boolean;
Var
  strSQL: String;
  qryFgo: TUniQuery;
  qryGen: TUniQuery;

  function fProvenienteConserto: Boolean;
  Begin
    Result := Not fEmptyStr(fRetornaOrdemServicoPedido(
      strNumDoc, strCodEmp, qryFgo.FieldByName('FGO_CODVEN').AsString));
  End;

  function fSomenteServico: Boolean;
  Begin
    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT        ');
      SQL.Add('  *           ');
      SQL.Add('FROM          ');
      SQL.Add('  FATDOR      ');
      SQL.Add('WHERE         ');
      SQL.Add('  FDO_SEQGER = :AUTINC ');
      ParamByName('AUTINC').AsString := qryFgo.FieldByName('AUTOINCREM').AsString;
      Open;

      Result := True;

      First;
      While Not Eof Do
      Begin
        If Not fEhItemServico(qryGen.FieldByName('FDO_CODITE').AsString) Then
          Result := False;
        Next;
      End;

      Close;
    End;
  End;

Begin

  Result := False;

  Try

    qryFgo := fCriaQuery;
    qryGen := fCriaQuery;

    strSQL := strSQL + 'SELECT          ';
    strSQL := strSQL + '  F.AUTOINCREM, ';
    strSQL := strSQL + '  F.FGO_NUMDOC, ';
    strSQL := strSQL + '  F.FGO_CODVEN, ';
    strSQL := strSQL + '  E.FGO_DTLBEX  ';
    strSQL := strSQL + 'FROM            ';
    strSQL := strSQL + '  EXTGOR E      ';
    strSQL := strSQL + '  LEFT JOIN FATGOR F ON F.AUTOINCREM = E.FGO_SEQFGO ';
    strSQL := strSQL + 'WHERE                         ';
    strSQL := strSQL + '  F.FGO_NUMDOC = :NUMDOC AND  ';
    strSQL := strSQL + '  F.FGO_ESPDOC = :ESPDOC AND  ';
    strSQL := strSQL + '  F.FGO_CODEMP = :CODEMP AND  ';
    strSQL := strSQL + '  F.FGO_CODCLI = :CODCLI      ';

    With qryFgo Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := 'PD';
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('CODCLI').AsString := strCodCli;
      Open;

      If FieldByName('FGO_DTLBEX').AsDateTime > 0 Then
        Result := True
      Else If (VS_strTipExp = '4') Then
        Result := fPedidoExpedido(FieldByName('AUTOINCREM').AsString);

      If (Not Result) And (fCfgSis('CONEQU') = 'S') Then
        Result := fProvenienteConserto;

      If (Not Result) And (blnConsiderarPedidoSohComServicoComoExpedido) Then
        Result := fSomenteServico;

    End;

  Except
    On E: Exception Do
      pMensagensErro(E.Message,'');
  End;
  FreeAndNil(qryFgo);
  FreeAndNil(qryGen);

End;

function fPedidoExpedido(strAutGor: String): Boolean;
  Var
    qryGen: TUniQuery;
begin
  qryGen := fCriaQuery;
  Try
    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT ');
      SQL.Add('  COUNT(*) ');
      SQL.Add('FROM ');
      SQL.Add('  FATDOR ');
      SQL.Add('   LEFT JOIN EXTDOR ON FDO_SEQFDO        = FATDOR.AUTOINCREM ');
      SQL.Add('  INNER JOIN FATGOR ON FATGOR.AUTOINCREM = FATDOR.FDO_SEQGER ');
      SQL.Add('WHERE ');
      SQL.Add('  FATGOR.AUTOINCREM = :AUTINC AND ');
      SQL.Add('  FDO_ESPDOC  = :ESPDOC AND ');
      SQL.Add('  FDO_CODITE <> :ITESER AND ');
      SQL.Add('  FDO_CODITE <> :SERTER AND ');
      SQL.Add('  FDO_CODITE <> :ITEBOM AND ');
      SQL.Add('  FDO_CODITE <> :ITETAX AND ');
      SQL.Add('  (ROUND(FDO_QTDITE - FDO_QTDBAI, 4) - ROUND(FDO_QTDEXP, 4)) > 0 ');

      ParamByName('AUTINC').AsString := strAutGor;
      ParamByName('ESPDOC').AsString := 'PD';
      ParamByName('ITESER').AsString := fCfgSis('ITESER', varString);
      ParamByName('SERTER').AsString := fCfgSis('SERTER', varString);
      ParamByName('ITEBOM').AsString := fCfgSis('ITEBOM', varString);
      ParamByName('ITETAX').AsString := fCfgSis('ITETAX', varString);

      Open;
      Result := (Fields[0].AsInteger = 0);
      Close;
    End;
  Finally
    FreeAndNil(qryGen);
  End;
end;

function fVerificaTipoComissao(strCodDiv: String): String;
  Var
    strTipCom : String;
begin
  If fCfgSis('TCOPRO') <> '4' Then
  Begin
    strTipCom := fRetTipoComissaoDiversos(strCodDiv);
    //Caso define o tipo de comissao no cadastro do profissional
    If (fCfgSis('TIPCOM') = 'P') And Not fEmptyStr(strTipCom) Then
    Begin
      Case strTipCom[1] Of
        'P': Result := '1'; //Cadastro do profissional (Diversos)
        'I': Result := '2'; //Cadastro do produto
        'F': Result := '3'; //Faixas Faturamento
        'C': Result := '4'; //Cadastro do cliente
        Else Result := fCfgSis('ORIPRO'); //configuracao geral (default)
      End;
    End
    Else
      Result := fCfgSis('ORIPRO');
  End
  Else
    Result := '2'; //Cadastro de Produtos
end;

{************************************}
{* RETORNA A COMISSÃO DE ACORDO COM *}
{* AS MARGENS CADASTRADAS           *}
{*********************************AF*}
function fRetCondicaoPagtoFaixaValor(fltValor: Double; blnCodCnd: Boolean = False): String;
  Var
    strSQL: String;
    qryGen: TUniQuery;
Begin

  Try

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE      ';
    strSQL := strSQL + '  FAI_CONPAG,       ';
    strSQL := strSQL + '  FAI_CODCND ';
    strSQL := strSQL + 'FROM     ';
    strSQL := strSQL + '  FAICND ';
    strSQL := strSQL + 'WHERE    ';
    strSQL := strSQL + '  :VALOR >= FAI_VALINI AND ';
    strSQL := strSQL + '  :VALOR <= FAI_VALFIN     ';

    qryGen := fCriaQuery;

    With qryGen, SQL Do
    Begin
      Clear;
      Add(strSQL);
      ParamByName('VALOR').AsFloat := fltValor;
      Open;
      If Not blnCodCnd Then
        Result := FieldByName('FAI_CONPAG').AsString
      Else
        Result := FieldByName('FAI_CODCND').AsString;
    End;

  Finally
    FreeAndNil(qryGen);
  End;

  If fEmptyStr(Result) Then
  Begin
    If Not blnCodCnd Then
      Result := '01000'
    Else
      Result := fCfgSis('CNDAVI', varString);
  End;
End;

