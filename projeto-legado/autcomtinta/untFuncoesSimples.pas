  With qryGen, SQL Do
  Begin
    Close;
    Clear;

    If Pos(strEspDoc, 'PD_OR_') > 0 Then
    Begin
      Add('SELECT SQL_NO_CACHE');
      Add('  FGO_ENTURG AS ENTURG');
      Add('FROM');
      Add('  FATGOR');
      Add('  INNER JOIN EXTGOR ON FGO_SEQFGO = AUTOINCREM');
      Add('WHERE');
      Add('  FGO_NUMDOC = :NUMDOC AND');
      Add('  FGO_ESPDOC = :ESPDOC AND');
      Add('  FGO_CODEMP = :EMPDOC AND');
      Add('  FGO_CODCLI = :CLIDOC');
