    Result := ' (SELECT '+IIF(blnCodigo, ' "" ', ' CLC.CND_CNDPAG ') +
              '    FROM CLICND CLC ' +
              '   WHERE CLC.CND_CODCLI = ' + strJoin + 
              '     AND CLC.CND_SUGEST = "S" '+
