Procedure pCriaAggregate(cdsClient: TUniClientDataSet; strNomCam, strNomAgg:String; strFormat: String = '#,##0.00');
Begin
  Try
    With TAggregateField.Create(cdsClient) Do
    Begin
      Name          := strNomAgg;
      FieldName     := strNomAgg;
      DataSet       := cdsClient;
      Expression    := 'SUM(' + strNomCam + ')';
      DisplayFormat := strFormat;
