function fRetMaxMinEspecifiTecnica(Const strCodIte, strCodEte: String; var fltVlrMin, fltVlrMax : Double): String;
  Var
    strSQL   : String;
    qryGenIte: TUniQuery;
Begin
  Try
    qryGenIte := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + ' SELECT ETM_VALMIN,                                    ';
    strSQL := strSQL + '        ETM_VALMAX,                                    ';
    strSQL := strSQL + '        ETE_DESCRI                                     ';
    strSQL := strSQL + ' FROM GERMAT                                           ';
    strSQL := strSQL + '   INNER JOIN ETEMAT ON ETM_SEQMAT = GERMAT.AUTOINCREM ';
    strSQL := strSQL + '                    AND ETM_CODETE = :CODETE           ';
    strSQL := strSQL + '   INNER JOIN ESPTEC ON ETE_CODIGO = ETM_CODETE        ';
    strSQL := strSQL + ' WHERE GMT_CODITE = :CODITE                            ';

    With qryGenIte Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODITE').AsString := strCodIte;
      ParamByName('CODETE').AsString := strCodEte;
      Open;

      fltVlrMin := 0.00;
      fltVlrMax := 0.00;
      If Not IsEmpty Then
      Begin
        Result    := FieldByName('ETE_DESCRI').AsString;
        fltVlrMin := FieldByName('ETM_VALMIN').AsFloat;
        fltVlrMax := FieldByName('ETM_VALMAX').AsFloat;
      End
      Else
        Result := '';

      Close;
    End;

  Finally
    FreeAndNil(qryGenIte);
  End;

End;

