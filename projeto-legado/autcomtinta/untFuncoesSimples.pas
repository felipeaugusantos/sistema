function fPermiteInserirSomenteItemRetira(strCodIte, strCodEmp, strOpcDoc: String;
  blnRetira: Boolean): Boolean;
  Var
    strSQL: String;
    qryTmp: TUniQuery;
Begin
  Result := True;

  If Pos(strOpcDoc, 'PD_OR_VN_') <= 0 Then
    Exit;

  If Not fCfgSis('APERET', VarBoolean) Then
    Exit;

  If blnRetira Then
    Exit;

  Try
    strSQL := '';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '   ITE_APERET ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '   ITEGER ';
    strSQL := strSQL + ' WHERE ';
    strSQL := strSQL + '   ITE_CODITE = :CODITE AND ';
    strSQL := strSQL + '   ITE_CODEMP = :CODEMP     ';

    qryTmp := fCriaQuery;

    With qryTmp Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      ParamByName('CODITE').AsString := strCodIte;
      ParamByName('CODEMP').AsString := strCodEmp;

      Open;

      If Not IsEmpty Then
      Begin
        If FieldByName('ITE_APERET').AsString = 'S' Then
          Result := False
