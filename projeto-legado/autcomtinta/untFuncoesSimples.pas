function fGetMemoryTableName(strTabela: String): String;
begin
  Result := 'TMP_' + strTabela + '_' + fTiraCaracEspeciaisPonto(GetIPAddressAsString +
    IntToStr(Random(1000)) + FormatDateTime('yyyyMMddhhmmss', fNow()));
