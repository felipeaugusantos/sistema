{********************************}
{* CARREGA MATRIZ DE LIBERAÇÕES *}
{*****************************AF*}

procedure pGeraMatrizLiberacao(strOperador,
                               strCodVen,
                               strMenObs: String;
                               strDirAce: String;
                               strCodIte: String = '';
                               intAutInc: Integer = 0;
                               strNumLib: String = '';
                               strInfBlo: String = '';
                               blnIgnInc: Boolean = False;
                               strInfoF4: String = '';
                               horaLib  : TTime = 0);
  Var
    intPosLog,
    intIndex: Integer;
    blnAchouLog: Boolean;
Begin
  blnAchouLog := FALSE;
  intPosLog   := 0;

  (**********************************************************)
  (* PROCURA UM LOG DO MESMO TIPO PARA NAO DUPLICAR OS LOGS *)
  (*******************************************************LA*)
  For intIndex := Low(arrLogLib) To High(arrLogLib) Do
    If SameText(strDirAce,arrLogLib[intIndex].strDirAce) And
       SameText(strCodIte,arrLogLib[intIndex].strCodIte) And
     ((intAutInc = arrLogLib[intIndex].intAutInc) Or blnIgnInc) Then
    Begin
      blnAchouLog := TRUE;
      intPosLog := intIndex;
      break;
    End;

  If Not blnAchouLog Then
  Begin
    SetLength(arrLogLib,Succ(Length(arrLogLib)));
    intPosLog := High(arrLogLib);
  End;

  arrLogLib[intPosLog].strOpeLib := strOperador;
  arrLogLib[intPosLog].strCodVen := strCodVen;
  arrLogLib[intPosLog].dtaDtaCad := VS_Date;
  arrLogLib[intPosLog].dtaHraCad := iif(horaLib = 0, fTime(), horaLib);
  arrLogLib[intPosLog].strObserv := fLimpaTagMsgOculta(strMenObs);
  arrLogLib[intPosLog].strDirAce := strDirAce;
  arrLogLib[intPosLog].strCodIte := strCodIte;
  arrLogLib[intPosLog].intAutInc := intAutInc;
  arrLogLib[intPosLog].strNumLib := strNumLib;
  arrLogLib[intPosLog].blnInsLog := False;
  arrLogLib[intPosLog].strInfBlo := fLimpaTagMsgOculta(strInfBlo); // quando crediário armazena a mensagem "real" aqui.
  arrLogLib[intPosLog].blnIgnInc := blnIgnInc;
  arrLogLib[intPosLog].strInfoF4 := strInfoF4;
End;

procedure pAtualizaMatrizLiberacao(strCodVen: String);
  Var
    intIndex: Integer;
Begin
  For intIndex := Low(arrLogLib) To High(arrLogLib) Do
    arrLogLib[High(arrLogLib)].strCodVen := strCodVen;
End;

function GetValidComponentName(const strNome: string): string;
var
  intCont: Integer;
  strResult: string;

  function IsValidIdent(const Ident: string; AllowDots: Boolean): Boolean;
  const
    Alpha = ['A'..'Z', 'a'..'z', '_'];
    AlphaNumeric = Alpha + ['0'..'9'];
    AlphaNumericDot = AlphaNumeric + ['.'];
  var
    I: Integer;
  begin
    Result := False;
    if (Length(Ident) = 0) or not CharInSet(Ident[1], Alpha) then Exit; //(Ident[1] in Alpha) then Exit;
    if AllowDots then
      for I := 2 to Length(Ident) do
        begin
          if not CharInSet(Ident[I], AlphaNumericDot) then Exit //(Ident[I] in AlphaNumericDot) then Exit
        end
    else
      for I := 2 to Length(Ident) do if not CharInSet(Ident[I],AlphaNumeric) then Exit; //(Ident[I] in AlphaNumeric) then Exit;
    Result := True;
  end;
begin
  Result := '';
  strResult := '';
  for intCont := 1 to Length(strNome) do
  begin
    strResult := strResult + strNome[intCont];
    if IsValidIdent(strResult, False) then
      Result := Result + strNome[intCont]
    else
      strResult := Result;
  end;
end;

