function fPedidoVinculadoComGarantia(strAUTINCPedido:string; Out strNumGA: string): Boolean;
  var qryConsulta: TUniQuery;
Begin
  strNumGA := '';
  qryConsulta := fCriaQuery(nil);
  Try
    qryConsulta.SQL.Add('SELECT MOVGAG.GAG_NUMENT AS NUMGA');
    qryConsulta.SQL.Add('  FROM FATGOR');
    qryConsulta.SQL.Add(' INNER JOIN FATDOR ON FDO_SEQGER = FATGOR.AUTOINCREM');
    qryConsulta.SQL.Add(' INNER JOIN SEQGAR ON SEQ_FDO_TE = FATDOR.AUTOINCREM');
    qryConsulta.SQL.Add(' INNER JOIN MOVGAD ON MOVGAD.AUTOINCREM = SEQ_MOVGAD');
    qryConsulta.SQL.Add(' INNER JOIN MOVGAG ON MOVGAG.AUTOINCREM = GAD_SEQGAG');
    qryConsulta.SQL.Add(' WHERE FATGOR.AUTOINCREM = :AUTOINC');
    qryConsulta.ParamByName('AUTOINC').AsString := strAUTINCPedido;
    qryConsulta.Open;
    If Not qryConsulta.IsEmpty Then
      strNumGA := qryConsulta.FieldByName('NUMGA').AsString;
    Result := strNumGA <> '';
  Finally
    FreeAndNil(qryConsulta);
  End;
End;



function fGanhouNetpoints(strNumDoc, strEspDoc, strCodEmp, strCodCli, strSerie: String; var intQtdNps: Integer): Boolean;
  Var
    qryCadNps: TUniQuery;
begin
  intQtdNps := 0;

  qryCadNps := fCriaQuery(Nil);
  Try
    Try
      With qryCadNps Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(' SELECT NPS_NPSCAL, NPS_QTDNPS ');
        SQL.Add('   FROM CADNPS ');
        SQL.Add('  WHERE NPS_NUMDOC = :NUMDOC ');
        SQL.Add('    AND NPS_ESPDOC = :ESPDOC ');
        SQL.Add('    AND NPS_CODEMP = :CODEMP ');
        SQL.Add('    AND NPS_CODCLI = :CODCLI ');
        SQL.Add('    AND NPS_SERIE_ = :SERIE_ ');
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODEMP').AsString := strCodEmp;
        ParamByName('CODCLI').AsString := strCodCli;
        ParamByName('SERIE_').AsString := strSerie;
        Open;

        If (Not IsEmpty) Then
        Begin
          intQtdNps := FieldByName('NPS_QTDNPS').AsInteger;
          If (intQtdNps <= 0) Then
            intQtdNps := FieldByName('NPS_NPSCAL').AsInteger;
        End;

        Close;
      End;
    Except
      On E: Exception Do
      Begin
        intQtdNps := 0;
      End;
    End;
  Finally
    FreeAndNil(qryCadNps);
  End;

  Result := (intQtdNps > 0);
end;

