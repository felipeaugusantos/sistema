function fTravaFatDorMenor(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
var
  qryAux : TUniQuery;

  fltTotFGO,
  fltTotFDO,
  fltTotDif : Double;
begin
  Try
    qryAux := fCriaQuery;
    Try
      With qryAux, SQL Do
      Begin
        Add('SELECT   ');
        Add('  (FGO_TOTPRO + FGO_TOTSER) AS TOTAL, ');
        Add('  SUM(FDO_TOTITE) AS FDO_TOTITE       ');
        Add('FROM      ');
        Add(' FATGOR   ');
        Add(' JOIN FATDOR ');
        Add(' ON FATGOR.AUTOINCREM = FDO_SEQGER  ');
        Add(' WHERE ');
        Add(' FGO_CODEMP = :CODEMP AND ');
        Add(' FGO_NUMDOC = :NUMDOC AND ');
        Add(' FGO_ESPDOC = :ESPDOC ');
        Add(' GROUP BY FDO_SEQGER ');

        ParamByName('CODEMP').AsString := strCodEmp;
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;

        Open;

        {Req: 94186
         Utilizamos aqui o fFormataFloat, devido a ocorrência de divergência
         de valores, devido a utilização do SAT existe uma peculariedade na função que
         internamente utiliza a fArredondaABNT_NBR5891_77.}
        fltTotFGO := fFormataFloat(FieldByName('TOTAL').AsFloat, 2);
        fltTotFDO := fFormataFloat(FieldByName('FDO_TOTITE').AsFloat, 2);

        fltTotDif := Abs(fltTotFGO - fltTotFDO);

        {Aqui implementamos a tolerância de 1 centavo na diferença}
        If (fStrToFloat(FormatFloat('#,##0.00', fltTotDif)) > fStrToFloat('0,01')) Then
          Result := True
        Else
          Result := False;

      End;

    Except
      On E: Exception Do
      Begin
        Result := True;
        pMensagensErro(E.Message, '[fTravaFatDorMenor]');
      End;
    End;
  Finally
    FreeAndNil(qryAux);
  End;
end;

function fRetUtilizaCliPro : TUtilizaCliPro;
  Var
    intValCfg : Integer;
    intBitOpc : Integer;
Begin
  Result := [];
  intValCfg := fCfgSis('ACLPRO', varInteger);
  intBitOpc := Ord( High(TOpcCliPro) );

  While ( intValCfg <> 0 ) Do
  Begin

    If (intValCfg >= Ord(TOpcCliPro( intBitOpc )) ) Then
    Begin
      Result := Result + [TOpcCliPro(intBitOpc)];
      intValCfg := intValCfg - Ord(TOpcCliPro(intBitOpc));
    End;

    intBitOpc := Trunc( intBitOpc / 2 );

  End;

End;

