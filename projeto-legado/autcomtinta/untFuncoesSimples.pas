function fRetDocMaisTelParaIF(strNumDoc, strNumTel: String; intColunas:Integer): String;
  Var
    strTitCupNumDoc: String;
    strTitTelNumTel: String;
    intDif: Integer;
begin
  strTitCupNumDoc := '';
  strTitTelNumTel := '';
  If (Not fEmptyStr(strNumDoc)) And fCfgSis('IMPCAC', varBoolean) Then
  Begin
    strTitCupNumDoc := 'Cupom Fiscal:';
    If (Not fEmptyStr(strNumTel)) And (intColunas < 48) Then
    Begin
      strTitCupNumDoc := 'Cupom:';
    End;

    strTitCupNumDoc := strTitCupNumDoc + strNumDoc + '-IF';
  End;

  If (Not fEmptyStr(strNumTel)) Then
  Begin
    strTitTelNumTel := IIF(Not fEmptyStr(strTitCupNumDoc),' ','') + 'Tel:' + fReplaceStr(fFormataFone(strNumTel),' ','');

    intDif := intColunas - (Length(strTitCupNumDoc) + Length(strTitTelNumTel));

    If (Not fEmptyStr(strTitCupNumDoc)) And (intDif > 0) Then
    Begin
      strTitTelNumTel := fPadL(' ', intDif) + strTitTelNumTel;
    End;
  End;

  Result := strTitCupNumDoc + strTitTelNumTel;
end;

