    End;
  End;
end;

function fValidaDadosClienteNFe(objDadosNfe: TValidacaoDadosNFe): Boolean;
  Var
    intTamCmpEndere,
    intTamCmpBairro,
    intTamCmpEndEnt,
    intTamCmpBaiEnt,
    intTamCmpRefere,
    intTamCmpEmaNfe: Integer;
    strMsg: String;
    strTmp: String;

    function fCampoInvalido(intTamCampo: Integer; blnCmpEmailOrRefere: Boolean): Boolean;
      Var
        blnTamCmp: Boolean;
    Begin
      If blnCmpEmailOrRefere Then
        blnTamCmp := (intTamCampo > 60)
      Else
        blnTamCmp := ((intTamCampo < 2) Or
                      (intTamCampo > 60));

      Result := (blnTamCmp) And fEhNFE310(objDadosNfe.strEspDoc);
    End;

    function fRetMensagem(intTamCampo: Integer; blnCmpEmailOrRefere: Boolean = False): String;
    Begin
      Result := '';

      If (objDadosNfe.ovOrigem <> ovFaturamento) Or
         (objDadosNfe.blnCliCons) Then
      Begin
        If fCampoInvalido(intTamCampo, blnCmpEmailOrRefere) Then
        Begin
          Result := strMsg + 'informado deve conter ' + IIF(blnCmpEmailOrRefere, 'até', 'entre 2 à') + ' 60 caracteres no qual é permitido pela nota fiscal eletrônica.' +
                    IIF(intTamCampo > 60, IIF(Not blnCmpEmailOrRefere, #13#10, ' ') + 'Favor abreviar o mesmo, para que a nota eletrônica seja autorizada.', '');
        End;
      End
      Else
      Begin
        If fCampoInvalido(intTamCampo, blnCmpEmailOrRefere) Then
          Result := strMsg + 'informado deve conter ' + IIF(blnCmpEmailOrRefere, 'até', 'entre 2 à') + ' 60 caracteres no qual é permitido pela nota fiscal eletrônica.';
      End;
    End;
Begin
  Result := True;

  With objDadosNfe Do
  Begin
    stlMensagens.Clear;

    intTamCmpEndere := Length(Trim(strEndere));
    intTamCmpBairro := Length(Trim(strBairro));
    intTamCmpEndEnt := Length(Trim(strEndEnt));
    intTamCmpBaiEnt := Length(Trim(strBaiEnt));
    intTamCmpEmaNfe := Length(Trim(strEmaNfe));
    intTamCmpRefere := Length(Trim(strRefere));

    If (ovOrigem = ovFaturamento) Then
    Begin
      If (Not blnSomenteItensRetira) Then
      Begin
        strMsg := 'O Endereço de Entrega ';
        strTmp := fRetMensagem(intTamCmpEndEnt);

        If Not fEmptyStr(strTmp) Then
          stlMensagens.Add(strTmp);
      End;

      If (Not blnSomenteItensRetira) Then
      Begin
        strMsg := 'O Bairro de Entrega ';
        strTmp := fRetMensagem(intTamCmpBaiEnt);

        If Not fEmptyStr(strTmp) Then
