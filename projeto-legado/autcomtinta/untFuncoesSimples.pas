Procedure pAdicionaCheques(qryCadChq: TDataSet; cdsCadChq: TUniClientDataSet);
Begin
  If Assigned(qryCadChq) And qryCadChq.Active Then
  Begin
    qryCadChq.First;
    While Not qryCadChq.Eof Do
    Begin
      cdsCadChq.Insert;
      cdsCadChq.FieldByName('CHQ_NUMAGE').AsString   := qryCadChq.FieldByName('CHQ_NUMAGE').AsString;
      cdsCadChq.FieldByName('CHQ_CONCOR').AsString   := qryCadChq.FieldByName('CHQ_CONCOR').AsString;
      cdsCadChq.FieldByName('CHQ_NUMCHQ').AsString   := qryCadChq.FieldByName('CHQ_NUMCHQ').AsString;
      cdsCadChq.FieldByName('CHQ_NOMEMI').AsString   := qryCadChq.FieldByName('CHQ_NOMEMI').AsString;
      cdsCadChq.FieldByName('CHQ_C_G_C_').AsString   := FormatMaskText(IIF(qryCadChq.FieldByName('CHQ_CGCCPF').AsString = '1', fRetMascaraC_G_C_(fSetaPais, C_G_C_), fRetMascaraC_G_C_(fSetaPais, C_P_F_)),
                                                                                               qryCadChq.FieldByName('CHQ_C_G_C_').AsString);
      cdsCadChq.FieldByName('CHQ_DTAVEN').AsDateTime := qryCadChq.FieldByName('CHQ_DTAVEN').AsDateTime;
      cdsCadChq.FieldByName('CHQ_VALCHQ').AsFloat    := qryCadChq.FieldByName('CHQ_VALCHQ').AsFloat;
      cdsCadChq.Post;

      qryCadChq.Next;
    End;
  End;
End;

Function fRetCodBarra(strCodIte: String): String;
  Var
    qryGen: TUniQuery;
begin
  Try

    qryGen := fCriaQuery;

    With qryGen, SQL Do
    Begin
      Clear;
      SQL.Add('SELECT ITE_CODBAR FROM CADITE');
      SQL.Add('WHERE ITE_CODITE = :CODITE');

      ParamByName('CODITE').AsString := strCodIte;
      Open;

      If IsEmpty Then
        Result := ''
      Else
        Result := FieldByName('ITE_CODBAR').AsString;

      Close;
    End;

  Finally
    FreeAndNil(qryGen);
  End;

end;

Function fRetCodBarMovCdb(strAutInc, strCodIte: String): String;
  Var
    qryGen: TUniQuery;
begin
  Try
    qryGen := fCriaQuery;

    With qryGen, SQL Do
    Begin
      Clear;
      SQL.Add('SELECT ');
      SQL.Add('  GROUP_CONCAT(CDB_CODBAR) AS CODBAR ');
      SQL.Add('FROM ');
      SQL.Add('  MOVCDB ');
      SQL.Add('WHERE ');
      SQL.Add('  CDB_SEQDET = :AUTINC');

      ParamByName('AUTINC').AsString := strAutInc;
      Open;

      If IsEmpty Then
        Result := fRetCodBarra(strCodIte)
      Else
        Result := AnsiReplaceStr(FieldByName('CODBAR').AsString,',',', ');

      Close;
    End;

  Finally
    FreeAndNil(qryGen);
  End;
end;

Function fRetCodIte(strCodBar: String): String;
  Var
    qryGen: TUniQuery;
begin
  Try

    qryGen := fCriaQuery;

    With qryGen, SQL Do
    Begin
      Clear;
      SQL.Add('SELECT ITE_CODITE FROM CADITE');
      SQL.Add('WHERE ITE_CODBAR = :CODBAR LIMIT 1');

      ParamByName('CODBAR').AsString := strCodBar;
      Open;

      If IsEmpty Then
        Result := ''
      Else
        Result := FieldByName('ITE_CODITE').AsString;

      Close;
    End;

  Finally
    FreeAndNil(qryGen);
  End;

end;

