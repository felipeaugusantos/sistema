              '    FROM CLICND CLC ' +
              '   WHERE CLC.CND_CODCLI = ' + strJoin + 
              '     AND CLC.CND_SUGEST = "S" '+
              '     AND CLC.CND_CODCND IS NOT NULL ' + 
              '  ORDER BY CLC.CND_ULTALT DESC LIMIT 1) ';
