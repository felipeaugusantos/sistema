procedure pVerdeVermelho(obj                   : TWinControl;
                         shp                   : TShape;
                         blnLibera             : Boolean;
                         blnIniCkbMarcado      : Boolean = False;
                         blnSeraUtilizadoSenha : Boolean = True);

  procedure pEnabledEdit(Edit: TWinControl);
  begin

    Edit.TabStop  := True;

    If (Edit Is TCustomEdit) Then
      TCustomEdit(Edit).ReadOnly := False
    Else If (Edit Is TDBLookupComboBox) Then
      TDBLookupComboBox(Edit).ReadOnly := False;

    {Obs: Mesmo "TCustomEdit" sendo uma classe ancestral, por algum motivo não
     ocorre o bloqueio dos EditFocus, por esse motivo tratei aqui, favor não remover!}
    If (Edit Is TEditFocus) Then
    Begin
      TEditFocus(Edit).ReadOnly := False;
      TEditFocus(Edit).TabStop  := True;
      TEditFocus(Edit).Color    := clWindow;
    End
    Else If (Edit Is TDBEditFocus) Then
    Begin
      TDBEditFocus(Edit).ReadOnly := False;
      TDBEditFocus(Edit).TabStop  := True;
      TDBEditFocus(Edit).Color    := clWindow;
    End;

    If (Edit Is TDBLookupComboBox) Then
      TDBLookupComboBox(Edit).Color := clWindow;

  end;

  procedure pDisableEdit(Edit: TWinControl);
  begin

    Edit.TabStop  := False;

    If (Edit Is TCustomEdit) Then
      TCustomEdit(Edit).ReadOnly := True
    Else If (Edit Is TDBLookupComboBox) Then
      TDBLookupComboBox(Edit).ReadOnly := True;

    {Obs: Mesmo "TCustomEdit" sendo uma classe ancestral, por algum motivo não
     ocorre o bloqueio dos EditFocus, por esse motivo tratei aqui, favor não remover!}
    If (Edit Is TEditFocus) Then
    Begin
      TEditFocus(Edit).ReadOnly := True;
      TEditFocus(Edit).TabStop  := False;
      TEditFocus(Edit).Color    := $00FFE4D5;
    End
    Else If (Edit Is TDBEditFocus) Then
    Begin
      TDBEditFocus(Edit).ReadOnly := True;
      TDBEditFocus(Edit).TabStop  := False;
      TDBEditFocus(Edit).Color    := $00FFE4D5;
    End;

    If (Edit Is TDBLookupComboBox) Then
      TDBLookupComboBox(Edit).Color := $00FFE4D5;

  end;

Begin

  If (Not blnLibera) Then
  Begin
    If obj Is TEditFocus Then
    Begin
      With obj As TEditFocus Do
      Begin
        MaxLength := 10;
        TamCampo  := 10;
        CompZeros := False;
        PasswordChar := '*';
        TipoTexto := EditFocus.TTipoTexto(ttAlfanumerico);
      End;
    End;
    shp.Brush.Color  := clRed;
  End
  Else
  Begin
    shp.Brush.Color  := clGreen;
  End;

  If obj Is TCheckBox Then
  Begin
    With obj As TCheckBox Do
    Begin
      Enabled := blnLibera;
      Checked := blnIniCkbMarcado;
    End;
  End;

  {Req: 103572
   - A princípio essa função não bloqueava campos "ReadOnly = True";
   - Para situações em que é necessário bloquear, passe "FALSE" para "blnSeraUtilizadoSenha";
   - Esse parâmetro foi criado para manter a compatibilidade, por esse motivo ele é DEFAULT "True"}
  If (Not blnSeraUtilizadoSenha) Then
  Begin

    If (blnLibera) Then
      pEnabledEdit(obj)
    Else
      pDisableEdit(obj);

  End;

End;

procedure pInfoStatusGravacao(pgbStatus: TcxProgressBar; strInformacao: String; intMax: Integer = 0);
begin
  If Assigned(pgbStatus) And (GetParentForm(pgbStatus).FindComponent('lblGravando') <> Nil) Then
  Begin
    TLabel(GetParentForm(pgbStatus).FindComponent('lblGravando')).Caption := strInformacao;
    If intMax > 0 Then
    Begin
      pgbStatus.Properties.Max := intMax;
      pgbStatus.Position := 0;
    End;
    Application.ProcessMessages;
  End;
end;

procedure pStepStatusGravacao(pgbStatus: TcxProgressBar; strInformacao: String='');
begin
  If Assigned(pgbStatus) Then
  Begin
    pgbStatus.Position := pgbStatus.Position + 1;

    If (Not fEmptyStr(strInformacao)) And (GetParentForm(pgbStatus).FindComponent('lblGravando') <> Nil) Then
      TLabel(GetParentForm(pgbStatus).FindComponent('lblGravando')).Caption := strInformacao;

    Application.ProcessMessages;
  End;
end;

function fRetNomBairro(strCodigo: String; opcBairro : TOpcBairro = opcDescri): String;
  Var
    qryConsulta : TUniQuery;
Begin
  Try
    qryConsulta := fCriaQuery(Nil);
    With qryConsulta, SQL Do
    Begin
      Close;
      Clear;
      Add(' SELECT SQL_NO_CACHE                          ');
      Add('        BAI_DESCRI,                           ');
      Add('        BAI_CODCID,                           ');
      Add('        CID_NOMCID,                           ');
      Add('        CID_ESTADO                            ');
      Add(' FROM CADBAI                                  ');
      Add(' INNER JOIN CADCID ON CID_CODCID = BAI_CODCID ');
      Add(' WHERE BAI_CODBAI = :CODBAI                   ');

      ParamByName('CODBAI').AsString := strCodigo;

      Open;

      Case opcBairro Of
        opcDescri : Result := FieldByName('BAI_DESCRI').AsString;
        opcCodCid : Result := FieldByName('BAI_CODCID').AsString;
        opcNomCid : Result := FieldByName('CID_NOMCID').AsString;
        opcEstado : Result := FieldByName('CID_ESTADO').AsString;
      End;

      Close;
    End;
  Finally
    FreeAndNil(qryConsulta);
  End;
End;

