function fPedidoPossuiBrindesProdutos(strNumdoc, strEspDoc, strCodEmp: String): Boolean;
  var
    qryGen: TUniQuery;
begin
    qryGen := fCriaQuery(Nil);

    With qryGen, SQL Do
    Begin
      Close;
      Clear;
      Add('SELECT FDO_CODITE FROM FATDOR INNER JOIN BRIDOR ON BRI_SEQDET = AUTOINCREM');
      Add('WHERE FDO_NUMDOC = :NUMDOC AND FDO_ESPDOC = :ESPDOC AND FDO_CODEMP = :CODEMP');

      ParamByName('NUMDOC').AsString := strNumdoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;

      Open;

      Result := Not IsEmpty;
