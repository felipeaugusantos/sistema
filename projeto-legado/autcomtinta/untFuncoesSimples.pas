Procedure pRetImpostosItem(    strCodIte: String;
                           Var fltIcmSai,
                               fltOutVal,
                               fltDesOpe,
                               fltImpFed: Double;
                               cdsIteGer: TUniClientDataSet = Nil);
  var
    qryGen: TUniQuery;
    dtsIteger: TDataSet;
Begin
  qryGen := Nil;

  If (Not Assigned(cdsIteGer)) Or
     (Not cdsIteGer.Locate('ITE_CODITE;ITE_CODEMP', VarArrayOf([strCodIte, VS_strCodEmp]), [])) Then
  Begin

    qryGen := fCriaQuery;

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(fSqlCdsIteger);
      ParamByName('CODITE').AsString := strCodIte;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      Open;

      If Assigned(cdsIteger) Then
        pIncluiIteger(cdsIteger, qryGen);

    End;
  End;

  If Assigned(cdsIteger) Then
    dtsIteger := cdsIteger
  Else
    dtsIteger := qryGen;

  With dtsIteger Do
  Begin
    If IsEmpty Then
    Begin
      fltIcmSai := 0;
      fltOutVal := 0;
      fltDesOpe := 0;
      fltImpFed := 0;
    End Else
    Begin
      fltIcmSai := FieldByName('ITE_ICMSAI').AsFloat;
      fltOutVal := FieldByName('ITE_OUTVAL').AsFloat;
      fltDesOpe := FieldByName('ITE_DESOPE').AsFloat;
      fltImpFed := FieldByName('ITE_IMPFED').AsFloat;
    End;
  End;

  If Assigned(qryGen) Then
    FreeAndNil(qryGen);
End;

Procedure pDisableControls(dtsDataSet: TDataSet; Var prcScroll: TprcScroll);
Begin
  With dtsDataSet Do
  Begin
    prcScroll := AfterScroll;
    AfterScroll := Nil;
    DisableControls;
  End;
End;

Procedure pEnableControls(dtsDataSet: TDataSet; Var prcScroll: TprcScroll; blnRefresh: Boolean = False);
Begin
  With dtsDataSet Do
  Begin
    EnableControls;
    AfterScroll := prcScroll;
    If blnRefresh then
      AfterScroll(dtsDataSet)
  End;
End;

Procedure pCloneDataSet(dtsDestino, dtsOrigem: TUniClientDataSet; blnComFomatacao: Boolean = False);
  Var
    intContador: Integer;
    prcScroll: TprcScroll;
Begin

  Try
    pDisableControls(dtsOrigem, prcScroll);

    dtsDestino.Data := dtsOrigem.Data;

    dtsDestino.LogChanges := False;

    If blnComFomatacao Then
    Begin
      For intContador := 0 To dtsOrigem.FieldCount -1 Do
      Begin
        dtsDestino.Fields[intContador].DisplayLabel := dtsOrigem.Fields[intContador].DisplayLabel;

        If dtsDestino.Fields[intContador].DataType = ftFloat Then
          TFloatField(dtsDestino.Fields[intContador]).DisplayFormat := TFloatField(dtsOrigem.Fields[intContador]).DisplayFormat;

      End;
    End;

  Finally
    pEnableControls(dtsOrigem, prcScroll);
  End;

End;

