function fGetTotalDuplicatas(duplicatas: TarrDuplicata; opcao: TOpcaoDuplicata): Double;
  Var
    duplicata: TArrDigDuplic;
begin
  Result := 0;
  For duplicata In duplicatas Do
  Begin
    If fEmptyStr(duplicata.dtaDtaVen) Then
      Continue;

    If opcao = dupTodas Then
      Result := Result + duplicata.curValor

    Else If (opcao = dupVista) And (strToDateDef(duplicata.dtaDtaVen, 0) = VS_Date) Then
      Result := Result + duplicata.curValor

    Else If (opcao = dupPrazo) And (strToDateDef(duplicata.dtaDtaVen, 0) <> VS_Date) Then
      Result := Result + duplicata.curValor;
  End;
end;


