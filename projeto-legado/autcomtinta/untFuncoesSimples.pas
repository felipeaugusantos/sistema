    End;
  End;
end;

procedure pCriarCfgSis(strCodCfg: String; strDesCfg: String; strGruCfg: String; strValCfg: String);
Var
  qryGen: TUniQuery;
  strSQL   : String;
Begin
  Try
    strSQL := '';
    strSQL := strSQL + ' SELECT  *                  ';
    strSQL := strSQL + ' FROM                       ';
    strSQL := strSQL + '   CFGSIS                   ';
    strSQL := strSQL + ' WHERE                      ';
    strSQL := strSQL + '   SIS_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '   SIS_CODCFG = :CODCFG     ';

    qryGen := fCriaQuery;
    qryGen.Close;
    qryGen.SQL.Clear;
    qryGen.SQL.Add(strSQL);
    qryGen.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryGen.ParamByName('CODCFG').AsString := strCodCfg;
    qryGen.Open;

    If qryGen.IsEmpty Then
    Begin
      qryGen.Insert;
      qryGen.FieldByName('SIS_CODEMP').AsString := VS_strCodEmp;
      qryGen.FieldByName('SIS_CODCFG').AsString := strCodCfg;
      qryGen.FieldByName('SIS_DESCRI').AsString := strDesCfg;
      qryGen.FieldByName('SIS_VALCFG').AsString := strValCfg;
      qryGen.FieldByName('SIS_GRUCFG').AsString := strGruCfg;
      qryGen.FieldByName('SIS_NUMHLP').AsString := '0';
      qryGen.Post;
    End;

  Finally
    FreeAndNil(qryGen);
  End;
End;

procedure pEncerrarAplicacaoPorInconsitenciaCodEmp(strCamCfg: String; blnTerminar: Boolean);
  Var
    intParam: Integer;
    strParam: String;
    strConnID : String;
    strVersionTitle : String;
    objConnection : TUniConnection;
begin
  strParam := '';

  If ParamCount > 0 Then
  Begin
    For intParam := 0 To ParamCount Do
      strParam := strParam + ' ' + ParamStr(intParam);
  End;

{$IFNDEF LINUX}
  If blnTerminar Then
  Begin
    fRollBack;
    fMensagem('Atenção','Uma rotina está sendo executada sem a definição da empresa!' + #13 +
                        'Por favor entre em contato imediatamente com a Citel para devidas correções! A aplicação será encerrada!', ['&Ok']);
  End;
{$ENDIF LINUX}

  strConnID := VS_LastConnID;
  If fEmptyStr(strConnID) Then
  Begin
    Try
      objConnection := Nil;
      If Assigned(frmModulo) Then
        objConnection := frmModulo.GetCurrentConnection;
      If Assigned(objConnection) And (objConnection.Connected) Then
        strConnID := fGetConnectionID(objConnection);
    Except
      strConnID := '';
    End;
  End;

  strVersionTitle := 'AutcomTinta';
  If Assigned(frmModulo) And (Not fEmptyStr(frmModulo.VersionTitle)) Then
    strVersionTitle := frmModulo.VersionTitle;

  pGravarErro(True, '<CFGSIS_CODEMP_VAZIO>', 'Configuração.: ' + 'CFG_' + strCamCfg + sLineBreak +
                                             'Parâmetros...: ' + strParam + sLineBreak +
                                             'Connection Id: ' + strConnID + sLineBreak +
                                             'Version Title: ' + strVersionTitle + sLineBreak +
                                             'Rotina.......: ' + #13 + fRetornaStack);

{$IFNDEF LINUX}
  If blnTerminar Then
  Begin
    TFinalizarAutcomMonitor.Monitorar;
    If (Not TerminateProcess(GetCurrentProcess, 0)) Then
      Application.Terminate;
  End;
{$ENDIF LINUX}
end;

function fCfgSisL(strCamCfg: String;  varTipVar: TVarType = varString; strCodEmp: String = '';
                  dicCfgSis: TDictionary<string,string> = Nil): Variant;
  Var
    qryGenCfg: TUniQuery;
    strValCfg: String;
    strSQL   : String;
    strRes   : String;
    strAux   : String;
    strCodEmpCfg: String;

  procedure pSetaEmpresaCfg;
  begin
    strCodEmpCfg := '';

    If (Not fEmptyStr(strCodEmp)) Then
    Begin
      strCodEmpCfg := strCodEmp;
    End;

    If fEmptyStr(strCodEmpCfg) Then
      strCodEmpCfg := VS_strCodEmp;
  End;

  procedure pRetornaArmazenaValCfg(AstrCamCfg: String='');
    Var
      LstrCamCfg: String;
  begin
    LstrCamCfg := strCamCfg;
    If (LeftStr(AstrCamCfg, 4) = 'CFG_') Then
      LstrCamCfg := Copy(AstrCamCfg, 5, Length(AstrCamCfg));

    {**********************************************************}
    {* VALIDAÇÃO PARA TESTAR SE JÁ É UMA CHAVE CRIPTROGRAFADA *}
    {********************************************************VA}
    strRes := qryGenCfg.FieldByName('SIS_VALCFG').AsString;
    If Pos(qryGenCfg.FieldByName('SIS_CODCFG').AsString, consChavesCript) > 0 Then
    Begin
      strAux:=fDecrypt(strRes);
      If fCrypt(strAux) = strRes Then
        strRes := fDecrypt(strRes)
    End
    Else If Pos(qryGenCfg.FieldByName('SIS_CODCFG').AsString, consCFGSQueValidaIMG) > 0 Then
    Begin
      strRes := fRetPathSeImagemValida(strRes);
    End;

    If Assigned(dicCfgSis) Then
      dicCfgSis.AddOrSetValue(LstrCamCfg + strCodEmpCfg, strRes);
  end;

begin
  pSetaEmpresaCfg;

  Try
    qryGenCfg := Nil;

    If Not fEmptyStr(strCamCfg) Then
    Begin
      If (Not Assigned(dicCfgSis)) Or (not dicCfgSis.ContainsKey(strCamCfg + strCodEmpCfg)) Then
      Begin
        If fEmptyStr(strCodEmpCfg) Then
        Begin
          Try
            pEncerrarAplicacaoPorInconsitenciaCodEmp(strCamCfg, False);
          Except
            //
          End;
        End;

        qryGenCfg := fCriaQuery;

        If Assigned(dicCfgSis) And Assigned(dicConfigInicial) And (Not fEmptyStr(strLoginUsuarioLogado)) Then
        Begin
          If (dicConfigInicial.Count = 0) Then
          Begin
            strSQL := '';
            strSQL := strSQL + ' SELECT                      ';
            strSQL := strSQL + '   SIS_CODCFG,               ';
            strSQL := strSQL + '   SIS_VALCFG                ';
            strSQL := strSQL + ' FROM                        ';
            strSQL := strSQL + '   CFGSIS                    ';
            strSQL := strSQL + ' WHERE                       ';
            strSQL := strSQL + '   SIS_CODEMP = :CODEMP AND  ';
            strSQL := strSQL + '   SIS_CODCFG IN (SELECT DISTINCT REPLACE(DIC_KEYDIC, CONCAT(DIC_TIPDIC,"|"), "") FROM DICSIS WHERE DIC_TIPDIC = :TIPDIC AND DIC_PIDMD5 = :PIDMD5) ';

            With qryGenCfg Do
            Begin
              Close;
              SQL.Clear;
              SQL.Add(strSQL);

              ParamByName('CODEMP').AsString := strCodEmpCfg;
              ParamByName('TIPDIC').AsString := 'LOG';                 // = consTagLogCodCfg
              ParamByName('PIDMD5').AsString := StringOfChar('0', 32); // = VS_PidGenerico_
              Open;

              qryGenCfg.First;
              While Not qryGenCfg.Eof Do
              Begin
                pRetornaArmazenaValCfg(qryGenCfg.FieldByName('SIS_CODCFG').AsString);

                dicConfigInicial.AddOrSetValue(FieldByName('SIS_CODCFG').AsString, False); //False = PARA GRAVAR "NÂO" NA DICSIS

                qryGenCfg.Next;
              End;
            End;
          End;
        End;

        strSQL := '';
        strSQL := strSQL + ' SELECT  SQL_NO_CACHE       ';
        strSQL := strSQL + '   SIS_CODCFG,              ';
        strSQL := strSQL + '   SIS_VALCFG              ';
        strSQL := strSQL + ' FROM                       ';
        strSQL := strSQL + '   CFGSIS                   ';
        strSQL := strSQL + ' WHERE                      ';
        strSQL := strSQL + '   SIS_CODEMP = :CODEMP AND ';
        strSQL := strSQL + '   SIS_CODCFG = :CODCFG     ';

        With qryGenCfg Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);

          ParamByName('CODEMP').Value := strCodEmpCfg;
          ParamByName('CODCFG').Value := 'CFG_' + strCamCfg;
          Open;

          If IsEmpty Then
          Begin
            If fNaoCriarConfiguracoes(strCamCfg) Then
            Begin
              fMensagem('ATENÇÃO', 'A configuração ( ' + 'CFG_' + strCamCfg + ' ) não existe na empresa ' + strCodEmpCfg + '.' + sLineBreak +
               'Entre em contato com a CITEL para resolvermos o problema.', ['&Ok']);
              FreeAndNil(qryGenCfg);
              Exit('');
            End;
          End;

          If IsEmpty Then
            if (not fCriarConfiguracoes('CFG_' + strCamCfg, strCodEmpCfg)) then
              Raise Exception.Create('A configuração ( ' + 'CFG_' + strCamCfg + ' ) não existe na empresa ' + strCodEmpCfg + '.');

          If IsEmpty Then
          Begin
            Close;
            Open;
          End;

          pRetornaArmazenaValCfg;

          If (Assigned(dicConfigInicial)) And (Not fEmptyStr(strLoginUsuarioLogado)) Then
          Begin
            If (Not dicConfigInicial.ContainsKey(FieldByName('SIS_CODCFG').AsString)) Then
              dicConfigInicial.AddOrSetValue(FieldByName('SIS_CODCFG').AsString, True); //True = PARA GRAVAR NA DICSIS SESSÃO "LOG"
          End;
        End;
      End;

      If Assigned(dicCfgSis) Then
        strValCfg := dicCfgSis[strCamCfg + strCodEmpCfg]
      Else
        strValCfg := strRes;

      Case varTipVar Of
        varString : Result := strValCfg;

        varInteger, varSmallint, varSingle, varByte, varShortInt, varInt64:
                    Begin
                      Try
                        If fEmptyStr(strValCfg) Then
                          Result := 0
                        Else
                          Result := strToInt(strValCfg);
                      Except
                        Result := 0;
                      End;
                    End;

        varDouble, varCurrency:
                    Begin
                      Try
                        If fEmptyStr(strValCfg) Then
                          Result := 0.00
                        Else
                          Result := fStrToFloat(AnsiReplaceStr(strValCfg, '.', ','));
                      Except
                        Result := 0.00;
                      End;
                    End;

        varDate:
                    Begin
                      Try
                        If fEmptyStr(strValCfg) Then
                          Result := 0
                        Else
                          Result := strToDate(strValCfg);
                      Except
                        Result := 0;
                      End;
                    End;

        varBoolean:
                   Begin
                     Try
                       If fEmptyStr(strValCfg) Then
                         Result := False
                       Else If Pos(strValCfg, 'S_N_') > 0 Then
                         Result := StrToBool(IfThen(strValCfg = 'S', 'True', 'False'))

                       Else If Pos(strValCfg, '0_1_') > 0  Then
                         Result := StrToBool(IfThen(strValCfg = '1', 'True', 'False'))
                       Else
                         Result := (Length(strValCfg) > 0) And CharInSet(strValCfg[1], ['T', 't', 'Y', 'y']);

                     Except
                       Result := False;
                     End;

                   End;

        Else
