function fValidaGerSubVen(blnLib: Boolean; strTipo: Char; edtCod, edtDes: TEditFocus; strTitulo:String=''): Boolean;
  Var
    strCodOpe: String;
    strTitOpe: String;

    Function fRetCodOpeSeEhGerOuSubOuRep:String;
      Var
        strCodOpeAux: String;
    Begin
      Result:='';
      If Not fEmptyStr(edtCod.Text) Then
      Begin
        strCodOpeAux := edtCod.Text;

        If blnLib Then
          strCodOpeAux := fRetSenhaVendedor(edtCod.Text);

        Result := fRetCodVendedor(strCodOpeAux, strTipo='G', strTipo='S', strTipo='R');
      End;
    End;

Begin

  Result := False;

  Case strTipo Of
    'G': strTitOpe := IfThen(fEmptyStr(strTitulo), 'Gerente', strTitulo);
    'S': strTitOpe := IfThen(fEmptyStr(strTitulo), 'Sub-Gerente', strTitulo);
    'R': strTitOpe := IfThen(fEmptyStr(strTitulo), IfThen(fCfgSis('VENMET') = '1', 'Representante', 'Representante (E)'), strTitulo);
   Else
    strTitOpe := IfThen(fEmptyStr(strTitulo), 'Vendedor', strTitulo);
  End;

  If (Not blnLib) Then
  Begin
    edtDes.Text := '';

    If fEmptyStr(edtCod.Text) Then
    Begin
      fMensagem('AVISO', 'O '+strTitOpe+' deve ser preenchido!', ['&O k']);
      Exit;
    End;

    strCodOpe := fRetCodVendedor(edtCod.Text);

    If (fEmptyStr(strCodOpe)) Or (Not fOperadorAtivo(strCodOpe)) Then
    Begin
      fMensagem('AVISO', strTitOpe+' não encontrado!', ['&O k']);
      Exit;
    End
    Else
    Begin
      If CharInSet(strTipo, ['G','S','R']) Then
      Begin
        strCodOpe := fRetCodOpeSeEhGerOuSubOuRep;
      End;

      If fEmptyStr(strCodOpe) Then
      Begin
        fMensagem('AVISO', 'Operador informado não é um '+strTitOpe+'!', ['&O k']);
        Exit;
      End;
    End;

    edtDes.Text := fRetNomeOperador(strCodOpe);
  End
  Else
  Begin
    {*************************************************************************}
    {* SÓ VALIDA SE O OPERADOR DIGITADO (SEM PASSAR PELA PESQUISA) É GERENTE *}
    {* OU SUB-GERENTE CASO CONTRARIO AS VALIDAÇÕES FICAM POR CONTA DOS       *}
    {* RESPECTIVOS pEdtCodSelectExit                                         *}
    {**********************************************************************VA*}
    If (edtCod.Text <> '000') And CharInSet(strTipo, ['G','S','R']) Then
    Begin
      strCodOpe := fRetCodOpeSeEhGerOuSubOuRep;

      If (Not fEmptyStr(fRetNomeOperador(edtCod.Text))) And fEmptyStr(strCodOpe) Then
      Begin
        edtDes.Text:='';
        fMensagem('AVISO', 'Operador informado não é um '+strTitOpe+'!', ['&O k']);
        Exit;
      End;
    End;

    Result := True;
    Exit;
  End;

  Result := Not fEmptyStr(edtDes.Text);
End;

{************************************}
{* RETORNA A COMISSÃO DE ACORDO COM *}
{* AS MARGENS CADASTRADAS           *}
{*********************************AF*}
function fRetPerComMargem(fltValor: Double; strTipVen: String = ''; strConPag : String = ''): Double;
  Var
    strSQL   : String;
    qryGenCom: TUniQuery;
//    blnNegativo: Boolean;
Begin
  Try

    Result := 0;

//    blnNegativo := (fltValor < 0);
    //fltValor := Abs(fltValor); {***RV***}

    qryGenCom := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADCOM ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  :VALOR >= COM_PERINI AND ';
    strSQL := strSQL + '  :VALOR <= COM_PERFIN ';

    If (fCfgSis('OPCCOM') = 'PD') And (not fEmptyStr(strTipVen)) Then
      strSQL := strSQL + '  AND COM_TIPVEN = :TIPVEN ';


    With qryGenCom Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('VALOR').AsFloat := RoundTo(fltValor, -2);

      If (fCfgSis('OPCCOM') = 'PD') And (not fEmptyStr(strTipVen)) Then
        ParamByName('TIPVEN').AsString := strTipVen;

      Open;

      If Not IsEmpty Then
      Begin
        If (fStatusCndPag(strConPag) = A_VISTA) Then
          Result := FieldByName('COM_PERCOM').AsFloat
        Else
          Result := FieldByName('COM_PERCOP').AsFloat;
      End;

      Close;
    End;

    //If blnNegativo Then  {***RV***}
    //  Result := -Result;

  Finally
    FreeAndNil(qryGenCom);
  End;

End;

function fRetPerComOpeMargem(fltCusto, fltVenda : Double; strCodOpe : String): Double;
