  strSQL := strSQL + '     MOE_DOLVEN,    ';
  strSQL := strSQL + '     MOE_REACOM,    ';
  strSQL := strSQL + '     MOE_REAVEN,    ';
  strSQL := strSQL + '     MOE_PARCOM,    ';
  strSQL := strSQL + '     MOE_PARVEN,    ';
  strSQL := strSQL + '     MOE_EURCOM,    ';
  strSQL := strSQL + '     MOE_EURVEN,    ';
  strSQL := strSQL + '     MOE_GUACOM,    ';
  strSQL := strSQL + '     MOE_GUAVEN,    ';
