    1:   Result := 'A';
    2:   Result := 'P';
    Else Result := '';
  End;
End;

Function fMotivoEntFutToIndex(strSigMot: String): Integer;
Begin
  If fEmptyStr(strSigMot) Then
  Begin
    Result := -1;
  End Else
    Case strSigMot[1] Of
      'F': Result := 0;
      'A': Result := 1;
      'P': Result := 2;
      Else Result := -1;
    End;
End;

Function fMotivoSiglaToEntFut(strSigMot: String): String;
Begin
  If strSigMot = 'P' Then
    Result := 'Previsão de Entrega'
  Else If strSigMot = 'A' Then
    Result := 'Aguardando Cliente'
  Else If strSigMot = 'F' Then
    Result := 'Falta Produto'
  Else
    Result := '';
End;

