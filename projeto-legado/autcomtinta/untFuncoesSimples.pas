function fRetGrandeTotalAntReducaoZ(strCodEcf, strQtdRdz: String; var strNroCoo: String): Double;
Var
  strSQL: String;
  qryRDZ: TUniQuery;
Begin

  Try

    qryRDZ := fCriaQuery(Nil);

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '  RDZ_GRTATU, ';
    strSQL := strSQL + '  RDZ_NROCOO  ';
    strSQL := strSQL + 'FROM     ';
    strSQL := strSQL + '  CADRDZ ';
    strSQL := strSQL + 'WHERE    ';
    strSQL := strSQL + '  RDZ_CODECF = :CODECF AND ';
    strSQL := strSQL + '  RDZ_QTDRDZ = (SELECT MAX(RDZ_QTDRDZ) FROM CADRDZ ';
    strSQL := strSQL + '                 WHERE RDZ_CODECF = :CODECF AND    ';
    strSQL := strSQL + '                       RDZ_QTDRDZ < :QTDRDZ)       ';

    With qryRDZ Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODECF').AsString := strCodEcf;
      ParamByName('QTDRDZ').AsString := strQtdRdz;
      Open;
      Result    := FieldByName('RDZ_GRTATU').AsFloat;
      strNroCoo := FieldByName('RDZ_NROCOO').AsString;
    End;

  Finally
    FreeAndNil(qryRDZ);
  End;

End;

