function fRetNumRom(Var strCodEmp: String; blnEmpRom: Boolean; strNumDoc, strEspDoc, strCodCli: String): String;
  Var
    qryAux: TUniQuery;
Begin
  Result := '';

  qryAux := fCriaQuery(Nil);
  With qryAux, SQL Do
  Begin
    Add('SELECT SQL_NO_CACHE        ');
    Add('  GER_NUMROM,              ');
    Add('  GER_EMPROM               ');
    Add('FROM                       ');
    Add('  ROMGERX                  ');
    Add('WHERE                      ');
    Add('  GER_NUMDOC = :NUMDOC AND ');
    Add('  GER_ESPDOC = :ESPDOC AND ');

    If blnEmpRom Then
      Add('  GER_EMPROM = :CODEMP AND ')
    Else
      Add('  GER_CODEMP = :CODEMP AND ');

    Add('  GER_CODCLI = :CODCLI     ');

    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := strCodEmp;
    ParamByName('CODCLI').AsString := strCodCli;

    Open;

    If Not IsEmpty Then
    Begin
      strCodEmp := FieldByName('GER_EMPROM').AsString;
      Result    := FieldByName('GER_NUMROM').AsString;
    End;

  End;

  FreeAndNil(qryAux);
End;

