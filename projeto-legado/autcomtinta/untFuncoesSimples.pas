      SQL.Add('   FROM FATDOR                ');
      SQL.Add('  WHERE FDO_NUMDOC = :NUMDOC  ');
      SQL.Add('    AND FDO_ESPDOC = "PD"     ');
      SQL.Add('    AND FDO_CODEMP = :CODEMP  ');
      SQL.Add('    AND FDO_CODITE <> :ITESER ');
      SQL.Add('    AND FDO_CODITE <> :SERTER ');
      ParamByName('NUMDOC').AsString := strNumDoc;
