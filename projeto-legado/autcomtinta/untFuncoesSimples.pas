function fComplementoWhereSQLPosContabilCheque(strCodEmp: String): String;
Begin
  Result := '';

  {**********************************}
  {* OS FILTROS ABAIXO DEVEM BATER  *}
  {* COM O RELATÓRIO DE BOLETIM     *}
  {* DIÁRIO DE ACOMPANHAMENTO, SE   *}
  {* ALTERAR FAVOR VERIFICAR.       *}
  {*******************************AF*}
  Result := Result + '  (  ';

  Result := Result + '  ((CHQ_DTACAD <= :DTAFIN) AND ';
  Result := Result + '   (CHQ_DTADEP IS NULL)        ';
  Result := Result + '   ) ';

  Result := Result + ' OR ';

  Result := Result + '  ((CHQ_DTACAD <= :DTAFIN) AND ';
  Result := Result + '   (CHQ_DTADEP >  :DTAFIN)) ';

  Result := Result + ' OR ';

  Result := Result + '  ((CHQ_DTADEP IS NOT NULL) AND ';
  Result := Result + '   (CHQ_DTADEV <= :DTAFIN)  AND ';
  Result := Result + '   (CHQ_DTADP2 IS NULL)     AND ';
  Result := Result + '   (CHQ_DTADV2 IS NULL)) ';

  Result := Result + ' OR ';

  Result := Result + '  ((CHQ_DTADEP IS NOT NULL) AND ';
  Result := Result + '   (CHQ_DTADEV <= :DTAFIN)  AND ';
  Result := Result + '   (CHQ_DTADP2  > :DTAFIN))     ';

  Result := Result + '  )  ';

  If Not fEmptyStr(strCodEmp) Then
    Result := Result + '  AND LOCATE(CHQ_CODEMP, :CODEMP) > 0 '
  Else
    Result := Result + '  AND LOCATE(CHQ_CODEMP,' + QuotedStr(strEmpAcessoUsuarioLogado) + ') > 0 ';
End;

