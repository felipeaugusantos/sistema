function fClienteEmCampanha(strCodCli: String) : Boolean;
  Var
    qryTmp: TUniQuery;
    strSQL: String;
Begin

  Result := False;

  qryTmp := fCriaQuery;

  strSQL := '';
  strSQL := strSQL + 'SELECT  ';
  strSQL := strSQL + '  CMG_CODCLI ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  CAMGER ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  CMG_CODCLI = :CODCLI AND ';
  strSQL := strSQL + '  :DTAATU BETWEEN CMG_DTAINI AND CMG_DTAFIN ';

  With qryTmp Do
    Begin

      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      ParamByName('CODCLI').AsString   := strCodCli;
      ParamByName('DTAATU').AsDateTime := VS_Date;

      Open;

      If Not IsEmpty Then
      Begin

        Result := True;
        Close;
        FreeAndNil(qryTmp);
        Exit;

      End;

      Close;

    End;

  strSQL := '';
  strSQL := strSQL + 'SELECT  ';
  strSQL := strSQL + '  CLI_CODRED ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  CAMGER, ';
  strSQL := strSQL + '  CADCLI, ';
  strSQL := strSQL + '  CADRED ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  CLI_CODCLI = :CODCLI AND ';
  strSQL := strSQL + '  CLI_CODRED = RED_CODRED AND ';
  strSQL := strSQL + '  CMG_CODRED = RED_CODRED AND ';
  strSQL := strSQL + '  (:DTAATU >= CMG_DTAINI AND :DTAATU <= CMG_DTAFIN) ';

  With qryTmp Do
    Begin

      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      ParamByName('CODCLI').AsString   := strCodCli;
      ParamByName('DTAATU').AsDateTime := VS_Date;

      Open;

      If Not IsEmpty Then
      Begin

        Result := True;
        Exit;

      End;

      Close;

    End;

  FreeAndNil(qryTmp);

End;

function fRetTipoDepartamentoVarios(strTipo: String): String;
  Var
    strSQL   : String;
    qryGenDpt: TUniQuery;
    intCont  : Integer;

begin
  Try
    intCont   := 1;
    qryGenDpt := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '      DEP_CODIGO    ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADDEP ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  DEP_' + strTipo + ' = "S" ';

    With qryGenDpt Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      Open;

      If Not IsEmpty Then
      Begin
        First;
        While Not Eof Do
        Begin

          If intCont = 1 then
            Result := QuotedStr(FieldByName('DEP_CODIGO').AsString)
          Else
            Result := Result + ',' + QuotedStr(FieldByName('DEP_CODIGO').AsString);

          intCont := intCont + 1;
          Next;
        End;
      End
      Else
        Result := QuotedStr('N');
      Close;
    End;

  Finally
    FreeAndNil(qryGenDpt);
  End;
End;

