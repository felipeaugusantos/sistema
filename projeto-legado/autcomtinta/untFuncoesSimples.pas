        strSQL:=strSQL+'   CON_PERTRA ';
        strSQL:=strSQL+' FROM ';
        strSQL:=strSQL+'   CONEMP ';
        strSQL:=strSQL+' WHERE ';
        strSQL:=strSQL+'   CON_EMPORI = :EMPORI AND CON_EMPDES = :EMPDES ';

