Function fRetClienteConsumidor(strEstado:String = ''): String;
  Var
    qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Nil);
  With qryAux, SQL Do
  Begin
    Add('SELECT ');
    Add('  CLI_CODCLI ');
    Add('FROM ');
    Add('  CADCLI INNER JOIN CADCID ON CLI_CODCID = CID_CODCID');
    Add('WHERE ');
    Add('  CLI_NOMCLI LIKE "%CONSUMIDOR%" ');

    If Not fEmptyStr(strEstado) Then
      Add('AND CID_ESTADO = :ESTADO ');

    Add('LIMIT 1 ');

    If Not fEmptyStr(strEstado) Then
      ParamByName('ESTADO').AsString := strEstado;

    Open;

    If IsEmpty Then
      Result := ''
    Else
      Result := FieldByName('CLI_CODCLI').AsString;

    Close;
  End;

  FreeAndNil(qryAux);
End;

function fRetConsumidorDocumento(strNumDoc, strEspDoc, strCodEmp: String): String;
  Var
    strSQL: String;
    qryAux: TUniQuery;
begin
  strSQL := '';
  strSQL := strSQL + 'SELECT                     ';
  strSQL := strSQL + '  GER_NOMCON               ';
  strSQL := strSQL + 'FROM                       ';
  strSQL := strSQL + '  MOVGER                   ';
  strSQL := strSQL + 'WHERE                      ';
  strSQL := strSQL + '  GER_CODEMP = :CODEMP AND ';
  strSQL := strSQL + '  GER_NUMDOC = :NUMDOC AND ';
  strSQL := strSQL + '  GER_ESPDOC = :ESPDOC AND ';
  strSQL := strSQL + '  GER_TIP_FC = "C"         ';
  qryAux := fCriaQuery(Nil);
  With qryAux, SQL Do
  Begin
    Close;
    Text := strSQL;
    ParamByName('CODEMP').AsString := strCodEmp;
    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    Open;
    If IsEmpty Then
      Result := ''
    Else
      Result := FieldByName('GER_NOMCON').AsString;
  End;
  FreeAndNil(qryAux);
end;

Procedure pCopiaClientDataSet(cdsOrigem, cdsDestino: TUniClientDataSet);
  Var
    intContador: Integer;
Begin
  cdsDestino.Data := cdsOrigem.Data;

  For intContador := 0 To cdsOrigem.FieldCount -1 Do
  Begin
    cdsDestino.Fields[intContador].DisplayLabel := cdsOrigem.Fields[intContador].DisplayLabel;

    If cdsDestino.Fields[intContador].DataType = ftFloat Then
      TFloatField(cdsDestino.Fields[intContador]).DisplayFormat := TFloatField(cdsOrigem.Fields[intContador]).DisplayFormat;

  End;
End;

function fTamanhoArquivo(strArquivo: String): Cardinal;
  Var
    FHandle: Cardinal;

begin
  FHandle := CreateFile(PChar(strArquivo), GENERIC_READ,
    FILE_SHARE_READ Or FILE_SHARE_WRITE Or FILE_SHARE_DELETE, Nil,
    OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0);

  If FHandle <> 0 Then
    Result := GetFileSize(FHandle, Nil)
  Else
    Result := 0;

  FileClose(FHandle);
end;

function fTrataStr(const strValor: String): String;
begin
  Result := Trim(StrPas(PChar(strValor)));
end;

function fGetSQLInEmpresasAcesso(strAlias: String; strAcesso: String = ''): String;
  Var
    strEmpresa: String;
    stlEmpresas: TStringList;
begin
  If fEmptyStr(strAcesso) Then
    strAcesso := strEmpAcessoUsuarioLogado;

  stlEmpresas := TStringList.Create;
  stlEmpresas.Text := AnsiReplaceStr(strAcesso, '_', #13#10);

  Result := '';

  For strEmpresa In stlEmpresas Do
  Begin
    If Result <> '' Then
      Result := Result + ', ';
    Result := Result + QuotedStr(strEmpresa);
  End;

  If Result = '' Then
    Result := QuotedStr('');

  Result := ' ' + strAlias + ' IN (' + Result + ') ';

  FreeAndNil(stlEmpresas);
end;

function fValidaAcessoMultSelEmpresa(arrSelecao: TConsultasArray; Var strEmpNegadas: String): Boolean;
Var intCont: Integer;
begin
  Result := True;
  strEmpNegadas := '';

  For intCont := 0 to Length(arrSelecao)-1 do
  Begin
    If Pos(arrSelecao[intCont].strCodigo, strEmpAcessoUsuarioLogado) <= 0 Then
    Begin
      strEmpNegadas := strEmpNegadas + arrSelecao[intCont].strCodigo + '-';
      Result := False;
    End;
  End;

  If Not fEmptyStr(strEmpNegadas) Then
    strEmpNegadas := LeftStr(strEmpNegadas, Length(strEmpNegadas)-1) + '.';

end;

function fGravaLogLocFisica(strCodIte, strInfAnt, strInfNov: String; intTipAlt: Integer; strNumLote: String): Boolean;
Var
  strSQL   : String;
  qryGenLoc: TUniQuery;
Begin
  Try

    qryGenLoc := fCriaQuery(Nil);

    strSQL := '';
    strSQL := strSQL + 'INSERT INTO ';
    strSQL := strSQL + ' LOGLOC (AUTOINCREM,  ';
    strSQL := strSQL + '         LOC_CODEMP,  ';
    strSQL := strSQL + '         LOC_DTAALT,  ';
    strSQL := strSQL + '         LOC_HRAALT,  ';
    strSQL := strSQL + '         LOC_OPEALT,  ';
    strSQL := strSQL + '         LOC_CODITE,  ';
    strSQL := strSQL + '         LOC_INFANT,  ';
    strSQL := strSQL + '         LOC_TIPALT,  ';
    strSQL := strSQL + '         LOC_INFNOV,  ';
    strSQL := strSQL + '         LOC_NUMLOT)  ';
    strSQL := strSQL + ' VALUES (:AUTOIN,     ';
    strSQL := strSQL + '         :CODEMP,     ';
    strSQL := strSQL + '         :DTAALT,     ';
    strSQL := strSQL + '         :HRAALT,     ';
    strSQL := strSQL + '         :OPEALT,     ';
    strSQL := strSQL + '         :CODITE,     ';
    strSQL := strSQL + '         :INFANT,     ';
    strSQL := strSQL + '         :TIPALT,     ';
    strSQL := strSQL + '         :NUMLOT)     ';

    With qryGenLoc Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      ParamByName('AUTOIN').AsString  := fRetAutoIncrem('LOGLOC',VS_strCodEmp);
      ParamByName('CODEMP').AsString  := VS_strCodEmp;
      ParamByName('DTAALT').AsDate    := VS_Date;
      ParamByName('HRAALT').AsTime    := fTime();
      ParamByName('OPEALT').AsString  := strLoginUsuarioLogado;
      ParamByName('CODITE').AsString  := strCodIte;
      ParamByName('INFANT').AsString  := strInfAnt;
      ParamByName('INFNOV').AsString  := strInfNov;
      ParamByName('TIPALT').AsInteger := intTipAlt;
      ParamByName('NUMLOT').AsString  := strNumLote;

      ExecSQL;
      Result := True;
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message,'[fGravaLogLocFisica]');
    End;
  End;

  FreeAndNil(qryGenLoc);

End;

