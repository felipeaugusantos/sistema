function fRetTipoImposto(strCodImp: String): String;
Begin
  If (strCodImp = 'T') Then
    Result := 'T    ·OPERAÇÕES TRIBUTADAS PELO ICMS'
  Else If (strCodImp = 'S') Then
    Result := 'S    ·TRIBUTADAS PELO ISSQN'
  Else If (strCodImp = 'F') Then
    Result := 'F    ·TRIBUTADAS POR SUBSTITUIÇÃO TRIBUTÁRIA'
  Else If (strCodImp = 'I') Then
    Result := 'I    ·ISENTAS DO ICMS'
  Else If (strCodImp = 'N') Then
    Result := 'N    ·NÃO INCIDÊNCIA DO ICMS'
  Else If (strCodImp = 'FS') Then
    Result := 'FS   ·SUJEITAS AO ISSQN, TRIBUTADAS POR SUBSTITUIÇÃO TRIBUTÁRIA'
  Else If (strCodImp = 'IS') Then
    Result := 'IS   ·VALORES DE OPERAÇÕES ISENTAS DO ISSQN'
  Else If (strCodImp = 'NS') Then
    Result := 'NS   ·VALORES DE OPERAÇÕES COM NÃO INCIDÊNCIA DO ISSQN'
  Else If (strCodImp = 'OPNF') Then
    Result := 'OPNF ·OPERAÇÕES NÃO FISCAIS'
  Else If (strCodImp = 'DT') Then
    Result := 'DT   ·DESCONTO DE ICMS'
  Else If (strCodImp = 'DS') Then
    Result := 'DS   ·DESCONTO DE ISSQN'
  Else If (strCodImp = 'DO') Then
    Result := 'DO   ·DESCONTO DE OPERAÇÕES NÃO FISCAIS'
  Else If (strCodImp = 'AT') Then
    Result := 'AT   ·ACRÉSCIMOS DE ICMS'
  Else If (strCodImp = 'AS') Then
    Result := 'AS   ·ACRÉSCIMO DE ISSQN'
  Else If (strCodImp = 'AO') Then
    Result := 'AO   ·ACRÉSCIMO DE OPERAÇÕES NÃO FISCAIS'
  Else If (strCodImp = 'CAN-T') Then
    Result := 'CAN-T·CANCELAMENTO DE ICMS'
  Else If (strCodImp = 'CAN-S') Then
    Result := 'CAN-S·CANCELAMENTO DE ISSQN'
  Else If (strCodImp = 'CAN-O') Then
    Result := 'CAN-O·CANCELAMENTO DE OPERAÇÕES NÃO FISCAIS'
  Else If (strCodImp = 'IOF') Then
    Result := 'IOF  ·IMPOSTO SOBRE OPERAÇÕES FINANCEIRAS';

End;

