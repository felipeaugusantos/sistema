function fApagaRegistro(strTabela, strAutInc: String;
  strNumDoc: String = ''; strEspDoc: String = '';
  strCodEmp: String = ''; strForCli: String = ''): Boolean;
  Var
    qryTmp: TUniQuery;
    strSQL: String;
Begin
  Result := False;

  strSQL := '';
  strSQL := strSQL + ' DELETE FROM ' + strTabela;

  If Pos(strTabela, 'MOVTRI_') > 0 Then
    strSQL := strSQL + '   WHERE DET_SEQGER = :AUTINC '
  Else If Pos(strTabela, 'MOVOBS_') > 0 Then
    strSQL := strSQL + '   WHERE MOV_SEQGER = :AUTINC '
  Else If Pos(strTabela, 'AUXMOV_') > 0 Then
    strSQL := strSQL + '   WHERE AUX_SEQGER = :AUTINC '
  Else If Pos(strTabela, 'CADFIS') > 0 Then
  Begin
    strSQL := strSQL + ' WHERE FIS_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '       FIS_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '       FIS_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '       FIS_FORCLI = :CODCLI AND ';
    strSQL := strSQL + '       FIS_TIP_FC = "C" ';
  End
  Else
    strSQL := strSQL + '   WHERE AUTOINCREM = :AUTINC ';

  Try
    qryTmp := fCriaQuery(Nil);

    With qryTmp Do
    Begin
      SQL.Clear;
      SQL.Add(strSQL);

      If Pos(strTabela, 'CADFIS') > 0 Then
      Begin
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODEMP').AsString := strCodEmp;
        ParamByName('CODCLI').AsString := strForCli;
      End
      Else
        ParamByName('AUTINC').AsString := strAutInc;

      ExecSQL;

      Result := RowsAffected > 0;
    End;
  Except
    On E : Exception do
    Begin
      pMensagensErro(E.Message, '[fApagaRegistro]');
    End;
  End;

  FreeAndNil(qryTmp);
End;






