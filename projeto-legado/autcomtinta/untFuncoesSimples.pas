{*****************************************}
{* CALCULA O VALOR DE JUROS              *}
{**************************************MV*}
function fCalculaJurosCadCtr(dtaDtaVen: TDateTime; fltValDup: Double; fltPerJur: Double = 9999; fltPerMul: Double = 9999; intTolerancia: Integer = 9999; strCodBco: String = ''): Double;
begin
  Result := fCalculaJurosCadCtr(dtaDtaVen,DateToStr(VS_Date),fltValDup,fltPerJur, fltPerMul, intTolerancia, strCodBco);
end;

{*****************************************}
{* CALCULA O VALOR DE JUROS COM OPÇAO DE *}
{* DATA DE PAGAMENTO                     *}
{**************************************AF*}
function fCalculaJurosCadCtr(dtaDtaVen: TDateTime; strDtaPag: String; fltValDup: Double; fltPerJur: Double = 9999; fltPerMul: Double = 9999; intTolerancia: Integer = 9999; strCodBco: String = ''): Double;
  Var
    {*****************************************}
    {* NECESSARIO DOUBLE, POIS DATE É DO TI- *}
    {* PO DOUBLE                             *}
    {**************************************MV*}
    fltDiaAtraso: Double;
    dtaDtaPag: TDateTime;
begin

  Result := 0.0;

  If fltValDup > 0 Then
  Begin

    dtaDtaPag := StrToDateDef(strDtaPag,0);

    If intTolerancia = 9999 Then
      intTolerancia := fCfgSis('TOLATR', varInteger);

    If fltPerJur = 9999 Then
      fltPerJur := fCfgSis('JURATR', varDouble);

    If fltPerMul = 9999 Then
      fltPerMul := fCfgSis('MULATR', varDouble);

    fltDiaAtraso := dtaDtaPag - dtaDtaVen;

    If (dtaDtaVen < dtaDtaPag) And (fltDiaAtraso > intTolerancia) Then
    Begin
      Result := 0;

      If fltPerMul > 0 Then
      Begin
        If strCodBco = '237' Then
          Result := fTruncaFloat(Result + fltValDup * (fltPerMul / 100), 2)
        Else
          Result := Result + fltValDup * (fltPerMul / 100);
      End;

      if (strCodBco = '341') Or (strCodBco = '237') then
        Result := Result + fFormataFloat((fltValDup * (fltPerJur / 30))/100, 2) * fltDiaAtraso
      else
      Result := Result + fltValDup * (((fltPerJur / 30) * fltDiaAtraso) / 100);

      Result := fFormataFloat(Result, 2);
    End;

  End;

End;

