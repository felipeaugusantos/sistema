procedure pCarregaCamposForm(frmForm: TForm; strChave: String; blnPorEmpresa: Boolean);
  Var
    sltLista: TStringList;
    intIndice, intPosInf: Integer;
    strSQL, strNomCam, strInfCam: String;
    qryAux: TUniQuery;
    objComp: TComponent;
Begin
  strSQL := '';
  strSQL := strSQL + 'SELECT                     ';
  strSQL := strSQL + '  CFG_VALOR_               ';
  strSQL := strSQL + 'FROM                       ';
  strSQL := strSQL + '  CFGCOL                   ';
  strSQL := strSQL + 'WHERE CFG_LOGOPE = :LOGOPE ';
  strSQL := strSQL + '  AND CFG_CHAVE_ = :CHAVE_ ';
  strSQL := strSQL + '  AND CFG_CODEMP = :CODEMP ';

  sltLista := TStringList.Create;
  qryAux := fCriaQuery();
  Try
    With qryAux Do
    Begin
      SQL.Text := strSQL;
      ParamByName('LOGOPE').AsString := strLoginUsuarioLogado;
      ParamByName('CHAVE_').AsString := strChave;
      ParamByName('CODEMP').AsString := IfThen(blnPorEmpresa, VS_strCodEmp, '');
      Open;

      sltLista.Text := FieldByName('CFG_VALOR_').AsString;
    End;

    For intIndice := 0 To sltLista.Count -1 Do
    Begin
      intPosInf := Pos(':', sltLista[intIndice]);

      If intPosInf > 0 Then
      Begin
        strNomCam := LeftStr(sltLista[intIndice], Pred(intPosInf));
        strInfCam := RightStr(sltLista[intIndice], Length(sltLista[intIndice]) - intPosInf);

        objComp := frmForm.FindComponent(strNomCam);

        If Assigned(objComp) Then
        Begin
          If objComp Is TCustomEdit Then
            TCustomEdit(objComp).Text := strInfCam

          Else If objComp Is TCheckBox Then
            TCheckBox(objComp).Checked := SameText(strInfCam, 'T')

          Else If objComp Is TComboBox Then
            TComboBox(objComp).ItemIndex := TComboBox(objComp).Items.IndexOf(strInfCam);
        End;
      End;
    End;
  Finally
    FreeAndNil(sltLista);
    FreeAndNil(qryAux);
  End;
End;

procedure pDesmembraCarteira(const strCartei: String; var strCodBco, strTipLay,
  strNumPos, strEspeci, strCodEmp: String; var intCartei: Integer);
Begin
  strCodBco := '';
  strTipLay := '';
  strNumPos := '';
  strEspeci := '';
  strCodEmp := '';
  intCartei := 0;
  If Pos('341', strCartei) > 0 Then
  Begin
    strCodBco := '341';
    strNumPos := '400';
    strEspeci := '';

    If Pos('CTA', strCartei) > 0 Then
    Begin
      strTipLay := 'P';
      strCodEmp := Copy(strCartei, 16, 3);
      intCartei := StrToInt(Copy(strCartei, 14, 1));
    End
    Else
    Begin
      strTipLay := 'R';
      strCodEmp := Copy(strCartei, 13, 3);
      intCartei := StrToInt(Copy(strCartei, 11, 1));
    End;
  End;

  If Pos('033', strCartei) > 0 Then
  Begin
    strCodBco := '033';
    strNumPos := '400';
    strEspeci := '';

    If Pos('CTA', strCartei) > 0 Then
    Begin
      strNumPos := '240';
      strTipLay := 'P';
      strCodEmp := Copy(strCartei, 16, 3);
      intCartei := StrToInt(Copy(strCartei, 14, 1));
    End
    Else
    Begin
      strTipLay := 'R';
      strCodEmp := Copy(strCartei, 14, 3);
      intCartei := StrToInt(Copy(strCartei, 12, 1));
    End;
  End;

  If Pos('748', strCartei) > 0 Then
  Begin
    strCodBco := '748';
    strNumPos := '400';
    strEspeci := '';

    If Pos('CTA', strCartei) > 0 Then
    Begin
      strTipLay := 'P';
      strCodEmp := Copy(strCartei, 16, 3);
      intCartei := StrToInt(Copy(strCartei, 14, 1));
    End
    Else
    Begin
      strTipLay := 'R';
      strCodEmp := Copy(strCartei, 13, 3);
      intCartei := StrToInt(Copy(strCartei, 11, 1));
    End;
  End;

  If Pos('001D7', strCartei) > 0 Then
  Begin
    strCodBco := '001';
    strNumPos := '400';
    strEspeci := 'D7';

    strTipLay := 'R';
    strCodEmp := Copy(strCartei, 15, 3);
    intCartei := StrToInt(Copy(strCartei, 13, 1));
  End;
End;

