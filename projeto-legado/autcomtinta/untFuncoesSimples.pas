Function fCmToPixel(fltValCm: Double; blnRound: Boolean = True): Double;
Begin
  If blnRound Then
    Result := RoundTo(fltValCm * CMPIXEL, -2)
  Else
    Result := fltValCm * CMPIXEL;
End;

Function fPixelToCm(fltValPix: Double; blnRound: Boolean = True): Double;
Begin
  If blnRound Then
    Result := RoundTo(fltValPix / CMPIXEL, -2)
  Else
    Result := fltValPix / CMPIXEL;
End;

{************************************}
{* REDIMENSIONA E CENTRALIZA O FORM *}
{* CONFORME O TAMANHO DESEJADO      *}
{*********************************AN*}
procedure pRedimensionaCentralizaForm(frmForm: TForm; intNewHeight, intNewWidth: Integer);
begin
  With frmForm Do
  Begin
    If intNewHeight <> Height Then
    Begin
      Height := intNewHeight;
      Top := Trunc((Screen.Height / 2) - (intNewHeight / 2));
    End;

    If intNewWidth <> Width Then
    Begin
      Width := intNewWidth;
      Left := Trunc((Screen.Width / 2) - (intNewWidth / 2));
    End;
    Repaint;
  End;
end;

function fSqlTotalEmprestimosAberto(strCodCli: string = ''): String;
begin
  Result := '';
  Result := Result + ' SELECT SQL_NO_CACHE ';
  Result := Result + '   DET_CODCLI AS CODCLI, ';
  Result := Result + '   0 AS TOTVEN, ';
  Result := Result + '   0 AS TOTAVE, ';
  Result := Result + '   SUM((DET_QTDITE - IFNULL(DET_BAIEMP, 0)) * ((DET_TOTITE-IFNULL(DET_DESESP, 0)) / DET_QTDITE)) AS TOTAL   ';
  Result := Result + ' FROM ';
  Result := Result + '   MOVDET ';
  Result := Result + ' WHERE ';
  Result := Result + '   DET_JAFATU = 0       AND ';
  Result := Result + '   DET_ESPDOC = "EP"    AND ';
  Result := Result + '   DET_CLAFIS > 5000 ';

  If Not fEmptyStr(strCodCli) Then
    Result := Result + '   AND DET_CODCLI = ' + QuotedStr(strCodCli) + ' ';

  Result := Result + ' GROUP BY ';
  Result := Result + '   DET_CODCLI ';
end;

function fQuandoWMSPermitirAlterarLoteDeProdutosRastreaveis(const strCodEmp : String = '') : Boolean;
var
  strEmpresa : String;
begin

  Result := False;

  strEmpresa := IIF(fEmptyStr(strCodEmp), VS_strCodEmp, strCodEmp);

  If Not (fCfgSis('LOTCRP', varBoolean, strEmpresa)) Then
    Exit;

  If (fCfgSis('WMSLOT', varBoolean, strEmpresa)) Then
    Exit;

  If Not (fCfgSis('UTIWMS', varBoolean, strEmpresa)) Then
    Exit;

  Result := True;

end;

function fSqlTotalPedidosAberto(strCodCli: string = ''): String;
begin
  Result := '';
  Result := Result + ' SELECT SQL_NO_CACHE ';
  Result := Result + '   FDO_CODCLI AS CODCLI, ';
  Result := Result + '   0 AS TOTVEN, ';
  Result := Result + '   0 AS TOTAVE, ';
  Result := Result + '   SUM((FDO_QTDITE - IFNULL(FDO_QTDBAI, 0)) * ((FDO_TOTITE-IFNULL(FDO_DESESP, 0)) / FDO_QTDITE)) AS TOTAL   ';
  Result := Result + ' FROM ';
  Result := Result + '   FATDOR ';
  Result := Result + '   INNER JOIN EXTDOR ON EXTDOR.FDO_SEQFDO = FATDOR.AUTOINCREM ';
  Result := Result + ' WHERE ';
  Result := Result + '   FDO_JAFATU = 0       AND ';
  Result := Result + '   FDO_ESPDOC = "PD"    AND ';
  Result := Result + '   IFNULL(FDO_INCFUT,"") = "" ';//NAO DEVE CONSIDERAR PEDIDOS DE BAIXA DE ENTREGA FUTURA

  If Not fEmptyStr(strCodCli) Then
    Result := Result + '   AND FDO_CODCLI = ' + QuotedStr(strCodCli) + ' ';

  Result := Result + ' GROUP BY ';
  Result := Result + '   FDO_CODCLI ';
end;

function fSqlTotalChequesAberto(strCodCli: string = ''; strDtaIni: String = ''; strDtaFin: String = ''; strCodVen : String = ''; blnIncDef: Boolean = True; strCodemp : TEditFocus=Nil; arrEmp: TConsultasArray = Nil; blnInfCob:Boolean=False): String;
begin

  Result := '';
  Result := Result + 'SELECT SQL_NO_CACHE ';
  Result := Result + '  CHQ_CODCLI AS CODCLI, ';
  Result := Result + '  SUM(IF(CHQ_DTAVEN <  ' + fCurrentDate + ', CHQ_VALCHQ, 0)) AS TOTVEN, ';
  Result := Result + '  SUM(IF(CHQ_DTAVEN >= ' + fCurrentDate + ', CHQ_VALCHQ, 0)) AS TOTAVE, ';
  Result := Result + '  SUM(CHQ_VALCHQ) AS TOTAL ';
  Result := Result + 'FROM ';
  Result := Result + '  CADCHQ ';
  Result := Result + 'WHERE ';

  //Somente das empresas que o operador tem direito de acesso.
  If fCfgSis('EMPCCC') = '1' Then
    Result := Result + '  LOCATE(CHQ_CODEMP, ' + QuotedStr(strEmpAcessoUsuarioLogado) + ') > 0 AND ';

  Result := Result + '  (((CHQ_DTADEP IS NULL) OR ((CHQ_DTADP2 IS NULL) AND (CHQ_DTADEV IS NOT NULL))) ';
  If Not blnIncDef Then
    Result := Result + '  OR ((COALESCE(CHQ_DEVDEF, 0) = 1) OR ((CHQ_DTADEV IS NOT NULL) AND (CHQ_DTADV2 IS NOT NULL))) ';

  Result := Result + ') AND CHQ_INCCTR = "N" ';

  If (Not fEmptyStr(fTiraCaracEspeciais(strDtaIni))) And
     (Not fEmptyStr(fTiraCaracEspeciais(strDtaFin))) Then
  Begin
    Result := Result + '   AND CHQ_DTAVEN BETWEEN ' + fCurrentDate(StrToDate(strDtaIni)) + ' AND ' +
                                                      fCurrentDate(StrToDate(strDtaFin)) + '     ';
  End;

  If Not fEmptyStr(strCodCli) Then
    Result := Result + '   AND CHQ_CODCLI = ' + QuotedStr(strCodCli) + ' ';

  If Not fEmptyStr(strCodVen) Then
    Result := Result + '   AND CHQ_CODVEN = ' + QuotedStr(strCodVen) + ' ';

  {*************************************************************}
  { CODIGO ABAIXO EXCLUSIVAMENTE PARA CONSULTAS ADVINDAS DO     }
  { CONTAS A RECEBER PARA PODER FILTRAR OS CHEQUES POR EMPRESA  }
  { LEVANDO EM CONSIDERAÇÃO OS DOIS OBJETOS QUE TRANSPORTAM     }
  { OS DADOS. VARIAVEL BOOLEANA PARA CHECAR A ENTRADA NO IF     }
  {*********************************************************FA**}
  if blnInfCob then
  begin
    If Not fEmptyStr(strCodEmp.Text) Then
      Result := Result + fStrLocate(strCodEmp,arrEmp,'CHQ_CODEMP','CODEMP')
    else
      Result := Result + ' AND LOCATE(CHQ_CODEMP, ' + QuotedStr(strEmpAcessoUsuarioLogado) + ') > 0  ';
  end;

  Result := Result + ' GROUP BY ';
  Result := Result + '  CHQ_CODCLI ';
end;

function fSqlTotalDuplicatasAberto(strCodCli: string = ''; strDtaIni: String = ''; strDtaFin: String = '';
                                   edtCodPortador : TEditFocus = Nil; arrPortador: TConsultasArray = Nil): String;
begin
  Result := '';
  Result := Result + 'SELECT ';
  Result := Result + '  CTR_CODCLI AS CODCLI, ';
  Result := Result + '  SUM(IF(CTR_DTAVEN <  ' + fCurrentDate + ', CTR_VALDUP, 0)) AS TOTVEN, ';
  Result := Result + '  SUM(IF(CTR_DTAVEN >= ' + fCurrentDate + ', CTR_VALDUP, 0)) AS TOTAVE, ';
  Result := Result + '  SUM(CTR_VALDUP) AS TOTAL ';
  Result := Result + 'FROM ';
  Result := Result + '  CADREC ';
  Result := Result + 'WHERE ';
  Result := Result + '  CTR_DTAREC IS NULL ';

  //Somente das empresas que o operador tem direito de acesso.
  If fCfgSis('EMPCCC') = '1' Then
    Result := Result + '  AND LOCATE(CTR_CODEMP, ' + QuotedStr(strEmpAcessoUsuarioLogado) + ') > 0 ';

  If (Not fEmptyStr(fTiraCaracEspeciais(strDtaIni))) And
     (Not fEmptyStr(fTiraCaracEspeciais(strDtaFin))) Then
  Begin
    Result := Result + '   AND CTR_DTAVEN BETWEEN ' + fCurrentDate(StrToDate(strDtaIni)) + ' AND ' +
                                                      fCurrentDate(StrToDate(strDtaFin)) + '     ';
  End;

  If Not fEmptyStr(strCodCli) Then
    Result := Result + '   AND CTR_CODCLI = ' + QuotedStr(strCodCli) + ' ';

  If (edtCodPortador <> Nil) And (arrPortador <> Nil) Then
  Begin
    If Not fEmptyStr(edtCodPortador.Text) Then
      Result := Result + fStrLocate(edtCodPortador,arrPortador,'CTR_CODPOR','CODPOR')
    Else If fCfgSis('DACPOR', VarBoolean) Then
    Begin
      Result := Result + ' AND (IFNULL(CTR_CODPOR, "") = "" ';
      Result := Result + ' OR LOCATE(CTR_CODPOR, ' + QuotedStr(strPortadoresOperador) + ') > 0) ';
    End;
  End;


  Result := Result + 'GROUP BY ';
  Result := Result + '  CTR_CODCLI ';
end;

function fSqlTotalDebitosClientes(strCodCli: String = ''; strDtaIni: String = ''; strDtaFin: String = ''; blnSomenteTotal : Boolean = False): String;
  Var
    ArrSQL: TStringArray;
    intContador: Integer;
begin
  SetLength(ArrSQL, 0);

  pAddDados(ArrSQL, fSqlTotalDuplicatasAberto(strCodCli, strDtaIni, strDtaFin));

  If fCfgSis('PDVLIM', varBoolean) Then pAddDados(ArrSQL, fSqlTotalPedidosAberto(strCodCli));
  If fCfgSis('CHQCCO', varBoolean) Then pAddDados(ArrSQL, fSqlTotalChequesAberto(strCodCli, strDtaIni, strDtaFin));
  If fCfgSis('LMCEMP', varBoolean) Then pAddDados(ArrSQL, fSqlTotalEmprestimosAberto(strCodCli));

  If blnSomenteTotal Then
    Result := 'SELECT SQL_NO_CACHE SUM(TOTAL) AS TOTAL FROM ( '
  Else
    Result := 'SELECT SQL_NO_CACHE CODCLI, SUM(TOTVEN) AS TOTVEN, SUM(TOTAVE) AS TOTAVE, SUM(TOTAL) AS TOTAL FROM ( ';

  For intContador := 0 To Length(ArrSQL) -1 Do
  Begin
    Result := Result + ArrSQL[intContador] + ' ';
    If intContador < (Length(ArrSQL) -1) Then
      Result := Result + ' UNION ALL ';
  End;

  Result := Result + ' ) AS TEMP GROUP BY CODCLI ORDER BY CODCLI';
end;

function fCriaClientDataSetClientesDebitos: TUniClientDataSet;
  Var
    qryDebitos: TUniQuery;
begin
  qryDebitos := fCriaQuery(Nil);

  With qryDebitos, SQL Do
  Begin
    Clear;

    Add(fSqlTotalDebitosClientes);

    Open;

    Result := fCriaClientDatset(qryDebitos);

