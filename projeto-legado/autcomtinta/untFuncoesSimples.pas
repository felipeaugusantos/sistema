Procedure pSetaClient(cdsClient: TDataSet);
  Var
    intContador: Integer;
Begin
  With cdsClient Do
  For intContador := 0 To Fields.Count - 1 Do
  Begin
    If Fields[intContador].ReadOnly Then
      Fields[intContador].ProviderFlags := Fields[intContador].ProviderFlags - [pfInWhere, pfInUpdate];
    Fields[intContador].ReadOnly := False;
    Fields[intContador].Required := False;
  End;
End;

Procedure pAtualizaUltimaAlteracaoItem(qryGenTmp: TUniQuery; strCodIte: String; dtaDtaAlt: TDateTime);
  Var
    strUpdDtaAltera: String;
Begin
  strUpdDtaAltera := '';
  strUpdDtaAltera := strUpdDtaAltera + 'UPDATE   ';
  strUpdDtaAltera := strUpdDtaAltera + '  CADITE ';
  strUpdDtaAltera := strUpdDtaAltera + 'SET ';
  strUpdDtaAltera := strUpdDtaAltera + '  ITE_DTAALT = :DTAALT, ';
  strUpdDtaAltera := strUpdDtaAltera + '  ITE_HULALT = :HULALT, ';
  strUpdDtaAltera := strUpdDtaAltera + '  ITE_CODOPE = :CODOPE ';
  strUpdDtaAltera := strUpdDtaAltera + ' WHERE ';
  strUpdDtaAltera := strUpdDtaAltera + '  ITE_CODITE = :CODITE ';

  qryGenTmp.Close;
  qryGenTmp.SQL.Clear;
  qryGenTmp.SQL.Add(strUpdDtaAltera);
  qryGenTmp.ParamByName('CODITE').AsString   := strCodIte;
  qryGenTmp.ParamByName('DTAALT').AsDate     := dtaDtaAlt;
  qryGenTmp.ParamByName('HULALT').AsDateTime := fNow;
  qryGenTmp.ParamByName('CODOPE').AsString   := strLoginUsuarioLogado;
  qryGenTmp.ExecSQL;
  qryGenTmp.Close;
