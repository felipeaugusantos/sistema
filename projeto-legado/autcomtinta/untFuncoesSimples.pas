function fRetornaDescricaoVeic(strPlaVei: String): String;
  Var
    strDesc: String;
    strFrom: String;
begin
  strDesc := 'CONCAT(IFNULL(MAR_DESMAR, ""), " ", ' +
             '       IFNULL(MOD_DESMOD, ""), " ", ' +
             '       IFNULL(VEI_ANOVEI, ""), " ", ' +
             '       IFNULL(COR_DESCOR, ""), " ") ' ;

  strFrom := '';
  strFrom := strFrom + ' CADVEI ';
  strFrom := strFrom + '   LEFT JOIN CORVEI ON VEI_CODCOR = COR_CODCOR ';
  strFrom := strFrom + '   LEFT JOIN MARVEI ON VEI_CODMAR = MAR_CODMAR ';
  strFrom := strFrom + '   LEFT JOIN MODVEI ON VEI_CODMOD = MOD_CODMOD ';

  Result := fCampoTabela(strDesc,
                         strFrom,
                        ['VEI_PLAVEI'],
                        [strPlaVei]);
end;

function fRetornaDadosVeic(strPlaVei: String): TDadosVeiculo;
  Var
    qryTemp : TUniQuery;
begin
  With Result Do Begin
    strPlaVei := '';
    strKM_Vei := '';
    strMarVei := '';
    strModVei := '';
    strAnoVei := '';
    strCorVei := '';
    strCondut := '';
    intCapCar := 0;
  End;

  If (fEmptyStr(strPlaVei)) Then Exit;

  qryTemp := fCriaQuery();

  Try
    qryTemp.Close();
    qryTemp.SQL.Clear();
    qryTemp.SQL.Add(' SELECT MAR_DESMAR, MOD_DESMOD, VEI_ANOVEI, ');
    qryTemp.SQL.Add('   COR_DESCOR, VEI_CAPCAR, VEI_CONDUT FROM  ');
    qryTemp.SQL.Add('   CADVEI LEFT JOIN MARVEI ON VEI_CODMAR = MAR_CODMAR LEFT ');
    qryTemp.SQL.Add('   JOIN MODVEI ON VEI_CODMOD = MOD_CODMOD LEFT JOIN CORVEI ');
    qryTemp.SQL.Add('   ON VEI_CODCOR = COR_CODCOR WHERE VEI_PLAVEI = :PLAVEI ');

    qryTemp.ParamByName('PLAVEI').AsString := strPlaVei;
    qryTemp.Open();

    qryTemp.First();

    If (Not qryTemp.Eof) Then Begin
      With Result Do Begin
        strPlaVei := strPlaVei;
        strMarVei := qryTemp.FieldByName('MAR_DESMAR').AsString;
        strModVei := qryTemp.FieldByName('MOD_DESMOD').AsString;
        strAnoVei := qryTemp.FieldByName('VEI_ANOVEI').AsString;
        strCorVei := qryTemp.FieldByName('COR_DESCOR').AsString;
        strCondut := qryTemp.FieldByName('VEI_CONDUT').AsString;
        intCapcar := qryTemp.FieldByName('VEI_CAPCAR').AsInteger;
      End;
    End;
  Finally
    FreeAndNil(qryTemp);
  End;
end;


