procedure pGravaLogAtb(strCodBco, strDesBco, strCartei, strCodOpe, strCodEmp, strCfgAnt, strCfgAtu, strCmpAlt: String);
  Var
    qryLogAtb: TUniQuery;
    strSQL   : String;
Begin
  Try
    qryLogAtb := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '   AUTOINCREM, ';
    strSQL := strSQL + '   LOG_OPELOG, ';
    strSQL := strSQL + '   LOG_CODEMP, ';
    strSQL := strSQL + '   LOG_CODBCO, ';
    strSQL := strSQL + '   LOG_DESBCO, ';
    strSQL := strSQL + '   LOG_CARTEI, ';
    strSQL := strSQL + '   LOG_CFGANT, ';
    strSQL := strSQL + '   LOG_CFGATU, ';
    strSQL := strSQL + '   LOG_CMPALT, ';
    strSQL := strSQL + '   LOG_DTALOG, ';
    strSQL := strSQL + '   LOG_HORLOG  ';
    strSQL := strSQL + ' FROM          ';
    strSQL := strSQL + '   LOGATB      ';
    strSQL := strSQL + ' WHERE FALSE   ';

    With qryLogAtb Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      Open;

      Insert;
      FieldByName('AUTOINCREM').AsString := fRetAutoincrem('LOGATB', VS_strCodEmp);
      FieldByName('LOG_OPELOG').AsString := strCodOpe;
      FieldByName('LOG_CODEMP').AsString := strCodEmp;
      FieldByName('LOG_CODBCO').AsString := strCodBco;
      FieldByName('LOG_DESBCO').AsString := strDesBco;
      FieldByName('LOG_CARTEI').AsString := strCartei;
      FieldByName('LOG_CFGANT').AsString := strCfgAnt;
      FieldByName('LOG_CFGATU').AsString := strCfgAtu;
      FieldByName('LOG_CMPALT').AsString := strCmpAlt;
      FieldByName('LOG_DTALOG').AsDateTime:= VS_Date;
      FieldByName('LOG_HORLOG').AsDateTime:= fTime();
      Post;
    End;
  Except
    On E: Exception Do
    Begin
      Raise Exception.Create(E.Message);
    End;
  End;
  FreeAndNil(qryLogAtb);
End;

