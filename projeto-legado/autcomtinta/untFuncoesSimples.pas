{* UNIFICA VALIDAÇÕES DE CPF/CNPJ COM DEFAULT PARA  *}
{* ALERTA = "NÃO"                                   *}
{*************************************************VA*}
Function fValidaCnpjCpf(strCPFCNPJ: String; blnMostraMSG: Boolean=False):Boolean;
  Var
    strOpcao : String;
begin
  Result := False;

  If Not fEmptyStr(strCPFCNPJ) Then
  Begin
    strOpcao := IfThen(Length(strCPFCNPJ) > 11, '1','2');

    Result := fValidaCnpjCpfDigIgual(strOpcao, strCPFCNPJ, False);

    If Result Then
    Begin
      If strOpcao = '1' Then
        Result := fTestaCgc(strCPFCNPJ)
      Else If strOpcao = '2' Then
        Result := fValidaCPF(strCPFCNPJ);
    End;

    If (blnMostraMSG) And (Not Result) Then
     fMensagem('ATENÇÃO', strCPFCNPJ + ' não é um número de '+IfThen(strOpcao='1','CNPJ','CPF')+' válido!', ['&Ok']);
  End
  Else
  Begin
    If (blnMostraMSG) Then
      fMensagem('ATENÇÃO', 'CPF/CNPJ não informado!', ['&Ok']);
  End;
end;

{*****************************************}
{* VALIDA O CNPJ OU CGC, DE ACORDO COM   *}
{* 'strOpcao'                            *}
{**************************************MV*}
function fValidaCnpjCpf(strOpcao, strValor: String; blnPassaVazio: Boolean = True; blnPermiteDigitosIguais: Boolean = False): Boolean;
begin
  Result := True;
  If (blnPassaVazio) And (strOpcao = '0') Then
    Exit;

  If strOpcao = '1' Then
  Begin
    Result := fTestaCgc(strValor);
    If Not Result Then
      fMensagem('ATENÇÃO', strValor + ' não é um Número de CNPJ válido!', ['&Ok']);
  End
  Else If strOpcao = '2' Then
  Begin
    Result := fValidaCPF(strValor);
    If Not Result Then
      fMensagem('ATENÇÃO', strValor + ' não é um Número de CPF válido!', ['&Ok']);
  End;

  {*****************************************}
  {* COMENTADO A PEDIDO DO RONALDO NO DIA  *}
  {* 12/08/2010.                           *}
  {**************************************MV*}
  {If Result And (Not blnPermiteDigitosIguais) Then
+  Begin
+    fValidaCnpjCpfDigIgual(strOpcao, strValor);
+  End;}
end;

function fValidaCnpjCpfDigIgual(strOpcao, strValor: String; blnMostraMSG: Boolean=True): Boolean;
  Var
    blnRepetido: Boolean;
    strDado    : String;
    chrLetra   : Char;
    intContador: Integer;
begin
  Result := True;

  blnRepetido := True;
  strDado     := fTiraCaracEspeciais(strValor);
  chrLetra    := strDado[1];

  For intContador := 2 To Length(strDado) Do
  Begin
    If chrLetra <> strDado[intContador] Then
    Begin
      blnRepetido := False;
      Break;
    End;
  End;

  If blnRepetido Then
  Begin
    Result := False;
    If blnMostraMSG Then
      fMensagem('ATENÇÃO', strValor + ' não é um Número de CPF/CNPJ válido!', ['&Ok']);
  End;
end;


