Function fPedidoDeCompraOriundoDeGarantia(strNumPed, strCodEmp : String):Boolean;
  Var
    strSQL : String;
    qryConsul : TUniQuery;
Begin
  strSQL := '';
  strSQL := strSQL + ' SELECT IF(GROUP_CONCAT( DISTINCT PCD_DOCORI) IS NULL, "N", "S") AS PEDGAR ';
  strSQL := strSQL + ' FROM PCMDET                                                  ';
  strSQL := strSQL + ' INNER JOIN MOVGAD ON SUBSTRING(PCD_DOCORI,1,12) = GAD_NUMENV ';
  strSQL := strSQL + '                  AND SUBSTRING(PCD_DOCORI,13,2) = GAD_ESPENV ';
  If Not fCfgSis('GARMAT', varBoolean) Then
    strSQL := strSQL + '                AND PCD_CODEMP = GAD_CODEMP                 ';
  strSQL := strSQL + ' WHERE PCD_NUMPED = :NUMPED                                   ';
  strSQL := strSQL + '   AND PCD_CODEMP = :CODEMP                                   ';
  strSQL := strSQL + '   AND PCD_ESPDOC = :ESPDOC                                   ';


  Try
    qryConsul := fCriaQuery(Nil);
    With qryConsul, SQL Do
    Begin
      Close;
      Clear;
      Add(strSQL);

      ParamByName('NUMPED').AsString := strNumPed;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('ESPDOC').AsString := 'PD';

      Open;

      If IsEmpty Then
        Result := False
      Else
        Result := FieldByName('PEDGAR').AsString = 'S';

      Close;
    End;
  Finally
    FreeAndNil(qryConsul);
  End;

End;

function fGetSQLSomaExpedidos(strRelacaoCodIte: String; strRelacaoCodEmp: String; blnSubSel: Boolean = True): String;
begin
  Result := '';

  If (blnSubSel) Then
    Result := Result + ' IFNULL((                                                     ';

  Result := Result + '         SELECT SUM(FDO_QTDEXP)                                 ';
  Result := Result + '           FROM EXTDOR                                          ';
  Result := Result + '           JOIN FATDOR ON FATDOR.AUTOINCREM = EXTDOR.FDO_SEQFDO ';
  Result := Result + '           JOIN FATGOR ON FATGOR.AUTOINCREM = FATDOR.FDO_SEQGER ';
  Result := Result + '          WHERE FATDOR.FDO_ESPDOC = "PD"                        ';
  Result := Result + '            AND FDO_JAFATU = 0                                  ';
  Result := Result + '            AND FDO_QTDEXP > 0                                  ';
  Result := Result + '            AND FGO_JAFATU = 0                                  ';

  If (blnSubSel) Then
  Begin
    Result := Result + '          AND FDO_CODITE = ' + strRelacaoCodIte + '           ';
    Result := Result + '          AND FDO_CODEMP = ' + strRelacaoCodEmp + '), 0)      ';
  End
  Else
  Begin
    Result := Result + '          AND FDO_CODITE = ' + QuotedStr(strRelacaoCodIte);
    Result := Result + '          AND FDO_CODEMP = ' + QuotedStr(strRelacaoCodEmp);
  End;
end;

