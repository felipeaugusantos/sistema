function fRetornaPercIVA(strCodAbf: String; strEstado, strTipAbf: String; cdsPerIva: TUniClientDataSet = Nil): Double;
Var
  strSQL   : String;
  qryGenAbf: TUniQuery;

begin
  Try
    Result := 0;

    If Assigned(cdsPerIva) Then
    With cdsPerIva Do
    Begin
      If Locate('ABF_CODABF;ABF_ESTADO', VarArrayOf([strCodAbf, strEstado]), []) Then
      Begin
        Result := FieldByName('ABF_IVA_ST' + strTipAbf).AsFloat;
        Exit;
      End;
    End;

    qryGenAbf := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  ABFICM ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  ABF_CODABF = :CODABF AND ';
    strSQL := strSQL + '  ABF_ESTADO = :ESTADO ';

    Try
      With qryGenAbf Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('CODABF').AsString := strCodAbf;
        ParamByName('ESTADO').AsString := strEstado;
        Open;

        {********************************************}
        {* PEGA PERCENTUAL AVI DA ABREVIAÇÃO FISCAL *}
        {*****************************************LU*}
        Result := FieldByName('ABF_IVA_ST' + strTipAbf).AsFloat;

        If Assigned(cdsPerIva) Then
          pIncluiCdsAbreviacao(cdsPerIva, qryGenAbf);

        Close;
      End;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[fRetornaPercAVI]');
      End;
    End;

  Finally
    FreeAndNil(qryGenAbf);
  End;

end;

Procedure pIncluiCdsAbreviacao(cdsPerIva: TUniClientDataSet; qryGenAbf: TUniQuery);
  Var
    intCol: Integer;
Begin
  With qryGenAbf Do
  Begin
    cdsPerIva.Insert;
    For intCol := 0 To cdsPerIva.Fields.Count -1 Do
      If FindField(cdsPerIva.Fields[intCol].FieldName) <> Nil Then
        cdsPerIva.Fields[intCol].Value := FindField(cdsPerIva.Fields[intCol].FieldName).Value;
    cdsPerIva.Post;
  End;
End;

