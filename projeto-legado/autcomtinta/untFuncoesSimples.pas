procedure pCalcSaldoInicialItens(Var fltSaldoIni: Double;
                                     dtaDtaBal,
                                     dtaDtaIni: TDateTime;
                                     strCodIte: String;
                                     strCodEmp: String;
                                     blnEntFut: Boolean = True;
                                     strNumLot: String = '');
  Var
    strSQL   : String;
    qryGenDet: TUniQuery;

Begin
  Try

    qryGenDet := fCriaQuery;

    If dtaDtaIni <> dtaDtaBal Then
    Begin
      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
//      strSQL := strSQL + '  DET_DTAENT AS DTAENT, ';
//      strSQL := strSQL + '  LEFT(DET_CLAFIS,1) AS CLAFIS, ';

      strSQL := strSQL + ' SUM(IFNULL( ';

      strSQL := strSQL + '  IF(LEFT(DET_CLAFIS,1) >= 5, -1, 1) *  ';

      If blnEntFut Then
        strSQL := strSQL + '  DET_QTDITE '
      Else
        strSQL := strSQL + '  IF(DET_ENTFUT = "S", IFNULL(DET_QTDENT,0), DET_QTDITE) '; // CONSIDERA SOMENTE A QUANTIDADE ENTREGUE

      strSQL := strSQL + ' * IF(DET_ESPDOC <> "ML", IF(ITE_CNV_ML IS NULL OR ITE_CNV_ML <= 0, 1, ITE_CNV_ML), 1), 0)) AS QTDITE ';

      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  MOVDET ';
      strSQL := strSQL + '  JOIN CADITE ON ITE_CODITE = DET_CODITE ';
      strSQL := strSQL + ' WHERE ';
      strSQL := strSQL + '  DET_ESPDOC <> "TM" AND ';
      strSQL := strSQL + '  DET_ESPDOC <> "DF" AND ';
      strSQL := strSQL + '  DET_ESPDOC <> "PR" AND ';

      If (fCfgSis('BEFTRG', VarBoolean)) Then
      Begin
        If blnEntFut Then
          strSQL := strSQL + '  (DET_FILKAR = FALSE OR DET_ENTFUT = "S") AND DET_DOCFUT IS NULL AND '
        Else
      strSQL := strSQL + '  (DET_FILKAR = FALSE) AND ';
      End
      Else
      strSQL := strSQL + '  DET_FILKAR = FALSE AND ';
      strSQL := strSQL + '  DET_CODEMP = :CODEMP AND ';
      strSQL := strSQL + '  DET_CODITE = :CODITE AND ';
      strSQL := strSQL + '  DET_DTAENT BETWEEN :DTAINI AND :DTAFIN ';

      If Not fEmptyStr(strNumLot) Then
        strSQL := strSQL + ' AND DET_NUMLOT = :NUMLOT ';

      With qryGenDet Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('DTAINI').AsDate   := dtaDtaBal;
        ParamByName('DTAFIN').AsDate   := dtaDtaIni -1;
        ParamByName('CODITE').AsString := strCodIte;
        ParamByName('CODEMP').AsString := strCodEmp;

        If Not fEmptyStr(strNumLot) Then
          ParamByName('NUMLOT').AsString := strNumLot;

        Open;

        While Not Eof Do
        Begin
          Application.ProcessMessages;

          {
          If FieldByName('CLAFIS').AsInteger >= 5 Then
            fltSaldoIni := fltSaldoIni - FieldByName('QTDITE').AsFloat
          Else
            fltSaldoIni := fltSaldoIni + FieldByName('QTDITE').AsFloat;
          }

          fltSaldoIni := fltSaldoIni + FieldByName('QTDITE').AsFloat;

          Next;
        End;

        Close;
      End;
    End;

  Finally
    FreeAndNil(qryGenDet);
  End;

End;

function fRetCodVendedor(strSenha: String; blnGerente : Boolean = False; blnSubGerente: Boolean = False; blnRepresentante: Boolean = False): String;
  Var
    strSQL   : String;
    qryGenOpe: TUniQuery;

begin
  Try

    qryGenOpe := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '  OPE_CODOPE ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADOPE ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  BINARY OPE_SENOPE = :SENOPE ';

    if (blnGerente) then
      strSQL := strSQL + '  AND (OPE_INTEXT = "G") '

    Else if (blnSubGerente) then
      strSQL := strSQL + '  AND (OPE_INTEXT = "S") '

    Else if (blnRepresentante) then
      strSQL := strSQL + '  AND ((OPE_INTEXT = "E") OR (OPE_INTEXT = "D")) ';

    With qryGenOpe Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('SENOPE').AsString := fCrypt(strSenha);
      Open;
      Result := Fields[0].AsString;
      Close;
    End;

  Finally
    FreeAndNil(qryGenOpe);
  End;

end;

