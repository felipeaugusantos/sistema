function fRetProxNumAutBan(strCartPrinc: String): String;
Begin
  //Utilizado para retornar o Próximo Número de Remessa da Carteira Principal
  Result := fGetBancoConfig(0, strCartPrinc, 'PROXNUM', '');
End;

procedure pAtualizaProxNumCartsAutBan(strCartPrinc: String);
Var intCont   : Integer;
    strCartSeq: String;
    strCartei : String;
begin
  //Utilizado para atualizar o  Próximo Número de Remessa das carteiras "filhas"
  strCartSeq := fRetProxNumAutBan(strCartPrinc);
  strCartei  := Copy(strCartPrinc, Length(strCartPrinc));
  For intCont := 1 to 5 Do
  Begin
    If (intCont <> StrToInt(strCartei)) And
       (fGetBancoConfig(0, Copy(strCartPrinc, 1, Length(strCartPrinc) - 1) + IntToStr(intCont), 'SEQCART', '') = strCartei) Then
    Begin
      fGetBancoConfig(1, Copy(strCartPrinc, 1, Length(strCartPrinc) - 1) + IntToStr(intCont), 'PROXNUM', strCartSeq);
    End;
  End;
End;

function fVerificaCartPrimariaAutBan(strConfig: String; intCartSel: Integer): Boolean;
Var intCont   : Integer;
    strCartSeq: String;
begin
  Result := False;

  For intCont := 1 to 5 Do
  Begin
    If intCont <> intCartSel Then
    Begin
      strCartSeq := fGetBancoConfig(0, strConfig + IntToStr(intCont), 'SEQCART', '');
      Result := (strCartSeq = InttoStr(intCartSel));

      If Result Then Break;
    End;
  End;
end;

function fVerificaCartFilhaAutBan(strConfig: String): Boolean;
Var strCartSeq: String;
begin
  strCartSeq := fGetBancoConfig(0, strConfig, 'SEQCART', '');
  Result := (Not fEmptyStr(strCartSeq));
end;

{*****************************************}
{* IMPLEMENTAÇÃO DA FUNCAO GETMENU       *}
{**************************************MV*}
function fGetMenu(strTitulo: String; arrOpcoes: Array Of String; intOpcao: Integer;
  blnSaiComEsc: Boolean = False; blnLibQtd: Boolean = False; intWidth: Integer = 0): Integer;
  Var
    intContador: Integer;
begin

  Result := -1;
  If (Not blnLibQtd) And (Length(arrOpcoes) <= 1) Then
  Begin
    fMensagem('', 'É Necessário escolher ao menos 2 opções', ['&Ok']);
    Exit;
  End;

  Try
    pCriarFormularios(TfrmGetMenu, frmGetMenu);
    SetLength(frmGetMenu.arrOpcoes, Length(arrOpcoes));

    For intContador := 0 To Length(arrOpcoes)-1 Do
    Begin
      frmGetMenu.arrOpcoes[intContador] := arrOpcoes[intContador];
    End;

    If intOpcao <= 0 Then
      intOpcao := 1;

    Dec(intOpcao);

    frmGetMenu.intLinha     := intOpcao;
    frmGetMenu.blnSaiComEsc := blnSaiComEsc;
    frmGetMenu.Caption      := strTitulo;

    If intWidth > 0 Then
    Begin
      frmGetMenu.Width         := frmGetMenu.Width + intWidth;
      frmGetMenu.stgMenu.Width := frmGetMenu.Width;
      frmGetMenu.stgMenu.DefaultColWidth := frmGetMenu.Width;
    End;

    frmGetMenu.showModal;

    If frmGetMenu.blnConfirma Then
    Begin
      Result := frmGetMenu.intLinha+1;
    End;

  Except
    On E: Exception Do
    Begin
      Result := -1;
      pMensagensErro(E.Message, '[untFuncoes.fGetMenu]');
    End;
  End;

  pFreeAndNil(frmGetMenu);

end;

procedure pCarregaArrayBancoCarteira(strCodBan: String;
                                     Var arrBancos: TArrBancos;
                                     Var arrBanCar: TStringArray;
                                     blnVeioImpBol: Boolean = True;
                                     strCodCar: String = '');
  Var
    intContador: Integer;
    stlBancos  : TStringList;

    function fEmpresaImpBol(strKeyAtb: String): Boolean;
    begin
      Result := (fGetBancoConfig(0, strKeyAtb, 'RESPONS', 'E') = 'E');

      If Not blnVeioImpBol Then
        Result := True;
    end;

    function fJaTemNoArray(strBanRet, strCarRet, strCartei, strInfAdi: String):Boolean;
      Var
        intContador: Integer;
    Begin

      Result := False;

      For intContador := 0 To Length(arrBanCar) - 1Do
      Begin
        If arrBanCar[intContador] = 'Banco: ' + strBanRet + '-' + strCarRet + ' - CART.: ' + strCartei + strInfAdi Then
        Begin
          Result := True;
          Break;
        End;
      End;

    End;

    procedure pSetArrBan(strKeyAtb: String);
      Var
        strInfAdi: String;
        strCartei: String;
        strBanRet: String;
        intCarRet: Integer;
    begin

    	If fEmpresaImpBol(LeftStr(strKeyAtb, Length(strKeyAtb)-4)) Then
      Begin
        If Copy(strKeyAtb, 11, 6) = 'CONRET' Then
          Exit;

        strBanRet := Copy(strKeyAtb, 7 , Pos('-', RightStr(strKeyAtb, Length(strKeyAtb) - 6))-1 );
        intCarRet := StrToIntDef(Copy(strKeyAtb, 8 + Length(strBanRet) , Pos('-', RightStr(strKeyAtb, Length(strKeyAtb) - 7 - Length(strBanRet)))-1 ),0);

        strKeyAtb := LeftStr(strKeyAtb, Length(strKeyAtb)-4);

        strInfAdi := fGetBancoConfig(0, strKeyAtb, 'INFADIC', '');
        If Not fEmptyStr(strInfAdi) Then  strInfAdi := ' - ' + strInfAdi;

        strCartei := fGetBancoConfig(0, strKeyAtb, 'CODCART', '');
        If fEmptyStr(strCartei) Then strCartei := fGetBancoConfig(0, strKeyAtb, 'NUMCART', '');

        If (fEmptyStr(strCodCar) Or (intCarRet.ToString = strCodCar))                And
           (Not fJaTemNoArray(strBanRet, IntToStr(intCarRet), strCartei, strInfAdi)) Then
        Begin
      		SetLength(arrBanCar, Length(arrBanCar) + 1);

          if not fEmptyStr(Trim(strCartei + strInfAdi)) then
      	   	arrBanCar[Length(arrBanCar)-1] := 'Banco: ' + strBanRet + '-' + IntToStr(intCarRet) + ' - CART.: ' + strCartei + strInfAdi
          else
            arrBanCar[Length(arrBanCar)-1] := 'Banco: ' + strBanRet + '-' + IntToStr(intCarRet);

      		SetLength(arrBancos, Length(arrBancos) + 1);
    	  	arrBancos[Length(arrBancos)-1].strCodBan := strBanRet;
    		  arrBancos[Length(arrBancos)-1].intCodCar := intCarRet;
        End;
    	End;

    end;

    function fChaveValida(strSection: String): Boolean;
      Var
        intCont: Integer;
        intAux : Integer;
    begin
      intAux := 0;

      For intCont := 1 To Length(strSection) Do
      Begin

        If Copy(strSection, intCont, 1) = '-' Then
          Inc(intAux);

      End;

      {*******************************}
      {* CASO NÃO SEJA DA MESMA LOJA *}
      {*******************************}
      If (intAux > 1) And (RightStr(strSection,3) <> VS_strCodEmp) Then
        intAux := 0;

      If (((strCodBan = '001')            And
          (Pos('D7', strSection) > 0))      Or
          ((strCodBan = '237')              And
          (Pos('_VENDOR', strSection) > 0)) Or
          ((strCodBan = '104')              And
          (Pos('p400', strSection) > 0)))   And
          (Not blnVeioImpBol)               Then
        intAux := 0;

      Result := intAux > 1;
    end;

Begin
  SetLength(arrBanCar, 0);
  SetLength(arrBancos, 0);

  stlBancos := TStringList.Create;

  fArqIniAutban(stlBancos);

  For intContador := 0 To stlBancos.Count -1 Do
  Begin
    If StartsStr('CONFIG' + strCodBan, stlBancos[intContador]) And
       fChaveValida(stlBancos[intContador])                    Then
    Begin
      pSetArrBan(stlBancos[intContador]);
    End;
  End;

  FreeAndNil(stlBancos);
End;

