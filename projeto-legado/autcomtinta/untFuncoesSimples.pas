function fCriaMemoryTableEntregaFutura(strNomTab: String;
                                       strCodEmp: String;
                                       strCodIte: String = '';
                                       strNumLot: String = '';
                                       blnConverteML: Boolean = False;
                                       blnApenasCriacao: Boolean = False;
                                       blnFaturamento: Boolean = False;
                                       strMotFut: String  = '';
                                       blnPorLote: Boolean = False): Boolean;
  Var
    qryExec: TUniQuery;
begin
  Try

    Result := fDropTable(strNomTab);

    If Not Result Then
      Exit;

    qryExec := fCriaQuery;

    If blnFaturamento And (fCfgSis('CALSAL') = '3') Then
      strMotFut := QuotedStr('F');

    If blnFaturamento And (fCfgSis('CALSAL') = '4') Then
      strMotFut := QuotedStr('A') + ', ' + QuotedStr('P');

    If blnFaturamento And (fCfgSis('CALSAL') = '5') Then
      strMotFut := QuotedStr('A') + ', ' + QuotedStr('F');

    With qryExec, SQL Do
    Begin
      Close;
      Clear;

      Add('CREATE TABLE ' + strNomTab + ' (');
      Add('  DET_CODITE VARCHAR('+IntToStr(fTamCodIte)+') DEFAULT NULL,');

      If blnPorLote Then
        Add('  DET_NUMLOT VARCHAR(20) DEFAULT NULL,');

      Add('  DET_CODEMP CHAR(3) DEFAULT NULL,');
      Add('  CNV_ML DECIMAL(12,4) DEFAULT NULL,');
      Add('  QTDPEN DECIMAL(12,4) DEFAULT NULL,');
      Add('  QTDPEA DECIMAL(12,4) DEFAULT NULL,');
      Add('  QTDPEF DECIMAL(12,4) DEFAULT NULL,');
      Add('  QTDPEP DECIMAL(12,4) DEFAULT NULL,');

      If blnPorLote Then
        Add('  KEY IDX_' + strNomTab + '_01 (DET_CODITE, DET_NUMLOT),')
      Else
        Add('  KEY IDX_' + strNomTab + '_01 (DET_CODITE),');

      Add('  KEY IDX_' + strNomTab + '_02 (DET_CODEMP)');
      Add(') ENGINE = MEMORY DEFAULT CHARSET=LATIN1');

      ExecSQL;

      Close;

      If (Not blnApenasCriacao) Then
      Begin
        Clear;

        Add('INSERT INTO ' + strNomTab + '(' +
          fGetSQLQtdEntregaFutura(strCodEmp, strCodIte, strNumLot, strMotFut, blnPorLote) + ')');

        {****************************************************************************************************}
        {* ISOLADO EM UMA TRANSAÇÃO, BLOCO QUE DA INSERT NA TEMPORÁRIA COM OS DOCUMENTOS DE ENTREGA FUTURA, *}
        {* PARA EVITAR DEADLOCK CASO OUTRA ESTAÇÃO ESTEJA GRAVANDO DADOS NA MOVDET COMO POR EXEMPLO,        *}
        {* UMA BAIXA DE ENTREGA FUTURA ONDE O CAMPO "DET_QTDITE" ESTEJA SENDO ATUALIZADO.                   *}
        {* CASO AINDA SIM OCORRA ALGUM ERRO, O QUE DIFICILEMENTE OCORRERÁ, O BLOCO QUE CHAMOU A FUNÇÃO      *}
        {* É ABORTADO PARA EVITAR QUE O SALDO DO(S) ITEM(NS) FIQUE(M) DIVERGENTE(S).                        *}
        {*************************************************************************************************VA*}
        fStartTransaction;
        Try
          ExecSQL;
          fCommit;
        Except
          On E: Exception Do
          Begin
            fRollBack;
            Result := False;
            Raise Exception.Create('Ocorreu um erro durante o levantamento de documentos de entrega futura.' + #13 +
                                   'Erro original: ' +E.Message);
            Abort;
          End;
        End;

        If Not blnConverteML Then
        Begin
          Close;
          Clear;
          Add('UPDATE ' + strNomTab + ' SET QTDPEN = IF(IFNULL(CNV_ML, 0) <> 0, QTDPEN / CNV_ML, QTDPEN)');
          ExecSQL;
        End;
      End;

      Result := True;
    End;
  Finally
    FreeAndNil(qryExec);
  End;
end;


Function fQtdPendenteEntregaFuturaSQL(strCodIte, strCodEmp: String; intCaixa: Integer;
  strNumLot: String = ''; blnConverteML: Boolean = True) : String;
  Var
    strMovGer,
    strMovDet,
    strDetCol: String;
Begin
  strMovGer := 'MOVGER GER ';
  strMovDet := 'MOVDET DET ';
  strDetCol := 'MOVDET COL ';

  Result := '';

  Result := Result + 'SELECT ';

  If blnConverteML Then
    Result := Result + '  ROUND(SUM(DET.DET_QTDITE - IFNULL(DET.DET_QTDENT, 0)) / IF(IFNULL(ITE.ITE_CNV_ML, 0) > 0, ITE.ITE_CNV_ML, 1), 4) AS QTDPEN '
  Else
    Result := Result + '  ROUND(SUM(DET.DET_QTDITE - IFNULL(DET.DET_QTDENT, 0)), 4) AS QTDPEN ';

  Result := Result + 'FROM                                         ';
  Result := Result + strMovDet                                      ;
  Result := Result + 'INNER JOIN MOVTRI T ON DET.AUTOINCREM = T.DET_SEQGER ';
  Result := Result + 'INNER JOIN CADITE ITE ON ITE.ITE_CODITE = DET_CODITE ';
  Result := Result + 'WHERE                                        ';
  Result := Result + '  DET.DET_TIP_FC = "C"  AND                      ';
  Result := Result + '  DET.DET_ENTFUT = "S"  AND                      ';
  Result := Result + '  DET.DET_ESPDOC NOT IN ("ML", "PR", "TM") AND   ';

  If fCfgSis('EFTEST') = '2' Then
  Begin
    Result := Result + '   (DET.DET_PROEMB <> "S" OR T.DET_BXSBIT = "S") AND ';//Para exibir os sub-itens (proemb = 's' e bxsbit = 's')
    Result := Result + '   (DET.DET_FILKAR = 0) AND ';//Para nao exibir o item principal (que vai estar com filkar = 1)
  End
  Else
    Result := Result + '   DET.DET_PROEMB <> "S" AND ';

  Result := Result + '  DET.DET_EFBAIX = "N" AND ';

  Result := Result + '  DET.DET_CODITE = :CODITE                       ';

  If Not fEmptyStr(strCodEmp) Then
    Result := Result + '  AND DET.DET_CODEMP = :CODEMP                 ';

  If Not fEmptyStr(strNumLot) Then
    Result := Result + '  AND IFNULL(DET.DET_NUMLOT,"") = IFNULL(:NUMLOT,"") ';

  {***********************************************************************************}
  {* CASO UTILIZE TINTA DE MAQUINA DEVE TAMBEM CONSIDERAR OS COLORANTES COMO ENTREGA *}
  {* FUTURA PARA CALCULO DE QUANTIDADE PENDENTE. SOLICITADO PELA "DARKA" 28/08/2013  *}
  {********************************************************************************JC*}
  If fCfgSis('USATMQ', varBoolean) Then
  Begin
    Result := Result + 'UNION ALL ';

    Result := Result + 'SELECT ';
    Result := Result + '  SUM(COL.DET_QTDITE * ( 1 - IFNULL(DET.DET_QTDENT / DET.DET_QTDITE, 0) ) / IF(IFNULL(ITE.ITE_CNV_ML, 0) > 0, ITE.ITE_CNV_ML, 1)) AS QTDPEN ';
    Result := Result + 'FROM ';
    Result := Result + strMovDet;
    Result := Result + '  INNER JOIN MOVTRI T ON DET.AUTOINCREM = T.DET_SEQGER ';
    Result := Result + '  INNER JOIN ' + strDetCol + ' ON DET.DET_CODACA = COL.DET_CODACA AND ';
    Result := Result + '                                  DET.DET_EMPACA = COL.DET_EMPACA AND ';
    Result := Result + '                                  DET.DET_NUMDOC = COL.DET_NUMFAT AND ';
    Result := Result + '                                  DET.DET_ESPDOC = COL.DET_TIPFAT AND ';
    Result := Result + '                                  DET.DET_CODEMP = COL.DET_EMPFAT AND ';
    Result := Result + '                                  DET.DET_CODCLI = COL.DET_CODCLI ';

    Result := Result + '  INNER JOIN CADITE ITE ON ITE.ITE_CODITE = COL.DET_CODITE ';

    Result := Result + 'WHERE   DET.DET_TIP_FC = "C"     ';
    Result := Result + '    AND DET.DET_ENTFUT = "S"     ';
    Result := Result + '    AND DET.DET_ESPDOC NOT IN ("ML", "PR", "TM") ';
    Result := Result + '    AND COL.DET_ESPDOC = "ML"    ';
    Result := Result + '    AND DET.DET_EFBAIX = "N"     ';

    If fCfgSis('EFTEST') = '2' Then
    Begin
      Result := Result + '   AND (DET.DET_PROEMB <> "S" OR T.DET_BXSBIT = "S") ';//Para exibir os sub-itens (proemb = 's' e bxsbit = 's')
      Result := Result + '   AND (DET.DET_FILKAR = 0) ';//Para nao exibir o item principal (que vai estar com filkar = 1)
    End
    Else
      Result := Result + '   AND DET.DET_PROEMB <> "S" ';

    Result := Result + '    AND DET.DET_IDEPRO <> "NOR"  ';
    Result := Result + '    AND COL.DET_CODITE = :CODITE ';

    If Not fEmptyStr(strCodEmp) Then
      Result := Result + '  AND COL.DET_CODEMP = :CODEMP ';

    If Not fEmptyStr(strNumLot) Then
      Result := Result + '  AND IFNULL(DET.DET_NUMLOT,"") = IFNULL(:NUMLOT,"") ';

    Result := 'SELECT SUM(QTDPEN) AS QTDPEN FROM (' + Result + ') T ';
  End;
End;

function fGetSQLQtdEntregaFutura(strCodEmp: String;
                                 strCodIte : String = '';
                                 strNumLot : String = '';
                                 strMotFut : String = '';
                                 blnPorLote: Boolean = False;
                                 blnCalcQtdPend : Boolean = true;
                                 strListaLote: string = ''): String;
  Var
    blnEfBaixExiste: Boolean;
    strQtdFutPed: String;
begin
  If AnsiMatchText(fCfgSis('PEDBEF', varString), ['S', 'P']) Then
  begin
    if (fCfgSis('CALSAL') = '2') then
      strQtdFutPed := ' 0 '
    else
      strQtdFutPed := ' IFNULL(QTDFUT,0) ';
  end
  Else
    strQtdFutPed := ' 0 ';

  blnEfBaixExiste := fCampoExiste('MOVDET', 'DET_EFBAIX');

  Result := '';
  Result := Result + ' SELECT DET_CODITE, ';

  If blnPorLote Then
    Result := Result + ' DET_NUMLOT, ';

  Result := Result + ' DET_CODEMP, ';
  Result := Result + ' IF( IFNULL(ITE_CNV_ML,0) <= 0, 1, ITE_CNV_ML ) AS CNV_ML, ';

  If blnCalcQtdPend Then
    Result := Result + ' SUM( IFNULL(QTDPEN, 0) * IF( IFNULL(ITE_CNV_ML,0) <= 0, 1, ITE_CNV_ML ) ) AS QTDPEN, '
  Else
    Result := Result + ' SUM( IFNULL(QTDPEN, 0))AS QTDPEN, ';

  If blnCalcQtdPend Then
    Result := Result + ' SUM( IFNULL(QTDPEA, 0) * IF( IFNULL(ITE_CNV_ML,0) <= 0, 1, ITE_CNV_ML ) ) AS QTDPEA, '
  Else
    Result := Result + ' SUM( IFNULL(QTDPEA, 0))AS QTDPEA, ';

  If blnCalcQtdPend Then
    Result := Result + ' SUM( IFNULL(QTDPEF, 0) * IF( IFNULL(ITE_CNV_ML,0) <= 0, 1, ITE_CNV_ML ) ) AS QTDPEF, '
  Else
    Result := Result + ' SUM( IFNULL(QTDPEF, 0))AS QTDPEF, ';

  If blnCalcQtdPend Then
    Result := Result + ' SUM( IFNULL(QTDPEP, 0) * IF( IFNULL(ITE_CNV_ML,0) <= 0, 1, ITE_CNV_ML ) ) AS QTDPEP '
  Else
    Result := Result + ' SUM( IFNULL(QTDPEP, 0))AS QTDPEP ';

  Result := Result + ' FROM ';

  Result := Result + '  (SELECT ';
  Result := Result + '    DET_CODITE, ';

  If blnPorLote Then
    Result := Result + ' DET_NUMLOT, ';

  Result := Result + '    DET_CODEMP, ';
  Result := Result + '    0 AS CNV_ML, ';

  Result := Result + '  SUM(IFNULL(ROUND(IFNULL(DET_QTDITE,0) - (IFNULL(DET_QTDENT,0) + ' + strQtdFutPed + ') ,4), 0)) AS QTDPEN,  ';

  Result := Result + '  SUM(IF(DET_MOTFUT = "A", IFNULL(ROUND(IFNULL(DET_QTDITE,0) - (IFNULL(DET_QTDENT,0) + ' + strQtdFutPed + ') ,4), 0), 0)) AS QTDPEA, ';
  Result := Result + '  SUM(IF(DET_MOTFUT = "F", IFNULL(ROUND(IFNULL(DET_QTDITE,0) - (IFNULL(DET_QTDENT,0) + ' + strQtdFutPed + ') ,4), 0), 0)) AS QTDPEF, ';
  Result := Result + '  SUM(IF(DET_MOTFUT = "P", IFNULL(ROUND(IFNULL(DET_QTDITE,0) - (IFNULL(DET_QTDENT,0) + ' + strQtdFutPed + ') ,4), 0), 0)) AS QTDPEP  ';

  Result := Result + '  FROM ';
  Result := Result + '    MOVDET D ';
  Result := Result + ' ' + fSQLLeftJoinENTFUTPedido('D') + ' ';
  Result := Result + '    INNER JOIN MOVTRI T ON D.AUTOINCREM = T.DET_SEQGER ';
  Result := Result + '  WHERE ';

  If blnEfBaixExiste Then
    Result := Result + ' DET_EFBAIX = "N" AND ';

  If Not fEmptyStr(strMotFut) Then
    Result := Result + ' DET_MOTFUT IN (' + strMotFut + ') AND ';

  Result := Result + '    DET_ENTFUT = "S" AND ';

  If fCfgSis('EFTEST') = '2' Then
  Begin
    Result := Result + '   (DET_PROEMB <> "S" OR DET_BXSBIT = "S") AND ';//Para exibir os sub-itens (proemb = 's' e bxsbit = 's')
    Result := Result + '   (DET_FILKAR = 0) ';//Para nao exibir o item principal (que vai estar com filkar = 1)
  End
  Else
    Result := Result + '   DET_PROEMB <> "S"  ';

  If Not fCfgSis('BEFTRG', VarBoolean) Then
    Result := Result + '    AND IFNULL(DET_FILKAR,0) = 0 ';

  Result := Result + '    AND (DET_ESPDOC NOT IN ("ML", "PR", "TM", "EP")) ';

  Result := Result + '  AND IFNULL(ROUND(IFNULL(DET_QTDITE,0) - (IFNULL(DET_QTDENT,0) + ' + strQtdFutPed +') ,4), 0) > 0 ';

  If Not fEmptyStr(strCodEmp) Then
    Result := Result + '  AND DET_CODEMP = ' + QuotedStr(strCodEmp) + ' ';

  If Not fEmptyStr(strCodIte) Then
    Result := Result + '  AND DET_CODITE = ' + QuotedStr(strCodIte) + ' ';

  If Not fEmptyStr(strNumLot) Then
    Result := Result + '  AND DET_NUMLOT = ' + QuotedStr(strNumLot) + ' ';
  If Not fEmptyStr(strListaLote) Then
    Result := Result + '     AND DET_NUMLOT IN (' + strListaLote + ') ';

  Result := Result + 'GROUP BY DET_CODITE ';

  If blnPorLote Then
    Result := Result + ', DET_NUMLOT ';

  If fEmptyStr(strCodEmp) Then
    Result := Result + ', DET_CODEMP ';



  {***********************************************************************************}
  {* CASO UTILIZE TINTA DE MAQUINA DEVE TAMBEM CONSIDERAR OS COLORANTES COMO ENTREGA *}
  {* FUTURA PARA CALCULO DE QUANTIDADE PENDENTE. SOLICITADO PELA "DARKA" 28/08/2013  *}
  {********************************************************************************JC*}
  If fCfgSis('USATMQ', varBoolean) Then
  Begin
    {********************************}
    {* SOMA OS COLORANTES DO MOVDET *}
    {*****************************JC*}
    Result := Result + '  UNION ALL ';
    Result := Result + 'SELECT ';
    Result := Result + '  COL.DET_CODITE, ';

    If blnPorLote Then
      Result := Result + ' DET.DET_NUMLOT, ';

    Result := Result + ' COL.DET_CODEMP, ';
    Result := Result + ' ITE.ITE_CNV_ML, ';

    Result := Result + '  SUM(COL.DET_QTDITE * ( 1 - IFNULL((DET.DET_QTDENT + ' + strQtdFutPed + ') / DET.DET_QTDITE, 0) ) / IF(IFNULL(ITE.ITE_CNV_ML, 0) > 0, ITE.ITE_CNV_ML, 1)) AS QTDPEN, ';

    Result := Result + '  SUM(IF(DET.DET_MOTFUT = "A", COL.DET_QTDITE * ( 1 - IFNULL((DET.DET_QTDENT + ' + strQtdFutPed + ') / DET.DET_QTDITE, 0) ) / IF(IFNULL(ITE.ITE_CNV_ML, 0) > 0, ITE.ITE_CNV_ML, 1), 0)) AS QTDPEA, ';
    Result := Result + '  SUM(IF(DET.DET_MOTFUT = "F", COL.DET_QTDITE * ( 1 - IFNULL((DET.DET_QTDENT + ' + strQtdFutPed + ') / DET.DET_QTDITE, 0) ) / IF(IFNULL(ITE.ITE_CNV_ML, 0) > 0, ITE.ITE_CNV_ML, 1), 0)) AS QTDPEF, ';
    Result := Result + '  SUM(IF(DET.DET_MOTFUT = "P", COL.DET_QTDITE * ( 1 - IFNULL((DET.DET_QTDENT + ' + strQtdFutPed + ') / DET.DET_QTDITE, 0) ) / IF(IFNULL(ITE.ITE_CNV_ML, 0) > 0, ITE.ITE_CNV_ML, 1), 0)) AS QTDPEP  ';

    Result := Result + 'FROM ';
    Result := Result + '  MOVDET DET ';
    Result := Result + ' ' + fSQLLeftJoinENTFUTPedido('DET') + ' ';
    Result := Result + '  INNER JOIN MOVTRI TRI ON DET.AUTOINCREM = TRI.DET_SEQGER ';
    Result := Result + '  INNER JOIN MOVDET COL ON DET.DET_CODACA = COL.DET_CODACA AND ';
    Result := Result + '                           DET.DET_EMPACA = COL.DET_EMPACA AND ';
    Result := Result + '                           DET.DET_NUMDOC = COL.DET_NUMFAT AND ';
    Result := Result + '                           DET.DET_ESPDOC = COL.DET_TIPFAT AND ';
    Result := Result + '                           DET.DET_CODEMP = COL.DET_EMPFAT AND ';
    Result := Result + '                           DET.DET_CODCLI = COL.DET_CODCLI ';

    Result := Result + '  INNER JOIN CADITE ITE ON ITE.ITE_CODITE = COL.DET_CODITE ';

    Result := Result + 'WHERE   DET.DET_TIP_FC = "C"     ';
    Result := Result + '    AND DET.DET_ENTFUT = "S"     ';
    Result := Result + '    AND DET.DET_ESPDOC NOT IN ("ML", "PR", "TM") ';
    Result := Result + '    AND COL.DET_ESPDOC = "ML"    ';

    If fCfgSis('EFTEST') = '2' Then
    Begin
      Result := Result + '   AND (DET.DET_PROEMB <> "S" OR TRI.DET_BXSBIT = "S") ';//Para exibir os sub-itens (proemb = 's' e bxsbit = 's')
      Result := Result + '   AND (DET.DET_FILKAR = 0) ';//Para nao exibir o item principal (que vai estar com filkar = 1)
    End
    Else
      Result := Result + '   AND DET.DET_PROEMB <> "S" ';

    Result := Result + '    AND DET.DET_IDEPRO <> "NOR"  ';

    If Not fCfgSis('BEFTRG', VarBoolean) Then
      Result := Result + '    AND IFNULL(COL.DET_FILKAR,0) = 0 ';

    Result := Result + '  AND IFNULL(COL.DET_QTDITE * ( 1 - IFNULL((DET.DET_QTDENT + ' + strQtdFutPed + ') / DET.DET_QTDITE, 0) ) / IF(IFNULL(ITE.ITE_CNV_ML, 0) > 0, ITE.ITE_CNV_ML, 1), 0) > 0 ';

    If blnEfBaixExiste Then
      Result := Result + ' AND DET.DET_EFBAIX = "N" ';

    If Not fEmptyStr(strCodIte) Then
      Result := Result + '  AND COL.DET_CODITE = ' + QuotedStr(strCodIte) + ' ';

    If Not fEmptyStr(strCodEmp) Then
      Result := Result + '  AND COL.DET_CODEMP = ' + QuotedStr(strCodEmp) + ' ';

    Result := Result + 'GROUP BY COL.DET_CODITE ';
    If fEmptyStr(strCodEmp) Then
      Result := Result + ', COL.DET_CODEMP ';
  End;

  Result := Result + '  ) AS TBL ';

  Result := Result + ' INNER JOIN CADITE ON ITE_CODITE = DET_CODITE ';

  Result := Result + 'GROUP BY DET_CODITE ';

  If blnPorLote Then
    Result := Result + ', DET_NUMLOT ';

  If fEmptyStr(strCodEmp) Then
    Result := Result + ', DET_CODEMP ';

end;

