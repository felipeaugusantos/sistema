{****************************************}
{* EXECUTA A SQL PASSADA POR PARAMETRO  *}
{*************************************AF*}
function fExecutaSQL(strSQL: String): Boolean;
  Var
    qryGen: TUniQuery;
Begin

	Try

    qryGen := fCriaQuery;
    Result := True;

		With qryGen do
		Begin
			Close;
			SQL.Clear;
			SQL.Add(strSQL);
      ExecSQL;
		End;

	Except
		On E: Exception do
		Begin
			Result := False;
			pMensagensErro(E.Message, '[fExecutaSQL]');
		End;
	End;

  FreeAndNil(qryGen);

End;

function fDropTable(strNomeTabela: String; Conexao: TUniConnection = Nil): Boolean;
  Var
    strSQL   : String;
    qryGenTmp: TUniQuery;
begin
  Try

    Result := True;

    If Assigned(Conexao) Then
      qryGenTmp := fCriaQuery(Nil, Conexao)
    Else
      qryGenTmp := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'DROP TABLE ' + strNomeTabela;

    Try

      If Not fTabelaExiste(strNomeTabela, False, Conexao) Then
        Exit;

      With qryGenTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ExecSQL;
        Close;
      End;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[fDropTable]');
        Result := False;
      End;

    End;

  Finally
    FreeAndNil(qryGenTmp);
  End;

end;

