                                   const arrIgnonarCtrl: array of TWinControl);
var
  intCont: Integer;

  function InClassesAfetadas(const controle: TWinControl): Boolean;
    Var
     intIdx: Integer;
  begin
    Result := Length(arrSomenteClas)=0; //TODAS

    If (Not Result) And (Length(arrSomenteClas) > 0) Then
    Begin
      For intIdx := 0 to Length(arrSomenteClas) - 1 Do
        If controle Is arrSomenteClas[intIdx] Then
        Begin
          Result := True;
          Break
        End;
    End;
  end;

  function InControlIgnorados(const controle: TWinControl): Boolean;
  var
    intIdx: Integer;
  begin
    Result := False;
    For intIdx := 0 to Length(arrIgnonarCtrl) - 1 Do
      If controle = arrIgnonarCtrl[intIdx] Then
      Begin
        Result := True;
        Break
      End;
  end;

begin
  for intCont := 0 to obj.ControlCount - 1 do
  begin
    If (obj.Controls[intCont].Visible) And
       (InClassesAfetadas(TWinControl(obj.Controls[intCont]))) And
       (Not InControlIgnorados(TWinControl(obj.Controls[intCont]))) Then
    Begin
      obj.Controls[intCont].Enabled := blnEnable;
    End;
  end;
end;

function fCSTJaCadastrada(cdsCST: TUniClientDataSet; strCodCST, strAutInc: String; dtaVigenc: TDateTime=0): Boolean;
  Var
    cdsAux: TUniClientDataSet;
    strVig,
    strTip: String;
begin
  cdsAux := TUniClientDataSet.Create(Nil);
  Try
    pCloneDataSet(cdsAux, cdsCST);

    If cdsAux.FindField('APC_CSTSAI') <> NIL Then
      strTip:='SAI'
    Else
      strTip:='ENT';

    strVig :='';
    If cdsAux.FindField('APC_VIGENC') <> NIL Then
    Begin
      If dtaVigenc = 0 Then
        strVig := ' - (Sem Vigência)'
      Else
        strVig := ' - Vigência: ' + FormatDateTime('dd/mm/yyyy', dtaVigenc);
    End;

    cdsAux.Filter := 'AUTOINCREM <> '+QuotedStr(strAutInc);
    cdsAux.Filtered := True;

    If cdsAux.FindField('APC_VIGENC') <> NIL Then
      Result := cdsAux.Locate('APC_CST'+strTip+';APC_VIGENC', VarArrayOf([strCodCST, dtaVigenc]), [])
    Else
      Result := cdsAux.Locate('APC_CST'+strTip, strCodCST, []);

    If Result Then
     fMensagem('Atenção', 'CST de'+IIF(strTip='SAI',' saída ',' entrada ') +strCodCST + strVig + ', já esta cadastrada!'+#10#13+
                          'Tecle "Enter" sobre a mesma, para editá-la.', ['&Ok']);

  Finally
    FreeAndNil(cdsAux);
  End;
End;

function fAbreviacaoPisCfopExiste(cdsGrid: TUniClientDataSet; strCfopAtual, strSufixo, strCst: string): boolean;
  var
    stlCfopsAdicionadas: TStringList;
    cdsAux: TUniClientDataSet;
    strCfopGravado: string;
    intContador: Integer;
begin
  Result := true;

  strCfopGravado := '';

  strCfopAtual := Trim(AnsiReplaceStr(AnsiReplaceStr(strCfopAtual, '-', ''), ' ', ''));

  stlCfopsAdicionadas := TStringList.Create;
  cdsAux := TUniClientDataSet.Create(nil);
  try
    while strCfopAtual <> '' do
    begin
      stlCfopsAdicionadas.Add(Copy(strCfopAtual, 1, 4));
      strCfopAtual := Copy(strCfopAtual, 5, length(strCfopAtual));
    end;

    pCloneDataSet(cdsAux, cdsGrid);

    cdsAux.Filter := 'APC_CST' + strSufixo + ' <> ' + QuotedStr(strCst);
    cdsAux.Filtered := True;

    cdsAux.First;
    while not cdsAux.Eof do
    begin
      strCfopGravado := strCfopGravado + Trim(cdsAux.FieldByName('APC_CFO' + strSufixo).AsString);
      cdsAux.Next;
    end;

    strCfopGravado := fTransform(Trim(AnsiReplaceStr(AnsiReplaceStr(strCfopGravado, '-', ''), ' ', '')), 4);

    for intContador := 0 to stlCfopsAdicionadas.Count - 1 do
    begin
      if Pos(stlCfopsAdicionadas[intContador], strCfopGravado) > 0 then
      begin
        fMensagem('Aviso', 'CFOP: ' + stlCfopsAdicionadas[intContador] + ' já cadastrada!', ['OK']);
        Result := false;
        break;
      end;
    end;
  finally
    stlCfopsAdicionadas.Free;
    cdsAux.Free;
  end;
end;

function fVerificarNovaFormulaMovimentada(const strSql: string; const arrParametros: array of Variant): Boolean;
const
  arrTabelas : array[0..4] of string = ('TINDET', 'TINDOR', 'MOVDET', 'FATDOR', 'NOTDET');
  arrPrefixos: array[0..4] of string = ('DET', 'FDO', 'DET', 'FDO', 'DET');
var
  intCont: Integer;
  intParametros: Integer;
  qryGen: TUniQuery;
begin
  qryGen := nil;
  Try
    Result := False;
    Try
      qryGen := fCriaQuery();
      for intCont := 0 to Length(arrTabelas) - 1 do
      begin
        qryGen.Close;
        qryGen.SQL.Text := Format(strSql, [arrTabelas[intCont], arrPrefixos[intCont]]);
        for intParametros := 0 to Length(arrParametros) - 1 do
        begin
          qryGen.Params[intParametros].Value := arrParametros[intParametros];
        end;
        qryGen.Open;

        Result := qryGen.FieldByName('QTD').AsInteger > 0;
        if Result then
          Exit;
      end;
    Except
      on E: Exception do
      begin
        raise;
      end;
    End;
  Finally
    if Assigned(qryGen) then FreeAndNil(qryGen);
  End;
end;

procedure pIncluiCfgSisTCOARR;
  Var
    qryAux: TUniQuery;
    qryIns: TUniQuery;
begin
  qryAux := fCriaQuery;
  qryAux.SQL.Add('SELECT ');
  qryAux.SQL.Add('  TCA_ARQUIV , SUM(IF(TCA_ARQREL="CFGSIS", 1, 0)) AS QTD ');
  qryAux.SQL.Add('FROM ');
  qryAux.SQL.Add('  TCOARR ');
  qryAux.SQL.Add('GROUP BY ');
  qryAux.SQL.Add('  TCA_ARQUIV ');
  qryAux.SQL.Add('HAVING ');
  qryAux.SQL.Add('  QTD = 0 ');
  qryAux.Open;

  qryIns := fCriaQuery;
  qryIns.SQL.Add('INSERT INTO TCOARR (TCA_ARQUIV, TCA_ARQREL, TCA_CAMREL, TCA_DESCRI) VALUES ');
  qryIns.SQL.Add('  (:ARQUIV, "CFGSIS", "SIS_VALCFG", "CONFIGURAÇÕES DO SISTEMA") ');

  While Not qryAux.Eof Do
  Begin
    qryIns.Close;
    qryIns.ParamByName('ARQUIV').AsString := qryAux.FieldByName('TCA_ARQUIV').AsString;
    qryIns.ExecSQL;

    qryAux.Next;
  End;

  FreeAndNil(qryIns);
  FreeAndNil(qryAux);
end;

function fCamelCase(const s: string): string;
var t1: integer;
   first: boolean;
begin
   result := LowerCase(s);
   first := true;
   for t1 := 1 to length(result) do
     if result[t1] = ' ' then begin
       first := true;
     end else
       if first then begin
         result[t1] := UpCase(result[t1]);
         first := false;
       end;
end;



function fCommaText(stlListSelecao: TStringList; blnQuoted: Boolean = False; strSeparator : String = ', '): String;
  Var
    intContador: Integer;
    strDado: String;
Begin
  Result := '';

  For intContador := 0 To stlListSelecao.Count - 1 Do
  Begin
    If blnQuoted Then
      strDado := QuotedStr(stlListSelecao[intContador])
    Else
      strDado := stlListSelecao[intContador];

    If intContador = 0 Then
      Result := strDado
    Else
      Result := Result + strSeparator +  strDado;
  End;
end;

function fValidaUFsPercurso(strPercurso: String): Boolean;
  Var
    stlUFs: TStringList;
    strUF: String;
    strMsg: String;
    intContador: Integer;
begin
  Result := True;
  strMsg := '';
  stlUFs := TStringList.Create;
  ExtractStrings([','], [], PChar(strPercurso), stlUFs);

  For intContador := 0 To stlUFs.Count-1 Do
  Begin
    strUF := Trim(stlUFs[intContador]);
    If Not fValidaEstado(strUF) Then
    Begin
      strMsg := strMsg + strUf + ',';
    End;
  End;

  If Not fEmptyStr(strMsg) Then
  Begin
    strMsg := LeftStr(strMsg, Length(strMsg)-1);
    Result := False;

    pMensagemOk('Há UFs inválidas no percurso: ' + strMsg);
  End;

  FreeAndNil(stlUFs);
end;

