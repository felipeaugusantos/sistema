function fDataUltimaVendaProduto(strCodIte: String; strCodCli: String = ''): TDateTime;
  var
    strSQL: string;
    qryGen: TUniQuery;
begin

  strSQL :=  '';
  strSQL := strSQL + ' SELECT SQL_NO_CACHE ';
  strSQL := strSQL + '   DET_DTAENT ';
  strSQL := strSQL + ' FROM ';
  strSQL := strSQL + '   MOVDET ';
  strSQL := strSQL + ' WHERE ';
  strSQL := strSQL + '   DET_CODCLI NOT IN (' + VS_strCliFil + ') AND ';
  strSQL := strSQL + '   DET_TIP_FC = "C"          AND ';
  strSQL := strSQL + '   IFNULL(DET_PROEMB, "N") <> "S" AND ';
  strSQL := strSQL + '   DET_CODITE =         ' + QuotedStr(strCodIte) + ' AND ';
  strSQL := strSQL + '   ((LOCATE(DET_CLAFIS, ' + QuotedStr(VS_strClaVen) + ') > 0) OR ';
  strSQL := strSQL + '    (LOCATE(DET_CLAFIS, ' + QuotedStr(VS_strClaDev) + ') > 0) ';

  If (fCfgSis('ENTBRF', varBoolean)) Then
    strSQL := strSQL + ' OR (DET_ESPDOC = "BR") OR LOCATE(DET_CLAFIS,' + CLAFIS_BR + ')) '
  Else
    strSQL := strSQL + ') ';

  If Not fEmptyStr(strCodCli) Then
    strSQL := strSQL + ' AND DET_CODCLI = ' + QuotedStr(strCodCli);

  strSQL := strSQL + ' ORDER BY ';
  strSQL := strSQL + '   DET_DTAENT DESC ';
  strSQL := strSQL + ' LIMIT 1 ';

  qryGen := fCriaQuery(Nil);

  With qryGen, SQL Do
  Begin
    Clear;
    Add(strSQL);
    Open;

    If Not IsEmpty Then
      Result := FieldByName('DET_DTAENT').AsDateTime
    Else
      Result := 0;
  End;

  FreeAndNil(qryGen);
end;

Procedure pSomaFormasPagamento(strNumDoc, strEspDoc, strCodEmp, strCodCli: String;
                               qryResult: TUniQuery);
Begin
  With qryResult, SQL Do
  Begin
    Clear;
    Close;

    Add('SELECT FPG_DESCRI AS DESCRI, SUM(MOD_VALMOD) AS VALMOD FROM MOVMOD ');
    Add('INNER JOIN CADFPG ON FPG_CODIGO = MOD_CODMOD ');
    Add('WHERE ');
    Add('  MOD_NUMDOC = :NUMDOC AND ');
    Add('  MOD_ESPDOC = :ESPDOC AND ');
    Add('  MOD_CODEMP = :CODEMP AND ');
    Add('  MOD_CODCLI = :CODCLI     ');
    Add('GROUP BY ');
    Add('  FPG_DESCRI ');
    Add('ORDER BY ');
    Add('  FPG_DESCRI ');

    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := strCodEmp;
    ParamByName('CODCLI').AsString := strCodCli;
    Open;
  End;
End;

Function fSomaFormasPagamento(strNumDoc, strEspDoc, strCodEmp, strCodCli: String; intQtdCol: Integer = 0): String;
  Var
    qryResult: TUniQuery;
    intContador: Integer;
Begin
  Result := '';
  intContador := 0;
  qryResult := fCriaQuery(Nil);

  pSomaFormasPagamento(strNumDoc, strEspDoc, strCodEmp, strCodCli, qryResult);
  With qryResult Do
  Begin
    While Not Eof Do
    Begin
      inc(intContador);

      If intQtdCol = 0 Then
      Begin
        Result := Result + FieldByName('DESCRI').AsString + ': ' +
                           FormatFloat('#0.00', FieldByName('VALMOD').AsFloat);

        If intContador <> RecordCount Then
          Result := Result + ' - ';

      End
      Else
        Result := Result +  #13#10 + fPadR(FieldByName('DESCRI').AsString, intQtdCol - 14) + ':' +
                                     fPadL(FormatFloat('#0.00', FieldByName('VALMOD').AsFloat), 13);

      Next;
    End;
  End;
  FreeAndNil(qryResult);
End;

