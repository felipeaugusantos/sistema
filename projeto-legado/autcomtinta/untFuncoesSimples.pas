{-----------------------------------------------------------------------------
 Faz o mesmo que "SimpleRoundTo", porém divide pelo Fator, ao invés de Multiplicar.
 Isso evita Erro A.V. de estouro de Inteiro.
 Nota: Funcao copiada de SimpleRoundTo do Delphi Seatle
 -----------------------------------------------------------------------------}
function fSimpleRoundToEX(const AValue: Extended; const ADigit: TRoundToRange = -2): Extended;
var
  LFactor: Extended;
begin
  LFactor := IntPower(10.0, ADigit);
  if AValue < 0 then
    Result := Int((AValue / LFactor) - 0.5) * LFactor
  else
    Result := Int((AValue / LFactor) + 0.5) * LFactor;
end;

procedure pRedimensionarTelaSeguindoMenuIniciar(frmForm: TForm);
var
  Tasklist : HWnd;
  Bordered : TRect;
begin
  Tasklist := FindWindow('Shell_TrayWnd', nil);
  GetWindowRect(Tasklist, Bordered);

  If (Bordered.Height <= 0) Or (Bordered.Width <= 0) Then
  begin
    frmForm.Height := Screen.Height;
    frmForm.Width  := Screen.Width;
    Exit;
  end;

  if Bordered.Height < Bordered.Width then
  Begin
    frmForm.Height := Screen.Height-Bordered.Height;
    frmForm.Width  := Screen.Width;
  End
  Else
  Begin
    frmForm.Height := Screen.Height;
    frmForm.Width  := Screen.Width-Bordered.Width;
  End;
End;

function fGetCertificado: String;
var
  Store: IStore3;
  CertsLista, CertsSelecionado: ICertificates2;
  CertDados: ICertificate;
  lSigner: TSigner;
  lSignedData: TSignedData;

begin
  Store := CoStore.Create;
  Store.Open(CAPICOM_CURRENT_USER_STORE, 'My',CAPICOM_STORE_OPEN_MAXIMUM_ALLOWED);

  CertsLista := Store.Certificates as ICertificates2;
  CertsSelecionado := CertsLista.Select('Certificado(s) Digital(is) disponível(is)',
                                        'Selecione o Certificado Digital para uso no aplicativo', False);

  if not(CertsSelecionado.Count = 0) then
    begin
      CertDados := IInterface(CertsSelecionado.Item[1]) as ICertificate2;
      lSigner := TSigner.Create(Nil);
      lSigner.Certificate := CertDados;
      lSignedData := TSignedData.Create(Nil);
      lSignedData.Content := ' ';

      if CertDados.ValidFromDate > fNow() then
        begin
          showmessage('Certificado não liberado. aguardar ' + datetostr(CertDados.ValidFromDate));
          exit;
        end;

      if CertDados.ValidToDate < fNow() then
        begin
          showmessage('Certificado expirado');
          exit;
        end;

      lSignedData.Sign(lSigner.DefaultInterface, False, CAPICOM_ENCODE_BASE64);

      Result := UTF8ToString(UTF8Encode(CertDados.SerialNumber));

      lSignedData.Free;
      lSigner.Free;
    end;
end;



