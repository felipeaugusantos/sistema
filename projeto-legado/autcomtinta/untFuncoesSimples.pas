Procedure pIncluiIteger(cdsIteger: TUniClientDataSet; qryIteger: TUniQuery);
  Var
    intIndice: Integer;
Begin
  With cdsIteger Do
  Begin
    Insert;

    For intIndice := 0 To Fields.Count - 1 Do
      Fields[intIndice].Value := qryIteger.FieldbyName(Fields[intIndice].FieldName).Value;

    Post;
  End;
End;

function fSqlCdsIteger: String;
  Var
    strSQL: String;
Begin
  strSQL := '';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   ITE_CODITE, ';
  strSQL := strSQL + '   ITE_CODEMP, ';
  strSQL := strSQL + '   ITE_PREULT, ';
  strSQL := strSQL + '   ITE_PRECOM, ';
  strSQL := strSQL + '   ITE_DESF01, ';
  strSQL := strSQL + '   ITE_DESF02, ';
  strSQL := strSQL + '   ITE_DESF03, ';
  strSQL := strSQL + '   ITE_DESF04, ';
  strSQL := strSQL + '   ITE_DESF05, ';
  strSQL := strSQL + '   ITE_DESF06, ';
  strSQL := strSQL + '   ITE_ICMSAI, ';
  strSQL := strSQL + '   ITE_OUTVAL, ';
  strSQL := strSQL + '   ITE_DESOPE, ';
  strSQL := strSQL + '   ITE_ACRFIN, ';
  strSQL := strSQL + '   ITE_IMPFED  ';
  strSQL := strSQL + ' FROM ';
  strSQL := strSQL + '   ITEGER ';
  strSQL := strSQL + ' WHERE ';
  strSQL := strSQL + '   ITE_CODITE = :CODITE AND ';
  strSQL := strSQL + '   ITE_CODEMP = :CODEMP ';

  Result := strSQL;
End;

function fRetPreComMenosDescForn(strCodIte, strCodEmp: String; cdsIteGer: TUniClientDataSet = Nil;
                                 strCALSOP: String = ''): Double;
Var
  strSQL   : String;
  qryGen   : TUniQuery;
  fltValor : Double;
  dtsIteger: TDataSet;
Begin
  Try
    qryGen := Nil;

    If fEmptyStr(strCALSOP) Then
      strCALSOP := fCfgSis('CALSOP');

    If (Not Assigned(cdsIteGer)) Or
       (Not cdsIteGer.Locate('ITE_CODITE;ITE_CODEMP', VarArrayOf([strCodIte, strCodEmp]), [])) Then
    Begin

      strSQL := fSqlCdsIteger;

      qryGen := fCriaQuery;

      With qryGen Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('CODITE').AsString := strCodIte;
        ParamByName('CODEMP').AsString := strCodEmp;
        Open;

        If Assigned(cdsIteger) Then
          pIncluiIteger(cdsIteger, qryGen);

      End;
    End;

    If Assigned(cdsIteger) Then
      dtsIteger := cdsIteger
    Else
      dtsIteger := qryGen;

    With dtsIteGer Do
    Begin
      If strCALSOP = '2' Then
      Begin

        If FieldByName('ITE_PREULT').AsFloat = 0 Then
        Begin
          fltValor := fieldbyname('ITE_PRECOM').AsFloat;

          fltValor := fltValor - ((fltValor / 100) * fieldbyname('ITE_DESF01').AsFloat);
          fltValor := fltValor - ((fltValor / 100) * fieldbyname('ITE_DESF02').AsFloat);
          fltValor := fltValor - ((fltValor / 100) * fieldbyname('ITE_DESF03').AsFloat);
          fltValor := fltValor - ((fltValor / 100) * fieldbyname('ITE_DESF04').AsFloat);
          fltValor := fltValor - ((fltValor / 100) * fieldbyname('ITE_DESF05').AsFloat);
          fltValor := fltValor - ((fltValor / 100) * fieldbyname('ITE_DESF06').AsFloat);
        End
        Else
          fltValor := fieldbyname('ITE_PREULT').AsFloat;

      End
      Else
      Begin
        fltValor := fieldbyname('ITE_PRECOM').AsFloat;

        fltValor := fltValor - ((fltValor / 100) * fieldbyname('ITE_DESF01').AsFloat);
        fltValor := fltValor - ((fltValor / 100) * fieldbyname('ITE_DESF02').AsFloat);
        fltValor := fltValor - ((fltValor / 100) * fieldbyname('ITE_DESF03').AsFloat);
        fltValor := fltValor - ((fltValor / 100) * fieldbyname('ITE_DESF04').AsFloat);
        fltValor := fltValor - ((fltValor / 100) * fieldbyname('ITE_DESF05').AsFloat);
        fltValor := fltValor - ((fltValor / 100) * fieldbyname('ITE_DESF06').AsFloat);
      End;

      Result := fltValor;
    End;

  Finally
    If Assigned(qryGen) Then
      FreeAndNil(qryGen);
  End;

End;

function fEhEmbalagemFechadaItem(strCodIte, strTabPreco: String; fltQtdIte: Double): Boolean;
  var
    fltQtdEmbFec: Double;
    blnUnidadeEFracionada: Boolean;
begin
  blnUnidadeEFracionada := fUnidadeDoProdutoEhFracionaria(strCodIte);
  fltQtdEmbFec := fQuantEmbalagemFechadaItem(strCodIte, strTabPreco, fltQtdIte);

  If (fltQtdEmbFec > 0) And (fltQtdIte > 0) And (((Frac(fltQtdIte) = 0) And
    (Not blnUnidadeEFracionada)) Or blnUnidadeEFracionada) Then
    Result := IIF(blnUnidadeEFracionada,
                  (fModDouble(fltQtdIte, fltQtdEmbFec) = 0),
                  ((Floor(fltQtdIte) Mod Floor(fltQtdEmbFec)) = 0))
  Else
    Result := False;
end;

function fTemQuantEmbalagemFechada(strCodIte: String): Boolean;
begin
  Result := fCampoTabela('COUNT(ITB_QTDEMB)', 'ITEEMB',
                        ['ITB_CODITE', 'ITB_CODEMP'],
                        [strCodIte, VS_strCodEmp], False) > 0;
end;

function fQuantEmbalagemFechadaItem(strCodIte, strTabPreco: String; fltQtdIte : Double): Double;
  Var
    qryConsulta : TUniQuery;
    fltQtdEmbFec: Double;
    blnUnidadeEFracionada: Boolean;
begin
  Result := 0;
  blnUnidadeEFracionada := fUnidadeDoProdutoEhFracionaria(strCodIte);

  If (Not ((fltQtdIte > 0) And
          (((Frac(fltQtdIte) = 0) And (Not blnUnidadeEFracionada)) Or blnUnidadeEFracionada))) Then
    Exit;

  Try
    qryConsulta := fCriaQuery(Nil);
    With qryConsulta, SQL Do
    Begin
      Close;
      Clear;
      Add(' SELECT ITB_QTDEMB          ');
      Add(' FROM ITEEMB                ');
      Add(' WHERE ITB_CODITE = :CODITE ');
      Add('   AND ITB_CODEMP = :CODEMP ');
      Add('   AND IF( IFNULL(ITB_TABPRE, "") = "", ' + IfThen(fEmptyStr(strTabPreco), '""', strTabPreco) + ', ITB_TABPRE) = :TABPRE ');
      Add(' ORDER BY ITB_QTDEMB DESC   ');

      ParamByName('CODITE').AsString := strCodIte;
      ParamByName('TABPRE').AsString := strTabPreco;
      ParamByName('CODEMP').AsString := VS_strCodEmp;

      Open;

      While Not Eof Do
      Begin

        fltQtdEmbFec := FieldByName('ITB_QTDEMB').AsFloat;

        If Not blnUnidadeEFracionada Then
        Begin
          If (fltQtdEmbFec > 0) And (fltQtdIte > 0) And (Frac(fltQtdIte) = 0) Then
          Begin
            If ((Floor(fltQtdIte) Mod Floor(fltQtdEmbFec)) = 0) Then
            Begin
              Result := Floor(fltQtdEmbFec);
              Break;
            End;
          End;
        End
        Else
        Begin
          If (fltQtdEmbFec > 0) And (fltQtdIte > 0) Then
          Begin
            If (fModDouble(fltQtdIte, fltQtdEmbFec) = 0) Then
            Begin
              Result := fltQtdEmbFec;
              Break;
            End;
          End;
        End;

        Next;
      End;

      Close;
    End;

  Finally
    FreeAndNil(qryConsulta);
  End;

end;

function fPercDescEmbalagemFechadaItem(strCodIte, strTabPreco: String; fltQtdIte : Double; strCodBarEmb: string ): Double;
  Var
    fltQtdEmb : Double;
    strQtdEmb : String;
begin
  Result := 0.00;
  fltQtdEmb := fQuantEmbalagemFechadaItem(strCodIte, strTabPreco, fltQtdIte);
  If fltQtdEmb > 0 Then
  Begin
    strQtdEmb := FormatFloat(fMskDigitos(2), fltQtdEmb);
    strQtdEmb := StringReplace(strQtdEmb,'.','',[rfReplaceAll]);
    strQtdEmb := StringReplace(strQtdEmb,',','.',[rfReplaceAll]);
    Result := fCampoTabela('ITB_DESCON', 'ITEEMB',
                          ['ITB_CODITE', 'ITB_CODEMP', 'IF(IFNULL(ITB_TABPRE,"") = "", "' + strTabPreco + '", ITB_TABPRE)', 'ITB_QTDEMB'],
                          [strCodIte, VS_strCodEmp, strTabPreco, strQtdEmb], False);
  End;

  If (Result > 0) And (Not fEmptyStr(strCodBarEmb)) Then
  Begin
    If fRetornaPrecoCodBarraEmb( strCodIte,
                                 strCodBarEmb,
                                 VS_strCodEmp,
                                 strTabPreco, False ) > 0 Then
    Begin
      Result := 0.00;
    End;
  End;

end;

function fRetornaPrecoCodBarraEmb(strCodIte, strCodBar, strCodEmp, strTabPre: String;
  blnPegaPrecoEmb: Boolean): Double;
  Var
    intPreEmb: Integer;
    strTabEmb: String;
begin
  If blnPegaPrecoEmb Then
    Result := fCampoTabela('BAR_PREVEN', 'ITEBAR', ['BAR_CODITE', 'BAR_CODBAR'], [strCodIte, strCodBar])
  Else
  Begin
    If fEmptyStr(strTabPre) Then
      strTabPre := '1';

    intPreEmb := fCfgSis('PREEMB', VarInteger);

    If intPreEmb = 1 Then
      Result := fCampoTabela('BAR_PREVEN', 'ITEBAR', ['BAR_CODITE', 'BAR_CODBAR'], [strCodIte, strCodBar])
    Else
    Begin
      strTabEmb := fRetornaTabPreCodBarraEmb(strCodIte, strCodBar);

      If SameText(strTabEmb, 'F') Or fEmptyStr(strTabEmb) Then
        Result := fCampoTabela('ITE_PREVE' + strTabPre, 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [strCodIte, strCodEmp])
      Else
        Result := fCampoTabela('ITE_PREVE' + strTabEmb, 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [strCodIte, strCodEmp]);
    End;
  End;
end;

function fRetornaTabPreCodBarraEmb(strCodIte, strCodBar: String): String;
begin

  Result := '';

  If fEmptyStr(strCodIte) Then
    Exit;

  Result := fCampoTabela('BAR_TABPRE', 'ITEBAR', ['BAR_CODITE', 'BAR_CODBAR'], [strCodIte, strCodBar], False);

end;

function fCriaDiretorio(strPath: String): Boolean;
Var
  strDirAtu: String;
  strDirTmp: String;
  strDirRes: String;
  intPosIni: Integer;
  intPosFin: Integer;
  blnContinua: Boolean;
Begin

  Result      := False;
  blnContinua := (Not fEmptyStr(strPath));

  intPosIni := 1;
  strDirRes := strPath;
  strDirAtu := '';

  If (strDirRes[Length(strDirRes)] <> '\') Then
    strDirRes := strDirRes + '\';

  While blnContinua Do
  Begin
    intPosFin := Pos('\', strDirRes);

    strDirTmp := Copy(strDirRes,intPosIni,intPosFin);
    strDirRes := Copy(strDirRes,intPosFin + 1, Length(strDirRes));

    strDirAtu := strDirAtu + strDirTmp;

    If Not (fEmptyStr(strDirAtu)) Then
    Begin
      If Not DirectoryExists(strDirAtu) Then
        CreateDir(strDirAtu);
    End;

    If (fEmptyStr(strDirRes)) Then
    Begin
      blnContinua := False;
      Result := True;
    End;

  End;

End;

function fDiretorioVazio(strPath: string): Boolean;
var
  search_rec: TSearchRec;
begin
  {$WARN SYMBOL_PLATFORM OFF}
  FindFirst(strPath + '\*.xml', faArchive, search_rec);
  {$WARN SYMBOL_PLATFORM ON}

  Result := (search_rec.Name = '')
end;

procedure ApagaArquivosDiretorio(strPath: String);
Var
  S : TSearchRec;
begin
  try
    FindFirst(strPath +'\*.*', faAnyFile, S);
  repeat
    DeleteFile(Pchar(strPath +'\' + S.name));
  until FindNext(S) <> 0;
  finally
    //FindClose(S);
  end;
end;

function fFormataFoneSQL(strCampo: String; strApelido: String = ''; blnAddApelido: Boolean = True): String;
begin
  Result := '';
  Result := Result + ' IF(' + strCampo + '='''', '''', CONCAT("(",';
  Result := Result + ' SUBSTRING(' + strCampo + ', 1, 2), ") ",';
  Result := Result + ' SUBSTRING(' + strCampo + ', 3, 4), "-",';
  Result := Result + ' SUBSTRING(' + strCampo + ', 7, 4)))';
  If blnAddApelido Then
    Result := Result + ' AS ' + IIF(fEmptyStr(strApelido), strCampo, strApelido);
end;

