{* RETORNA O VALOR DE UM DETERMINADO CAMPO     *}
{* DE UMA TABELA PASSANDO COMO PARAMETROS      *}
{* OS CAMPOS CHAVES E SEUS VALORES (WHERE)     *}
{* PODE SER UTIL PARA RETORNAR DESDE DESCRICAO *}
{* ATE VALORES, DATAS ENTRE OUTROS             *}
{********************************************JC*}
function fCampoTabela(strCampo : String;
                      strNomTab: String;
                      arrCampoChave: Array Of String;
                      arrValorChave: Array Of Variant;
                      blnSempreLerBanco: Boolean = True;
                      strOrderBy: String = '';
                      Conexao: TUniConnection = Nil;
                      blnUsarMax: Boolean = False): Variant;
  Const
    arrParms : Array [0..11] Of String[1] = ('A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K', 'L');

  Var
    intCont  : Integer;
    strSQL   : String;
    qryGenGer: TUniQuery;
Begin
  Try

    qryGenGer := fCriaQuery(nil, Conexao);

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';

    if blnUsarMax then
    begin
      strSQL := strSQL + '  MAX(' + strCampo + ') ';
    end
    else
    begin
      strSQL := strSQL + '  ' + strCampo + ' ';
    end;

    If Not fEmptyStr(strNomTab) Then
    Begin
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  ' + strNomTab + ' ';
      strSQL := strSQL + 'WHERE ';

      For intCont := 0 To Length(arrCampoChave) -1 Do
      Begin
        If Pos('<>', arrCampoChave[intCont]) > 0 Then
          strSQL := strSQL + '  ' + arrCampoChave[intCont] + ' :' + String(arrParms[intCont]) + ' AND '
        Else
          strSQL := strSQL + '  ' + arrCampoChave[intCont] + ' = :' + String(arrParms[intCont]) + ' AND ';
      End;

      strSQL := strSQL + '  TRUE  ';

      If Not fEmptyStr(strOrderBy) Then
        strSQL := strSQL + ' ORDER BY ' + strOrderBy;

      strSQL := strSQL + ' LIMIT 1 ';
    End;

    With qryGenGer Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      For intCont := 0 To Length(arrCampoChave) -1 Do
        ParamByName(String(arrParms[intCont])).Value := arrValorChave[intCont];


      If (Not blnSempreLerBanco) Then
      Begin
        Result := TDicResultadoQuerySimples.fExecQuery(qryGenGer);
      End
      Else
      Begin
        Open;

        Result := Fields[0].Value;

        {*******************************************}
        {* EXECUTA UM CAST PARA NAO RETORNAR NULL  *}
        {****************************************JC*}
        Case Fields[0].DataType Of
          ftString : Result := Fields[0].AsString;
          ftMemo   : Result := Fields[0].AsString;
          ftFloat  : Result := Fields[0].AsFloat;
          ftInteger: Result := Fields[0].AsInteger;
          ftBoolean: Result := Fields[0].AsBoolean;
          ftDate   : Result := Fields[0].AsDateTime;
          ftTime   : Result := Fields[0].AsDateTime;
        End;
      End;

    End;

  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message, 'fCampoTabela');
    End;
  End;

  FreeAndNil(qryGenGer);

End;

function fRetFaixasPorValor(strTab:String;
                            varValor:Variant;
                            strCampoIni,
                            strCampoFin,
                            strCampoDes:String;
                            strCampoChave:String;
                            varChave:Variant):String;
  Var
    strSQL : String;
    qryGen : TUniQuery;
Begin
  Try

    qryGen := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + strCampoDes;
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + strTab;
    strSQL := strSQL + ' WHERE ';
    strSQL := strSQL + ' :VALOR BETWEEN '+strCampoIni+ ' AND '+strCampoFin;
    strSQL := strSQL + ' AND '+ strCampoChave + ' <> :CHAVE ';

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('VALOR').Value := varValor;
      ParamByName('CHAVE').Value := varChave;
      Open;

      If Not IsEmpty Then
      Begin
        While Not Eof Do
        Begin
          Result:=Result+Fields[0].AsString+', ';

          Next;
        End;

        Result:=Copy(Result, 1, Length(Result)-2);

      End;

      Close;
    End;

  Finally
    FreeAndNil(qryGen);
  End;
end;

function fRetMltVenItem(Const strCodIte: String): Double;
  Var
    strSQL   : String;
    qryGenIte: TUniQuery;
Begin
  Try

    qryGenIte := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '  ITE_MLTVEN ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADITE ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  ITE_CODITE = :CODITE ';

    With qryGenIte Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODITE').AsString := strCodIte;
      Open;

      If Not IsEmpty Then
        Result := FieldByName('ITE_MLTVEN').AsFloat
      Else
        Result := 0;

      Close;
    End;

  Finally
    FreeAndNil(qryGenIte);
  End;

End;

function fModDouble(fltDividendo, fltDivisor: Double): Double;
begin
  Result := Frac(fltDividendo/fltDivisor)*fltDivisor;
end;

function fMenorMultiploValido(fltQtd, fltMlt: Double;  blnOlhaCFG: Boolean; Out blnCorteMulti: Boolean): Double;
 Var
   fltPassoSubtr: Double;
   strCfgMltVen: String;
begin
  Result := fltQtd;
  blnCorteMulti := False;
  strCfgMltVen := fCfgSis('MLTVEN', varString);

  If (((fltMlt = 1) Or (fltMlt = 0)) And (Frac(fFormataFloat(fltQtd, 6)) = 0)) Or
     (blnOlhaCFG And (strCfgMltVen = '2')) Then
  Begin
    Exit;
  End;

  If (blnOlhaCFG And (strCfgMltVen = '3')) Then
  Begin
    blnCorteMulti := (fModDouble(fFormataFloat(fltQtd, 6), fltMlt) <> 0);
  End
  Else
  Begin
    If (Not blnOlhaCFG) Or
       (blnOlhaCFG And (Pos(strCfgMltVen, '1_4_') > 0)) Then
    Begin
      Result := fFormataFloat(fltQtd, 6);

      If (Frac(fltMlt) = 0) And (Frac(Result) = 0) Then
        fltPassoSubtr := 1
      Else
        fltPassoSubtr := 0.00001;

      While (Result > 0) And (fModDouble(Result, fltMlt) <> 0) Do
      Begin
        blnCorteMulti := True;
        Result := fFormataFloat(Result - fltPassoSubtr, 6);
      End;

      If Result < 0 Then
        Result := 0;
    End;
  End
end;

Procedure pUltimaCompra(strCodIte, strCodEmp, strAnoMes: String;
   chrOpcInv: Char; Var dtaUltComp: TDate; Var strNumDoc: String);
  Var
    qryUltComp: TUniQuery;
    strSQL     : String;
Begin
  qryUltComp := fCriaQuery;

  With qryUltComp Do
  Begin
    strSQL := '';
    strSQL := strSQL + 'SELECT  ';
    strSQL := strSQL + '  D.DET_DTAENT AS "DTA_MOV",  ';
    strSQL := strSQL + '  D.DET_HORENT AS "HOR_MOV",  ';
    strSQL := strSQL + '  CONCAT(D.DET_NUMDOC, "-", D.DET_ESPDOC, "-", D.DET_CODEMP) AS NUMDOC ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  MOVDET D  ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  D.DET_TIP_FC = "F"           AND ';
    strSQL := strSQL + '  D.DET_ESPDOC IN ("NF", "EL", "IF", "IV", "D1") AND ';

    If Not fEmptyStr(strCodEmp) Then
    Begin
      If Length(strCodEmp) > 3 Then
        strSQL := strSQL + '  D.DET_CODEMP IN (' + strCodEmp + ') AND '
      Else
        strSQL := strSQL + '  D.DET_CODEMP = :CODEMP      AND ';
    End;

    strSQL := strSQL + '  D.DET_CODITE = :CODITE      AND ';
    strSQL := strSQL + '  LOCATE(DET_CLAFIS, :CLACOM) > 0 ';

    Case chrOpcInv Of
      'F',
      'I': strSQL := strSQL + '  AND D.DET_DTAENT <= :DTAENT ';
    End;

    strSQL := strSQL + ' LIMIT 1 ';

    strSQL := 'SELECT * FROM ( SELECT * FROM ( ' + strSQL;
    strSQL := strSQL + ' ) AS TMP ';

    strSQL := strSQL + 'ORDER BY  ';

    strSQL := strSQL + '  DTA_MOV DESC, HOR_MOV DESC';

    strSQL := strSQL + ' ) AS TMP2 LIMIT 1 ';

    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('CODITE').Value    := strCodIte;
    ParamByName('CLACOM').AsString := VS_strClaCom;

    If (Not fEmptyStr(strCodEmp)) And (Params.FindParam('CODEMP') <> Nil) Then
      ParamByName('CODEMP').AsString    := strCodEmp;

    Case chrOpcInv Of
      'F',
      'I': ParamByName('DTAENT').AsDate := EndOfAMonth(StrToIntDef(copy(strAnoMes,1,4), 0), StrToIntDef(copy(strAnoMes,5,2), 0));
    End;

    Open;

    If IsEmpty Then
    Begin
      dtaUltComp := 0;
      strNumDoc  := '';
    End
    Else Begin
      dtaUltComp := FieldByName('DTA_MOV').AsDateTime;
      strNumDoc  := FieldByName('NUMDOC').AsString;
    End;

    Close;
  End;

  FreeAndNil(qryUltComp);

End;


function fUsaImpostoFonteIBPT: Boolean;
Begin
  Result := fCfgSis('IMPPAG', VarInteger) = 2;
End;

Procedure pRetDadosTransportadora(strCodTra: String;
   var strNomTra, strEndTra, strEndTr2: String);
  Var
    qryTra: TUniQuery;
Begin
  qryTra := fCriaQuery;
  With qryTra, SQL Do
  Begin
    Clear;
    Add('SELECT');
    Add('  TRA_NOMTRA,');
    Add('  TRA_ENDERE,');
    Add('  TRA_BAIRRO,');
    Add('  TRA_C_E_P_,');
    Add('  TRA_FONE01,');
    Add('  CID_NOMCID,');
    Add('  CID_ESTADO ');
    Add('FROM');
    Add('  CADTRA ');
    Add('INNER JOIN CADCID ON CID_CODCID = TRA_CODCID');
    Add('WHERE');
    Add('  TRA_CODTRA = :CODTRA');

    ParamByName('CODTRA').AsString := strCodTra;

    Open;

    If IsEmpty Then
    Begin
      strNomTra := '';
      strEndTra := '';
      strEndTr2 := '';
    End Else
    Begin
      strNomTra := FieldByName('TRA_NOMTRA').AsString + ' FONE: ' + fFormataFone(FieldByName('TRA_FONE01').AsString);
      strEndTra := FieldByName('TRA_ENDERE').AsString;
      strEndTr2 := FieldByName('TRA_BAIRRO').AsString + ' CEP.: ' + FormatMaskText('99999-999;0;_', FieldByName('TRA_C_E_P_').AsString) + ' ' +
                   FieldByName('CID_NOMCID').AsString + ' - ' + FieldByName('CID_ESTADO').AsString;
    End;

    Close;

  End;

  FreeAndNil(qryTra);
End;


Function fTemEntregaFutura(strCodCli: String): Boolean;

  function fGetSqlTab: String;
  Var
    strSQL,
    strMovDet,
    strMovGer: String;
    blnEfBaixExiste : Boolean;
  Begin

    blnEfBaixExiste := fCampoExiste('MOVDET', 'DET_EFBAIX');

    strMovGer := 'MOVGER';
    strMovDet := 'MOVDET';

    strSQL := '';
    strSQL := strSQL + ' SELECT                    ';
    strSQL := strSQL + '   COUNT(*) AS QTDITE      ';
    strSQL := strSQL + ' FROM                      ';
    strSQL := strSQL + strMovDet + ' D ';
    strSQL := strSQL + '  INNER JOIN MOVTRI T ON D.AUTOINCREM = T.DET_SEQGER ';

    strSQL := strSQL + ' INNER JOIN ' + strMovGer + ' G ON        ';
    strSQL := strSQL + '   G.AUTOINCREM = D.DET_SEQGER              ';

    If (fCfgSis('CONENT', varBoolean)) and (fCfgSis('COENFI', varBoolean)) Then
    Begin

      If ((fCfgSis('EMPGER', varBoolean))) Then
      Begin
        strSQL := strSQL + ' AND (GER_CODEMP = ' + QuotedStr(fCfgSis('EMPMAT')) + ' OR ';
        strSQL := strSQL + '      GER_CONENT = "S") ';
      End
      Else
      Begin
        strSQL := strSQL + ' AND GER_CONENT = "N" ';
        strSQL := strSQL + ' AND GER_CODEMP = ' + QuotedStr(VS_strCodEmp);
      End;

    End

    Else strSQL := strSQL + ' AND GER_CODEMP = ' + QuotedStr(VS_strCodEmp);

    strSQL := strSQL + ' WHERE                                            ';
    strSQL := strSQL + '   DET_ENTFUT = "S" AND                           ';
    strSQL := strSQL + '   DET_CODCLI = :CODCLI AND                       ';

    If blnEfBaixExiste Then
      strSQL := strSQL + ' DET_EFBAIX = "N" AND ';

    strSQL := strSQL + '   (DET_ESPDOC NOT IN ("ML", "PR", "TM", "TR", "BR", "PI", "EP")) AND  ';

    If fCfgSis('EFTEST') = '2' Then
    Begin
      strSQL := strSQL + '   (DET_PROEMB <> "S" OR DET_BXSBIT = "S") AND ';//Para exibir os sub-itens (proemb = 's' e bxsbit = 's')
      strSQL := strSQL + '   (DET_FILKAR = 0) AND ';//Para nao exibir o item principal (que vai estar com filkar = 1)
    End
    Else
      strSQL := strSQL + '   DET_PROEMB <> "S" AND ';

    strSQL := strSQL + '   ROUND(DET_QTDITE - IFNULL(DET_QTDENT,0),4) > 0 ';

    Result := strSQL;
  End;

  Var
    qryGen: TUniQuery;
Begin

  qryGen := fCriaQuery;

  With qryGen, SQL Do
  Begin
    Clear;
    Add(fGetSqlTab);

    ParamByName('CODCLI').AsString := strCodCli;

    Open;

    Result := FieldByName('QTDITE').AsInteger > 0;

    Close;
  End;

  FreeAndNil(qryGen);
End;

function fPreMat: Boolean;
  Var
    qryGen: TUniQuery;
Begin
  Result := False;
  Try
    qryGen := fCriaQuery;

    qryGen.Close;
    qryGen.SQL.Add('SELECT EMP_PREMAT FROM CADEMP WHERE EMP_CODEMP = :CODEMP');
    qryGen.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryGen.Open;

    Result := (qryGen.FieldByName('EMP_PREMAT').AsString = 'S');

    If (VS_strCodEmp = fCfgSis('EMPMAT')) Then
      Result := False;

    qryGen.Close;
  Except
    On E: Exception Do
      pMensagensErro(E.Message,'');
  End;
  FreeAndNil(qryGen);

End;


