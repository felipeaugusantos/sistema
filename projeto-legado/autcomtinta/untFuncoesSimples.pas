function fConvertePrecos(fltPreAtu: Double; moeTipMoe: TTipoMoeda): Double;
Var
  qryGen   : TUniQuery;
Begin
  Result := 0;
  Try
    qryGen := fCriaQuery;

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT * FROM CADMOE ORDER BY MOE_DTAMOE DESC LIMIT 1');
      Open;

      Case moeTipMoe Of
        moeDolar : Result := fFormataFloat(fltPreAtu * fieldbyname('MOE_DOLVEN').AsFloat, 2);
        moeReal  : Result := fFormataFloat(fltPreAtu * fieldbyname('MOE_REAVEN').AsFloat, 2);
        moePeso  : Result := fFormataFloat(fltPreAtu * fieldbyname('MOE_PARVEN').AsFloat, 2);
        moeEuro  : Result := fFormataFloat(fltPreAtu * fieldbyname('MOE_EURVEN').AsFloat, 2);
      End;

    End;

  Finally
    FreeAndNil(qryGen);
  End;

End;

function fCalculaPrecoCompraLiquido(strCodIte, strCodEmp: String; cdsIteGer: TUniClientDataSet): Double;
  Var
    strSQL   : String;
    qryGen   : TUniQuery;
    dtsIteger: TDataSet;
Begin
  Try
    qryGen := Nil;

    If (Not Assigned(cdsIteGer)) Or
       (Not cdsIteGer.Locate('ITE_CODITE;ITE_CODEMP', VarArrayOf([strCodIte, strCodEmp]), [])) Then
    Begin

      strSQL := fSqlCdsIteger;

      qryGen := fCriaQuery;

      With qryGen Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('CODITE').AsString := strCodIte;
        ParamByName('CODEMP').AsString := strCodEmp;
        Open;

        If Assigned(cdsIteger) Then
          pIncluiIteger(cdsIteger, qryGen);

      End;
    End;

    If Assigned(cdsIteger) Then
      dtsIteger := cdsIteger
    Else
      dtsIteger := qryGen;

    With dtsIteGer Do
    Begin
      Result := fCalculaPrecoCompraLiquido(Fieldbyname('ITE_PRECOM').AsFloat,
                                           Fieldbyname('ITE_DESF01').AsFloat,
                                           Fieldbyname('ITE_DESF02').AsFloat,
                                           Fieldbyname('ITE_DESF03').AsFloat,
                                           Fieldbyname('ITE_DESF04').AsFloat,
                                           Fieldbyname('ITE_DESF05').AsFloat,
                                           Fieldbyname('ITE_DESF06').AsFloat);

      Result := fFormataFloat(Result, fCfgSis('DECUNI', VarInteger));
    End;

  Finally
    If Assigned(qryGen) Then
      FreeAndNil(qryGen);
  End;
end;

function fCalculaPrecoCompraLiquido(fltPreCom, fltDesf01, fltDesf02, fltDesf03,
  fltDesf04, fltDesf05, fltDesf06: Double; blnPreDol: Boolean = False;
  fltDesf07: Double = 0): Double;
Begin
  Result := fltPreCom;

  {***********************************}
  {* VERIFICA SE CONVERTE PARA DÓLAR *}
  {********************************PZ*}
  If (blnPreDol) Then
    Result := fConvertePrecos(Result, moeDolar);

  Result := Result - ( Result * ( fltDesf01 / 100 ) );
  Result := Result - ( Result * ( fltDesf02 / 100 ) );
  Result := Result - ( Result * ( fltDesf03 / 100 ) );
  Result := Result - ( Result * ( fltDesf04 / 100 ) );
  Result := Result - ( Result * ( fltDesf05 / 100 ) );
  Result := Result - ( Result * ( fltDesf06 / 100 ) );
  Result := Result - ( Result * ( fltDesf07 / 100 ) );

End;

