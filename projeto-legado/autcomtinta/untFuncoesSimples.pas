function fPedidoTemRequisicaoDeCompras(strNumDoc, strEspDoc, strCodEmp: String; var strSeqRcp, strEmpRcp: String): Boolean;
  Var
    qryReqCmp : TUniQuery;
begin
  qryReqCmp := fCriaQuery(Nil);
  Try
    qryReqCmp.Close;
    qryReqCmp.SQL.Clear;
    qryReqCmp.SQL.Add(' SELECT RCG_CODIGO, RCG_CODEMP ');
    qryReqCmp.SQL.Add('   FROM FATGOR ');
    qryReqCmp.SQL.Add('   JOIN EXTGOR ON EXTGOR.FGO_SEQFGO = FATGOR.AUTOINCREM ');
    qryReqCmp.SQL.Add('   JOIN MOVRCG ON MOVRCG.AUTOINCREM = EXTGOR.FGO_INRQCP ');
    qryReqCmp.SQL.Add('  WHERE FGO_NUMDOC = :NUMDOC ');
    qryReqCmp.SQL.Add('    AND FGO_ESPDOC = :ESPDOC ');
    qryReqCmp.SQL.Add('    AND FGO_CODEMP = :CODEMP ');
    qryReqCmp.ParamByName('NUMDOC').AsString := strNumDoc;
    qryReqCmp.ParamByName('ESPDOC').AsString := strEspDoc;
    qryReqCmp.ParamByName('CODEMP').AsString := strCodEmp;
    qryReqCmp.Open;
    Result := (Not qryReqCmp.IsEmpty);

    strSeqRcp := '';
    strEmpRcp := '';

    If (Result) Then
    Begin
      strSeqRcp := qryReqCmp.FieldByName('RCG_CODIGO').AsString;
      strEmpRcp := qryReqCmp.FieldByName('RCG_CODEMP').AsString;
    End;

    qryReqCmp.Close;
  Finally
    FreeAndNil(qryReqCmp);
  End;
end;

function fReqTemCotacaoOuPcmDet(strCodigo, strCodEmp: String): Boolean;
  Var
    qryReqCmp : TUniQuery;
begin
  qryReqCmp := fCriaQuery(Nil);
  Try
    qryReqCmp.Close;
    qryReqCmp.SQL.Clear;
    qryReqCmp.SQL.Add(' SELECT COUNT(*) AS CNT ');
    qryReqCmp.SQL.Add('   FROM MOVRCD ');
    qryReqCmp.SQL.Add('  WHERE RCD_CODIGO = :CODIGO ');
    qryReqCmp.SQL.Add('    AND RCD_CODEMP = :CODEMP ');
    qryReqCmp.SQL.Add('    AND (RCD_SEQCOT IS NOT NULL ');
    qryReqCmp.SQL.Add('         OR RCD_SEQPCD IS NOT NULL) ');
    qryReqCmp.ParamByName('CODIGO').AsString := strCodigo;
    qryReqCmp.ParamByName('CODEMP').AsString := strCodEmp;
    qryReqCmp.Open;
    Result := (qryReqCmp.FieldByName('CNT').AsInteger > 0);
    qryReqCmp.Close;
  Finally
    FreeAndNil(qryReqCmp);
  End;
end;

