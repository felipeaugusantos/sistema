function fMensagemTratada(E: Exception): String;
begin
  If (E.ClassType = EConvertError) Then
  Begin
    If (Pos('is not a valid date and time', E.Message) > 0) Then
      fMensagem('', 'Data/Hora Inválida', ['&OK'])
    Else If (Pos('is not a valid date', E.Message) > 0) Then
      fMensagem('', 'Data Inválida', ['&OK'])
    Else If (Pos('is not a valid time', E.Message) > 0) Then
      fMensagem('', 'Hora Inválida', ['&OK'])
    Else
      fMensagem('', E.Message, ['&OK']);
  End
  Else
    fMensagem('', E.Message, ['&OK']);
end;

