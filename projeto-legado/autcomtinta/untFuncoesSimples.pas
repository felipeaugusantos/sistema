  Try
    reg := TRegistry.Create;
    reg.RootKey := HKEY_CURRENT_USER;
    reg.OpenKey('Control Panel\International', True);

    reg.WriteString('sMonThousandSep', '.');
    reg.WriteString('sMonDecimalSep' , ',');
    reg.WriteString('sThousand'      , '.');
    reg.WriteString('sDecimal'       , ',');
    reg.WriteString('sGrouping'      , '3;0');
    reg.WriteString('sMonGrouping'   , '3;0');
    reg.WriteString('iDigits'        , '2');
    reg.WriteString('iCurrDigits'    , '2');
    reg.WriteString('sDate'          , '/');
    reg.WriteString('sShortDate'     , 'dd/MM/yyyy');
    reg.WriteString('sLongDate'      , 'dddd, d'' de ''MMMM'' de ''yyyy');
    reg.WriteString('sTime'          , ':');
    reg.WriteString('sTimeFormat'    , 'HH:mm:ss');

    FormatSettings.ThousandSeparator := '.';
    FormatSettings.DecimalSeparator  := ',';
    FormatSettings.CurrencyDecimals  := 2;
    FormatSettings.ShortDateFormat   := 'dd/MM/yyyy';
    FormatSettings.LongDateFormat    := 'dddd, d'' de ''MMMM'' de ''yyyy';
    FormatSettings.ShortTimeFormat   := 'hh:mm';
    FormatSettings.LongDateFormat    := 'hh:mm:ss';

  Finally
    FreeAndNil(reg);
  End;

End;

function fGetQuantidadeFatorAxalta(const fltQuantidade: Double; const strCodIte: string): Double;
var
  qryGen: TUniQuery;
begin
  qryGen := nil;
  Try
    Result := 0;
    Try
      qryGen := fCriaQuery();
      qryGen.SQL.Text :=
        ' SELECT                               ' +
        '   ITE_CODITE                         ' +
        '   , ITE_CNV_ML                       ' +
        '   , (:QTD / ITE_CNV_ML) AS RESULT    ' +
        ' FROM                                 ' +
        '   CADITE I                           ' +
        '   INNER JOIN DUP_CADBAS B            ' +
        '     ON I.ITE_CODITE = B.BAS_CODITE   ' +
        ' WHERE B.BAS_CODITE = :CODITE         ' +
        ' LIMIT 1                              ';
      qryGen.ParamByName('QTD').AsFloat := fltQuantidade;
      qryGen.ParamByName('CODITE').AsString := strCodIte;
      qryGen.Open;

      if qryGen.IsEmpty then
        Result := fltQuantidade
      else
        Result := qryGen.FieldByName('RESULT').AsFloat;

    Except
      on E: Exception do
      begin
        raise;
      end;
    End;
  Finally
    if Assigned(qryGen) then FreeAndNil(qryGen);
  End;
end;

function fValidaEan13(strCodBar : String) : Boolean;
  Var
    intCorre,
    intPares,
    intImpar,
    intSoma,
    intDigito  : Integer;
Begin
  Result   := False;
  intPares := 0;
  intImpar := 0;

  if Length(strCodBar) <> 13 Then
    Exit;

  For intCorre := 1 to 12 Do
  Begin
    if Odd(intCorre) Then
      intImpar := intImpar + StrToIntDef(strCodBar[intCorre],0)
    else
      intPares := intPares + StrToIntDef(strCodBar[intCorre],0);
  End;

  intPares := intPares * 3;

  intSoma := intPares + intImpar;

  intDigito:= (Trunc(IIF( (intSoma mod 10) = 0, intSoma / 10, (intSoma / 10) + 1 )) * 10) - intSoma;

  Result := (strCodBar[13] = IntToStr(intDigito));

End;

Function fRetChaveAcesso(strNumDoc, strEspDoc, strCodCli, strCodEmp, strSerie: String; strTipFC : String = 'C'): String;overload;
  Var
    qryCadFis: TUniQuery;
Begin

  qryCadFis := fCriaQuery;
  With qryCadFis, SQL Do
  Begin
    Clear;
    Add('SELECT');
    Add('  IFNULL(FIS_ACESSO, "") AS FIS_ACESSO ');
    Add('FROM');
    Add('  CADFIS');
    Add('WHERE');
    Add('  FIS_NUMDOC = :NUMDOC AND ');
    Add('  FIS_CODEMP = :CODEMP AND ');
    Add('  FIS_FORCLI = :CODCLI AND ');
    Add('  FIS_ESPDOC = :ESPDOC AND ');
    Add('  FIS_TIP_FC = :TIP_FC     ');

    If not fEmptyStr(strSerie) Then
      Add('  AND IFNULL(FIS_SERIE_,"") = :SERIE_');

    ParamByName('CODEMP').AsString := strCodEmp;
    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODCLI').AsString := strCodCli;
    ParamByName('TIP_FC').AsString := strTipFC;
    If not fEmptyStr(strSerie) Then
      ParamByName('SERIE_').AsString := strSerie;

    Open;

    If IsEmpty Then
      Result := ''
    Else
      Result := FieldByName('FIS_ACESSO').AsString;

    Close;

  End;
  FreeAndNil(qryCadFis);
End;

