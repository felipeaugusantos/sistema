function fRetPathSeImagemValida(strPathImg: String): String;
  Var
   Img: TImage;
begin
  Result := strPathImg;

  If (Not fEmptyStr(Result)) And (FileExists(Result)) Then
  Begin
    Try
      Img := TImage.Create(Nil);
      Try
        Img.Picture.LoadFromFile(strPathImg);
