<?xml version="1.0" encoding="utf-8" standalone="no"?>
<TfrxReport Tag="1" Version="5.6.11" DotMatrixReport="False" EngineOptions.DoublePass="True" IniFile="\Software\Fast Reports" PreviewOptions.AllowEdit="False" PreviewOptions.Buttons="3583" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40401,475989294" ReportOptions.Description.Text="" ReportOptions.LastChange="45393,7484401968" ScriptLanguage="PascalScript" ScriptText.Text="procedure edtCabecTipoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  strTipo : String;&#13;&#10;begin&#13;&#10;  strTipo := 'Saída';&#13;&#10;&#13;&#10;  if (&#60;Identificacao.&#34;TpImp&#34;&#62; = 2) then&#13;&#10;  begin&#13;&#10;    strTipo := 'Entrada';&#13;&#10;  end;&#13;&#10;&#13;&#10;  edtCabecTipo.Text := &#60;Identificacao.&#34;TpImp&#34;&#62; + ' - ' + strTipo + #13#10 +&#13;&#10;                       'Numero ' + &#60;Identificacao.&#34;NNF&#34;&#62; + '/Serie ' + &#60;Identificacao.&#34;Serie&#34;&#62; + #13#10 +&#13;&#10;                       'Emissao ' + &#60;Identificacao.&#34;DEmi&#34;&#62; + ' ' + &#60;Identificacao.&#34;HEmi&#34;&#62; + #13#10 +&#13;&#10;                       'Folha ' + VarToStr(&#60;Page#&#62;) + ' de ' + VarToStr(&#60;TotalPages#&#62;);&#13;&#10;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure memObsOnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  strObs, strPed, strFis : String;&#13;&#10;  intPos, intFim : Integer;&#13;&#10;begin&#13;&#10;  // So o pedido do e-commerce e as mensagens fiscais: vendedor, digitador e&#13;&#10;  // cond.pag. ocupavam um terco da etiqueta. Sem o rotulo do pedido (nota fora&#13;&#10;  // de marketplace) imprime o OBS inteiro - mostrar a mais, nunca sumir com ele.&#13;&#10;  strObs := &#60;InformacoesAdicionais.&#34;OBS&#34;&#62;;&#13;&#10;  intPos := Pos('PEDIDO E-COMMERCE:', UpperCase(strObs));&#13;&#10;  if intPos = 0 then&#13;&#10;  begin&#13;&#10;    memObs.Text := Trim(strObs);&#13;&#10;    Exit;&#13;&#10;  end;&#13;&#10;  strPed := Trim(Copy(strObs, intPos + 18, Length(strObs)));&#13;&#10;  intFim := 1;&#13;&#10;  while (intFim &#60;= Length(strPed)) and (strPed[intFim] &#60;&#62; #13) and (strPed[intFim] &#60;&#62; #10)&#13;&#10;        and (strPed[intFim] &#60;&#62; ';') and (strPed[intFim] &#60;&#62; '|') and (strPed[intFim] &#60;&#62; ' ') do&#13;&#10;    intFim := intFim + 1;&#13;&#10;  strPed := 'PEDIDO E-COMMERCE: ' + Copy(strPed, 1, intFim - 1);&#13;&#10;&#13;&#10;  // Mensagens fiscais: a linha CBS/IBS, ultima do infCpl, e o infAdFisco inteiro&#13;&#10;  // (IBPT, DIFAL), que o OBS traz logo depois dela.&#13;&#10;  strFis := '';&#13;&#10;  intPos := Pos('VLR.CBS', UpperCase(strObs));&#13;&#10;  if intPos = 0 then&#13;&#10;    intPos := Pos('VLR APROX', UpperCase(strObs));&#13;&#10;  if intPos = 0 then&#13;&#10;    intPos := Pos('VALOR DO ICMS DIFAL', UpperCase(strObs));&#13;&#10;  if intPos &#62; 0 then&#13;&#10;  begin&#13;&#10;    strFis := Trim(Copy(strObs, intPos, Length(strObs)));&#13;&#10;    intPos := Pos('VLR APROX', UpperCase(strFis));&#13;&#10;    if (intPos &#62; 1) and (strFis[intPos - 1] &#60;&#62; #10) then&#13;&#10;      Insert(#13#10, strFis, intPos);&#13;&#10;  end;&#13;&#10;  memObs.Text := strPed + #13#10 + strFis;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." ShowProgress="False" StoreInDFM="False" OnReportPrint="frxReportOnReportPrint">
